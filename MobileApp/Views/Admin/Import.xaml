<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Admin.Import"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Admin"
             xmlns:converters="clr-namespace:MobileApp.Converters"
             x:DataType="viewmodels:ImportViewModel"
             Title="Importar Datos">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">

            <Label Text="Importar Datos" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />

            <Label Text="{Binding ErrorMessage}" 
                   TextColor="Red" 
                   IsVisible="{Binding HasError}"
                   HorizontalOptions="Center"
                   FontAttributes="Bold" />

            <Border BackgroundColor="LightBlue" Padding="15" Stroke="Blue"  StrokeThickness="1" StrokeShape="RoundRectangle 10">
                <StackLayout>
                    <Label Text="Tipo de Importación" 
                           FontSize="16" 
                           FontAttributes="Bold" />

                    <Picker ItemsSource="{Binding ImportTypes}" 
                            SelectedItem="{Binding SelectedImportType}"
                            ItemDisplayBinding="{Binding DisplayName}"
                            Title="Seleccionar Tipo de Importación" />
                </StackLayout>
            </Border>

            <Border BackgroundColor="LightGreen" Padding="15" Stroke="Green" StrokeThickness="1" StrokeShape="RoundRectangle 10" IsVisible="{Binding ShowYearSelection}">
                <StackLayout>
                    <Label Text="Año" 
                           FontSize="16" 
                           FontAttributes="Bold" />
                    <Label Text="Elija un año (de los últimos 3) sobre los que importar datos" 
                           FontSize="12" 
                           TextColor="Gray" />

                    <Picker ItemsSource="{Binding AvailableYears}" 
                            SelectedItem="{Binding SelectedYear}"
                            Title="Select year" />
                </StackLayout>
            </Border>

            <Border BackgroundColor="LightYellow" Padding="15" Stroke="Yellow" StrokeThickness="1" StrokeShape="RoundRectangle 10" IsVisible="{Binding ShowStatsTypeSelection}">
                <StackLayout>
                    <Label Text="Tipo de Estadísticas" 
                           FontSize="16" 
                           FontAttributes="Bold" />
                    <Label Text="Selecciona que tipo de Estadísticas a importar" 
                           FontSize="12" 
                           TextColor="Gray" />

                    <Picker ItemsSource="{Binding StatsTypes}" 
                            SelectedItem="{Binding SelectedStatsType}"
                            ItemDisplayBinding="{Binding DisplayName}"
                            Title="Select stats type" />
                </StackLayout>
            </Border>

            <Border BackgroundColor="LightCoral" Padding="15" Stroke="Coral" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                <StackLayout>
                    <Label Text="Selección del archivo" 
                           FontSize="16" 
                           FontAttributes="Bold" />

                    <Button Text="Seleccione archivo CSV" 
                            Command="{Binding SelectFileCommand}"
                            BackgroundColor="Blue"
                            TextColor="White"
                            CornerRadius="5" />

                    <Label Text="{Binding SelectedFileName}" 
                           FontSize="14" 
                           TextColor="Gray"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Border>

            <Button Text="Cargar CSV" 
                    Command="{Binding ImportDataCommand}"
                    BackgroundColor="Green"
                    TextColor="White"
                    FontSize="18"
                    HeightRequest="60"
                    CornerRadius="10"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />

            <StackLayout IsVisible="{Binding IsLoading}" 
                         HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsLoading}" 
                                 Color="Blue" />
                <Label Text="Importando datos..." 
                       HorizontalOptions="Center" />
            </StackLayout>

            <Border BackgroundColor="LightGreen" Padding="15" Stroke="Green" StrokeThickness="1" StrokeShape="RoundRectangle 10" IsVisible="{Binding HasImportResult}">
                <StackLayout>
                    <Label Text="{Binding ImportResult}" 
                           FontSize="14"
                           FontAttributes="Bold" />

                    <Button Text="Descargar Archivo de Errores" 
                            Command="{Binding DownloadErrorFileCommand}"
                            IsVisible="{Binding HasErrorFile}"
                            BackgroundColor="Orange"
                            TextColor="White"
                            CornerRadius="5"
                            Margin="0,10,0,0" />
                </StackLayout>
            </Border>

            <Button Text="Volver" 
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Gray"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50" />

        </StackLayout>
    </ScrollView>

</ContentPage>