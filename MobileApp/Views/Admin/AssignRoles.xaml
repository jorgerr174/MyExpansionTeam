<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Admin.AssignRoles"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Admin"
             x:DataType="viewmodels:AssignRolesViewModel"
             Title="Asignar Roles">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <Label Text="Asignar Roles" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />

            <Border BackgroundColor="LightGray" Padding="15" Stroke="Gray"  StrokeThickness="1" StrokeShape="RoundRectangle 10">
                <StackLayout Spacing="10">
                    <Label Text="Buscar Usuarios" FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry Grid.Column="0" 
                               Placeholder="Search by username, name, email, or phone..."
                               Text="{Binding SearchFilter}" 
                               ReturnCommand="{Binding SearchCommand}" />

                        <Button Grid.Column="1" 
                                Text="Buscar" 
                                Command="{Binding SearchCommand}"
                                BackgroundColor="Blue"
                                TextColor="White"
                                WidthRequest="80" />
                    </Grid>
                </StackLayout>
            </Border>

            <Border BackgroundColor="LightBlue" Padding="15" Stroke="Blue"  StrokeThickness="1" StrokeShape="RoundRectangle 10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Grid.Column="0" 
                           Text="Mostrar:" 
                           VerticalOptions="Center" 
                           FontAttributes="Bold" />

                    <Picker Grid.Column="1" 
                            ItemsSource="{Binding PageSizeOptions}"
                            ItemDisplayBinding="{Binding Display}"
                            SelectedItem="{Binding SelectedPageSize}"
                            SelectedIndexChanged="OnPageSizeChanged"
                            HorizontalOptions="Start"
                            WidthRequest="80" />
                </Grid>
            </Border>

            <Label Text="{Binding ResultsInfo}" 
                   FontSize="12" 
                   TextColor="Gray" 
                   HorizontalOptions="Center" />

            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                             IsVisible="{Binding IsLoading}" />

            <Label Text="{Binding ErrorMessage}" 
                   TextColor="Red" 
                   IsVisible="{Binding HasError}"
                   FontSize="14"
                   HorizontalOptions="Center" />

            <CollectionView ItemsSource="{Binding Users}" 
                           IsVisible="{Binding HasUsers}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:UserItem">
                        <Border BackgroundColor="White" Padding="15" Margin="0,5" Shadow="10" Stroke="LightGrey" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                            <StackLayout Spacing="8">

                                <Label FontAttributes="Bold" FontSize="16">
                                    <Label.Text>
                                        <Binding Path="Username" />
                                    </Label.Text>
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="False">
                                            <Setter Property="TextColor" Value="Red" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Text="{Binding FullName}" FontSize="14" />
                                <Label Text="{Binding Email}" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding Phone}" 
                                       FontSize="12" 
                                       TextColor="Gray" />

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" 
                                           Text="Rol:" 
                                           FontAttributes="Bold" 
                                           VerticalOptions="Center" />

                                    <Picker Grid.Column="1" 
                                           SelectedIndex="{Binding SelectedRoleIndex}"
                                           IsEnabled="{Binding CanChangeRole}"
                                           SelectedIndexChanged="OnRoleChanged"
                                           VerticalOptions="Center">
                                        <Picker.Items>
                                            <x:String>Usuario</x:String>
                                            <x:String>Admin</x:String>
                                        </Picker.Items>
                                    </Picker>

                                    <Button Grid.Column="2"
                                           Text="Guardar Nuevo Rol" 
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AssignRolesViewModel}}, Path=SaveRoleCommand}"
                                           CommandParameter="{Binding .}"
                                           IsVisible="{Binding HasChanges}"
                                           BackgroundColor="Green"
                                           TextColor="White"
                                           FontSize="12"
                                           WidthRequest="100"
                                           HeightRequest="35" />
                                </Grid>
                            </StackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border BackgroundColor="LightGray" Padding="20" Stroke="Gray"  StrokeThickness="1" StrokeShape="RoundRectangle 10"
                   IsVisible="{Binding HasUsers, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="Ningún usuario encontrado." 
                       HorizontalOptions="Center"
                       TextColor="Gray"
                       FontSize="16" />
            </Border>

            <StackLayout IsVisible="{Binding ShowPagination}" 
                        Orientation="Horizontal" 
                        HorizontalOptions="Center" 
                        Spacing="15">

                <Button Text="Previa" 
                       Command="{Binding GoToPageCommand}"
                       CommandParameter="{Binding PreviousPage}"
                       IsEnabled="{Binding CanGoPrevious}"
                       BackgroundColor="Gray"
                       TextColor="White"
                       WidthRequest="100" />

                <Label Text="{Binding PageInfo}" 
                       VerticalOptions="Center"
                       FontAttributes="Bold"
                       FontSize="16" />

                <Button Text="Siguiente" 
                       Command="{Binding GoToPageCommand}"
                       CommandParameter="{Binding NextPage}"
                       IsEnabled="{Binding CanGoNext}"
                       BackgroundColor="Gray"
                       TextColor="White"
                       WidthRequest="100" />
            </StackLayout>

            <Button Text="Volver" 
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Gray"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,20,0,0" />

        </StackLayout>
    </ScrollView>
</ContentPage>