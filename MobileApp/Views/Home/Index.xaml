<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Home.Index"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Home"
             xmlns:shared="clr-namespace:MobileApp.Views.Shared"
             x:DataType="viewmodels:IndexViewModel"
             Title="Home">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <Label Text="Bienvenid@s" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />

            <!-- Show when NOT logged in -->
            <StackLayout IsVisible="{Binding IsNotAuthenticated}">
                <Label Text="Please log in to continue" 
                    HorizontalOptions="Center" />
                <Button Text="Go to Login" 
                    Command="{Binding GoToLoginCommand}" />
            </StackLayout>


            <StackLayout IsVisible="{Binding IsAuthenticated}">

                <!-- Username display -->
                <Label Text="{Binding Username}" 
                   FontSize="18" 
                   FontAttributes="Bold" />

                <!-- Admin button (only if admin) -->
                <Button Text="Admin actions" 
                    Command="{Binding GoToAdminCommand}"
                    IsVisible="{Binding IsAdmin}"
                    BackgroundColor="Red"
                    TextColor="White" />

                <!-- Teams section -->
                <Label Text="Your Teams:" 
                   FontSize="16" 
                   FontAttributes="Bold" />

                <!-- Teams list -->
                <shared:_TeamList BindingContext="{Binding}" />

                <!-- Action buttons -->
                <Button Text="Mis equipos" 
                    Command="{Binding MyTeamsCommand}"
                    BackgroundColor="Blue"
                    TextColor="White" />

                <Button Text="Nuevo equipo" 
                    Command="{Binding CreateTeamCommand}"
                    BackgroundColor="Green"
                    TextColor="White" />

            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>