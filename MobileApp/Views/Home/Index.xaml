<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Home.Index"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Home"
             xmlns:metcore="clr-namespace:METCore.DTOs.Team;assembly=METCore"
             x:DataType="viewmodels:IndexViewModel"
             Title="Pantalla inicial">

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">

            <Border BackgroundColor="#1b6ec2" 
                    Padding="20"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 10">
                <StackLayout Spacing="10">
                    <Label Text="Bienvenid@" 
                           FontSize="28" 
                           FontAttributes="Bold" 
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Text="Sistema de Gestión de Equipos de Expansión Fantasy"
                           FontSize="16" 
                           TextColor="White"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Border>

            <StackLayout IsVisible="{Binding IsAuthenticated}" Spacing="15">
                <Border BackgroundColor="#28a745" 
                        Padding="15"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0"
                               Text="{Binding Username, StringFormat='Bienvenid@ de nuevo, {0}'}" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Mis equipos" 
                            Command="{Binding GoToMyTeamsCommand}"
                            BackgroundColor="#007bff"
                            TextColor="White"
                            FontSize="16"
                            Padding="15" />

                    <Button Grid.Column="1"
                            Text="Crear Equipo" 
                            Command="{Binding GoToCreateTeamCommand}"
                            BackgroundColor="#28a745"
                            TextColor="White"
                            FontSize="16"
                            Padding="15" />
                </Grid>
            </StackLayout>

            <StackLayout IsVisible="{Binding IsNotAuthenticated}" Spacing="15">
                <Label Text="Por favor, inicie sesión para tener acceso a más funcionalidades" 
                       FontSize="16" 
                       HorizontalOptions="Center"
                       TextColor="#6c757d" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Inicio de Sesión" 
                            Command="{Binding GoToLogInCommand}"
                            BackgroundColor="#007bff"
                            TextColor="White"
                            FontSize="16"
                            Padding="15" />

                    <Button Grid.Column="1"
                            Text="Crear Cuenta" 
                            Command="{Binding GoToSignUpCommand}"
                            BackgroundColor="#28a745"
                            TextColor="White"
                            FontSize="16"
                            Padding="15" />
                </Grid>
            </StackLayout>

            <StackLayout Spacing="15">
                <Label Text="Equipos" 
                       FontSize="20" 
                       FontAttributes="Bold"
                       TextColor="#333" />

                <ActivityIndicator IsVisible="{Binding IsLoading}"
                                 IsRunning="{Binding IsLoading}"
                                 Color="#007bff" />

                <Label Text="No hay equipos disponibles" 
                       FontSize="16"
                       TextColor="#6c757d"
                       HorizontalOptions="Center"
                       IsVisible="{Binding HasNoTeams}" />

                <CollectionView ItemsSource="{Binding AllTeams}"
                               BackgroundColor="Transparent"
                               IsVisible="{Binding HasTeams}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" 
                                        Span="2" 
                                        HorizontalItemSpacing="10" 
                                        VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="metcore:TeamInfoDto">
                            <Border BackgroundColor="White"
                                    Stroke="#dee2e6"
                                    StrokeThickness="1"
                                    Padding="10"
                                    StrokeShape="RoundRectangle 8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                        Path=BindingContext.GoToTeamDetailsCommand}" CommandParameter="{Binding Id}" />
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="*,*,*" RowSpacing="5">
                                    <Label Grid.Row="0"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#333"
                                           LineBreakMode="TailTruncation">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="Location" />
                                                <Binding Path="Mascot" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>

                                    <Label Grid.Row="1"
                                           Text="{Binding UserUsername, StringFormat='Dueño: {0}'}"
                                           FontSize="14"
                                           TextColor="#6c757d"
                                           LineBreakMode="TailTruncation"/>

                                    <Label Grid.Row="2"
                                           Text="{Binding Date, StringFormat='Fecha: {0:MM/dd/yyyy}'}"
                                           FontSize="14"
                                           TextColor="#28a745"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>