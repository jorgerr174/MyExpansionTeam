<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Account.SignUp"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Account"
             x:DataType="viewmodels:SignUpViewModel"
             Title="Crear Cuenta">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <Label Text="Crear Cuenta" 
               FontSize="24" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

            <StackLayout>
                <Label Text="Nombre" />
                <Entry Text="{Binding FirstName}" 
                   Placeholder="Introduzca su nombre"
                   IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <StackLayout>
                <Label Text="Apellidos" />
                <Entry Text="{Binding LastName}" 
                   Placeholder="Introduzca sus apellidos"
                   IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <StackLayout>
                <Label Text="Email" />
                <Entry Text="{Binding Email}" 
                   Placeholder="Introduzca su email"
                   Keyboard="Email"
                   IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <StackLayout>
                <Label Text="Teléfono" />
                <Entry Text="{Binding Tlf}" 
                   Placeholder="Introduzca su teléfono"
                   Keyboard="Telephone"
                   IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <StackLayout>
                <Label Text="Nombre de usuario" />
                <Entry Text="{Binding Username}" 
                   Placeholder="Introduzca su nombre de usuario"
                   IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <StackLayout>
                <Label Text="Contraseña" />
                <Entry Text="{Binding Password}" 
                   IsPassword="True"
                   Placeholder="Introduzca una contraseña"
                   IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <StackLayout>
                <Label Text="Repetir contraseña" />
                <Entry Text="{Binding ConfirmPassword}" 
                   IsPassword="True"
                   Placeholder="Repita la contraseña"
                   IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <Label Text="{Binding ErrorMessage}" 
               TextColor="Red" 
               IsVisible="{Binding HasError}" />

            <Button Text="Crear Cuenta" 
                Command="{Binding SignUpCommand}"
                IsEnabled="{Binding IsFormEnabled}"
                BackgroundColor="Green"
                TextColor="White" />

            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                         IsVisible="{Binding IsLoading}" />

            <Button Text="Volver" 
                Command="{Binding GoBackCommand}"
                BackgroundColor="Transparent"
                TextColor="Blue" />

        </StackLayout>
    </ScrollView>
</ContentPage>