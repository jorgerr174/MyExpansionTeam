<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Account.UpdateCredentials"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Account"
             x:DataType="viewmodels:UpdateCredentialsViewModel"
             Title="Editar Credenciales">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <Border BackgroundColor="#1b6ec2" 
                    Padding="15"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 10">
                <Label Text="Actualizar Credenciales" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="White"
                       HorizontalOptions="Center" />
            </Border>

            <Border BackgroundColor="#ffc107" 
                    Padding="15"
                    Stroke="Orange"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 5">
                <Label Text="⚠️ Atención: Tras actualizar sus credenciales, la sesión actual se cerrará."
                       TextColor="Black"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
            </Border>

            <StackLayout>
                <Label Text="Contraseña Actual *" FontAttributes="Bold" />
                <Entry Text="{Binding CurrentPassword}" 
                       IsPassword="True"
                       Placeholder="Introduzca su contraseña actual"
                       IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <StackLayout>
                <Label Text="Nuevo Nombre de Usuario (opcional)" FontAttributes="Bold" />
                <Entry Text="{Binding NewUsername}" 
                       Placeholder="Introduzca el nuevo nombre de usuario"
                       IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <StackLayout>
                <Label Text="Nueva Contraseña (opcional)" FontAttributes="Bold" />
                <Entry Text="{Binding NewPassword}" 
                       IsPassword="True"
                       Placeholder="Introduzca el nuevo nombre de usuario"
                       IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <StackLayout>
                <Label Text="Repita la nueva contraseña" FontAttributes="Bold" />
                <Entry Text="{Binding ConfirmPassword}" 
                       IsPassword="True"
                       Placeholder="Repita la contraseña"
                       IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <Label Text="{Binding ErrorMessage}" 
                   TextColor="Red" 
                   IsVisible="{Binding HasError}"
                   HorizontalOptions="Center" />

            <Button Text="Actualizar credenciales" 
                    Command="{Binding UpdateCredentialsCommand}"
                    IsEnabled="{Binding IsFormEnabled}"
                    BackgroundColor="#ffc107"
                    TextColor="Black"
                    FontSize="16"
                    HeightRequest="50"
                    CornerRadius="10" />

            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center" />

            <Button Text="Volver" 
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="LightGray"
                    TextColor="Black"
                    FontSize="16"
                    HeightRequest="50"
                    CornerRadius="10" />

        </StackLayout>
    </ScrollView>
</ContentPage>