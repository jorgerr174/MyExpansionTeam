<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Account.UpdateCredentials"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Account"
             x:DataType="viewmodels:UpdateCredentialsViewModel"
             Title="Edit Credentials">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <!-- Header -->
            <Border BackgroundColor="#1b6ec2" 
                    Padding="15"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 10">
                <Label Text="Update Credentials" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="White"
                       HorizontalOptions="Center" />
            </Border>

            <!-- Warning -->
            <Border BackgroundColor="#ffc107" 
                    Padding="15"
                    Stroke="Orange"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 5">
                <Label Text="⚠️ Warning: After updating credentials, you will be logged out."
                       TextColor="Black"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
            </Border>

            <!-- Current Password (Required) -->
            <StackLayout>
                <Label Text="Current Password *" FontAttributes="Bold" />
                <Entry Text="{Binding CurrentPassword}" 
                       IsPassword="True"
                       Placeholder="Enter your current password"
                       IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <!-- New Username (Optional) -->
            <StackLayout>
                <Label Text="New Username (optional)" FontAttributes="Bold" />
                <Entry Text="{Binding NewUsername}" 
                       Placeholder="Enter new username or leave empty"
                       IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <!-- New Password (Optional) -->
            <StackLayout>
                <Label Text="New Password (optional)" FontAttributes="Bold" />
                <Entry Text="{Binding NewPassword}" 
                       IsPassword="True"
                       Placeholder="Enter new password or leave empty"
                       IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <!-- Confirm New Password -->
            <StackLayout>
                <Label Text="Confirm New Password" FontAttributes="Bold" />
                <Entry Text="{Binding ConfirmPassword}" 
                       IsPassword="True"
                       Placeholder="Confirm new password"
                       IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}" 
                   TextColor="Red" 
                   IsVisible="{Binding HasError}"
                   HorizontalOptions="Center" />

            <!-- Update Button -->
            <Button Text="Update Credentials" 
                    Command="{Binding UpdateCredentialsCommand}"
                    IsEnabled="{Binding IsFormEnabled}"
                    BackgroundColor="#ffc107"
                    TextColor="Black"
                    FontSize="16"
                    HeightRequest="50"
                    CornerRadius="10" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center" />

            <!-- Go Back Button -->
            <Button Text="Go Back" 
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="LightGray"
                    TextColor="Black"
                    FontSize="16"
                    HeightRequest="50"
                    CornerRadius="10" />

        </StackLayout>
    </ScrollView>
</ContentPage>