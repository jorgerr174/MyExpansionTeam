<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Account.UpdateCredentials"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Account"
             x:DataType="viewmodels:UpdateCredentialsViewModel"
             Title="UpdateCredentials">
    
    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <!-- Title -->
            <Label Text="Update Credentials" 
               FontSize="24" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

            <!-- Current Password (Required) -->
            <StackLayout>
                <Label Text="Current Password *" />
                <Entry Text="{Binding CurrentPassword}" 
                   IsPassword="True"
                   Placeholder="Enter your current password"
                   IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <!-- New Username (Optional) -->
            <StackLayout>
                <Label Text="New Username (optional)" />
                <Entry Text="{Binding NewUsername}" 
                   Placeholder="Enter new username or leave empty"
                   IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <!-- New Password (Optional) -->
            <StackLayout>
                <Label Text="New Password (optional)" />
                <Entry Text="{Binding NewPassword}" 
                   IsPassword="True"
                   Placeholder="Enter new password or leave empty"
                   IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <!-- Confirm New Password -->
            <StackLayout>
                <Label Text="Confirm New Password" />
                <Entry Text="{Binding ConfirmPassword}" 
                   IsPassword="True"
                   Placeholder="Confirm new password"
                   IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}" 
               TextColor="Red" 
               IsVisible="{Binding HasError}" />

            <!-- Update Button -->
            <Button Text="Update Credentials" 
                Command="{Binding UpdateCredentialsCommand}"
                IsEnabled="{Binding IsFormEnabled}"
                BackgroundColor="Blue"
                TextColor="White" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                         IsVisible="{Binding IsLoading}" />

            <!-- Go Back Button -->
            <Button Text="Go Back" 
                Command="{Binding GoBackCommand}"
                BackgroundColor="Transparent"
                TextColor="Blue" />

        </StackLayout>
    </ScrollView>
</ContentPage>