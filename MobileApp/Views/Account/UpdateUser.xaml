<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Account.UpdateUser"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Account"
             x:DataType="viewmodels:UpdateUserViewModel"
             Title="Editar Perfil">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <Border BackgroundColor="#1b6ec2" 
                    Padding="15"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 10">
                <Label Text="Editar Información de Cuenta" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="White"
                       HorizontalOptions="Center" />
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackLayout Grid.Column="0">
                    <Label Text="Nombre" FontAttributes="Bold" />
                    <Border BackgroundColor="LightGray" 
                            Padding="10"
                            Stroke="Gray"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 5">
                        <Label Text="{Binding CurrentFirstName}" />
                    </Border>
                </StackLayout>
                <StackLayout Grid.Column="1">
                    <Label Text="Nuevo Nombre" FontAttributes="Bold" />
                    <Entry Text="{Binding NewFirstName}" 
                           Placeholder="Introduzca su nuevo nombre"
                           IsEnabled="{Binding IsFormEnabled}" />
                </StackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackLayout Grid.Column="0">
                    <Label Text="Apellidos" FontAttributes="Bold" />
                    <Border BackgroundColor="LightGray" 
                            Padding="10"
                            Stroke="Gray"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 5">
                        <Label Text="{Binding CurrentLastName}" />
                    </Border>
                </StackLayout>
                <StackLayout Grid.Column="1">
                    <Label Text="Nuevos Apellidos" FontAttributes="Bold" />
                    <Entry Text="{Binding NewLastName}" 
                           Placeholder="Introduzca sus nuevos apellidos"
                           IsEnabled="{Binding IsFormEnabled}" />
                </StackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackLayout Grid.Column="0">
                    <Label Text="Email" FontAttributes="Bold" />
                    <Border BackgroundColor="LightGray" 
                            Padding="10"
                            Stroke="Gray"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 5">
                        <Label Text="{Binding CurrentEmail}" />
                    </Border>
                </StackLayout>
                <StackLayout Grid.Column="1">
                    <Label Text="Nuevo Email" FontAttributes="Bold" />
                    <Entry Text="{Binding NewEmail}" 
                           Placeholder="Introduzca su nuevo email"
                           Keyboard="Email"
                           IsEnabled="{Binding IsFormEnabled}" />
                </StackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackLayout Grid.Column="0">
                    <Label Text="Teléfono" FontAttributes="Bold" />
                    <Border BackgroundColor="LightGray" 
                            Padding="10"
                            Stroke="Gray"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 5">
                        <Label Text="{Binding CurrentTlf}" />
                    </Border>
                </StackLayout>
                <StackLayout Grid.Column="1">
                    <Label Text="Nuevo teléfono" FontAttributes="Bold" />
                    <Entry Text="{Binding NewTlf}" 
                           Placeholder="Introduzca su nuevo teléfono"
                           Keyboard="Telephone"
                           IsEnabled="{Binding IsFormEnabled}" />
                </StackLayout>
            </Grid>

            <Label Text="{Binding ErrorMessage}" 
                   TextColor="Red" 
                   IsVisible="{Binding HasError}"
                   HorizontalOptions="Center" />

            <Button Text="Actualizar Información" 
                    Command="{Binding UpdateUserCommand}"
                    IsEnabled="{Binding IsFormEnabled}"
                    BackgroundColor="#28a745"
                    TextColor="White"
                    FontSize="16"
                    HeightRequest="50"
                    CornerRadius="10" />

            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center" />

            <Button Text="Volver" 
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="LightGray"
                    TextColor="Black"
                    FontSize="16"
                    HeightRequest="50"
                    CornerRadius="10" />

        </StackLayout>
    </ScrollView>
</ContentPage>