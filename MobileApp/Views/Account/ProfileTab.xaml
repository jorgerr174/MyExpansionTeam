<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Account.ProfileTab"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Account"
             x:DataType="viewmodels:ProfileTabViewModel"
             Title="Profile">

    <Grid>
        <!-- Login Content - Shown when not authenticated -->
        <ScrollView IsVisible="{Binding IsNotAuthenticated}">
            <StackLayout Padding="20" Spacing="20">
                <Label Text="LogIn" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" />

                <StackLayout>
                    <Label Text="Identifier" />
                    <Entry Text="{Binding Identifier}" 
                           Placeholder="Username or Email" />
                </StackLayout>

                <StackLayout>
                    <Label Text="Password" />
                    <Entry Text="{Binding Password}" 
                           IsPassword="True"
                           Placeholder="Password" />
                </StackLayout>

                <Label Text="{Binding LoginErrorMessage}" 
                       TextColor="Red" 
                       IsVisible="{Binding HasLoginError}" />

                <Button Text="Log In" 
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsNotLoading}"
                        BackgroundColor="Blue"
                        TextColor="White" />

                <ActivityIndicator IsRunning="{Binding IsLoading}" 
                                 IsVisible="{Binding IsLoading}" />
            </StackLayout>
        </ScrollView>

        <!-- Profile Content - Shown when authenticated -->
        <ScrollView IsVisible="{Binding IsAuthenticated}">
            <StackLayout Padding="20" Spacing="15">

                <!-- Title with Username -->
                <Label Text="{Binding Username}" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" />

                <!-- Admin Control Center (if admin) -->
                <Button Text="Admin Control Center" 
                        Command="{Binding GoToAdminCommand}"
                        IsVisible="{Binding IsAdmin}"
                        BackgroundColor="Red"
                        TextColor="White" />

                <!-- Profile Info Display -->
                <Border BackgroundColor="LightGray" Padding="15" Stroke="Gray" StrokeThickness="1">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">

                        <Label Text="First Name:" Grid.Row="0" Grid.Column="0" FontAttributes="Bold" />
                        <Label Text="{Binding FirstName}" Grid.Row="0" Grid.Column="1" />

                        <Label Text="Last Name:" Grid.Row="1" Grid.Column="0" FontAttributes="Bold" />
                        <Label Text="{Binding LastName}" Grid.Row="1" Grid.Column="1" />

                        <Label Text="Email:" Grid.Row="2" Grid.Column="0" FontAttributes="Bold" />
                        <Label Text="{Binding Email}" Grid.Row="2" Grid.Column="1" />

                        <Label Text="Phone:" Grid.Row="3" Grid.Column="0" FontAttributes="Bold" />
                        <Label Text="{Binding Tlf}" Grid.Row="3" Grid.Column="1" />

                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <Button Text="Edit Profile" 
                        Command="{Binding GoToEditProfileCommand}"
                        BackgroundColor="Blue"
                        TextColor="White" />

                <Button Text="LogOut" 
                        Command="{Binding LogOutCommand}"
                        BackgroundColor="Orange"
                        TextColor="White" />

                <Button Text="Delete Account" 
                        Command="{Binding DeleteUserCommand}"
                        BackgroundColor="Red"
                        TextColor="White" />

                <!-- Profile Error Message -->
                <Label Text="{Binding ProfileErrorMessage}" 
                       TextColor="Red" 
                       IsVisible="{Binding HasProfileError}" />

                <!-- Profile Loading Indicator -->
                <ActivityIndicator IsRunning="{Binding IsProfileLoading}" 
                                 IsVisible="{Binding IsProfileLoading}" />

            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>