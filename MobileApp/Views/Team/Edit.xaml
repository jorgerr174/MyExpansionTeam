<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Team.Edit"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Team"
             x:DataType="viewmodels:EditViewModel"
             Title="Edit">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <!-- Title -->
            <Label Text="Edit Team" 
               FontSize="24" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

            <!-- Location -->
            <StackLayout>
                <Label Text="Location *" />
                <Entry Text="{Binding Location}" 
                   Placeholder="Enter team location"
                   IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <!-- Abbreviation -->
            <StackLayout>
                <Label Text="Abbreviation *" />
                <Entry Text="{Binding Abbreviation}" 
                   Placeholder="Enter team abbreviation"
                   IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <!-- Mascot -->
            <StackLayout>
                <Label Text="Mascot *" />
                <Entry Text="{Binding Mascot}" 
                   Placeholder="Enter team mascot"
                   IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}" 
               TextColor="Red" 
               IsVisible="{Binding HasError}" />

            <!-- Action Buttons -->
            <StackLayout Spacing="10">

                <!-- Save Button -->
                <Button Text="Guardar Info" 
                    Command="{Binding SaveTeamCommand}"
                    BackgroundColor="Blue"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50" />

                <!-- Navigation Buttons Row 1 -->
                <StackLayout Orientation="Horizontal" Spacing="5">
                    <Button Text="Editar ajustes" 
                        Command="{Binding GoToSettingsCommand}"
                        BackgroundColor="Orange"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="45"
                        HorizontalOptions="FillAndExpand" />

                    <Button Text="Editar plantilla" 
                        Command="{Binding GoToRosterCommand}"
                        BackgroundColor="Orange"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="45"
                        HorizontalOptions="FillAndExpand" />
                </StackLayout>

                <!-- Navigation Buttons Row 2 -->
                <StackLayout Orientation="Horizontal" Spacing="5">
                    <Button Text="Duplicar equipo" 
                        Command="{Binding DuplicateTeamCommand}"
                        BackgroundColor="Transparent"
                        TextColor="Blue"
                        BorderColor="Blue"
                        BorderWidth="1"
                        CornerRadius="10"
                        HeightRequest="45"
                        HorizontalOptions="FillAndExpand" />

                    <Button Text="Borrar equipo" 
                        Command="{Binding DeleteTeamCommand}"
                        BackgroundColor="Red"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="45"
                        HorizontalOptions="FillAndExpand" />
                </StackLayout>

            </StackLayout>
            
            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                         IsVisible="{Binding IsLoading}" />

            <!-- Go Back Button -->
            <Button Text="Go Back" 
                Command="{Binding GoBackCommand}"
                BackgroundColor="Transparent"
                TextColor="Blue" />

        </StackLayout>
    </ScrollView>
</ContentPage>