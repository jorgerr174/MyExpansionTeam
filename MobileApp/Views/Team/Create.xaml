<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Team.Create"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Team"
             x:DataType="viewmodels:CreateViewModel"
             Title="Crear Equipo">

    <ScrollView>
        <StackLayout Padding="20" Spacing="20" VerticalOptions="Center">

            <StackLayout IsVisible="{Binding IsLoading}" Spacing="15">
                <ActivityIndicator IsRunning="True" Color="#007bff" />
                <Label Text="Creando equipo" 
                       HorizontalOptions="Center" 
                       FontSize="16" 
                       TextColor="#6c757d" />
            </StackLayout>

            <Border BackgroundColor="White"
                    Stroke="#dee2e6"
                    StrokeThickness="1"
                    Padding="0"
                    StrokeShape="RoundRectangle 12"
                    IsVisible="{Binding IsNotLoading}">

                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            BackgroundColor="#007bff"
                            Padding="20"
                            StrokeShape="RoundRectangle 12,12,0,0">
                        <Label Text="Crear Nuevo Equipo" 
                               FontSize="20" 
                               FontAttributes="Bold" 
                               TextColor="White"
                               HorizontalOptions="Center" />
                    </Border>

                    <StackLayout Grid.Row="1" Padding="20" Spacing="20">

                        <StackLayout Spacing="8">
                            <Label Text="Ubicación" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="#333" />
                            <Entry Text="{Binding Location}" 
                                   Placeholder="Introduzca la ubicación (p.ej., Valladolid)"
                                   FontSize="16"
                                   BackgroundColor="#f8f9fa"
                                   TextColor="#333" />
                            <Label Text="{Binding LocationError}" 
                                   TextColor="#dc3545" 
                                   FontSize="12"
                                   IsVisible="{Binding HasLocationError}" />
                        </StackLayout>

                        <!-- Mascot Field -->
                        <StackLayout Spacing="8">
                            <Label Text="Mascota" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="#333" />
                            <Entry Text="{Binding Mascot}" 
                                   Placeholder="Introduzca la mascota (p.ej., Pingüinos)"
                                   FontSize="16"
                                   BackgroundColor="#f8f9fa"
                                   TextColor="#333" />
                            <Label Text="{Binding MascotError}" 
                                   TextColor="#dc3545" 
                                   FontSize="12"
                                   IsVisible="{Binding HasMascotError}" />
                        </StackLayout>

                        <!-- Abbreviation Field -->
                        <StackLayout Spacing="8">
                            <Label Text="Abreviatura" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="#333" />
                            <Entry Text="{Binding Abb}" 
                                   Placeholder="Introduzca la abreviatura (p.ej., VLL)"
                                   MaxLength="3"
                                   FontSize="16"
                                   BackgroundColor="#f8f9fa"
                                   TextColor="#333" />
                            <Label Text="{Binding AbbError}" 
                                   TextColor="#dc3545" 
                                   FontSize="12"
                                   IsVisible="{Binding HasAbbError}" />
                            <Label Text="2-3 caracteres solo" 
                                   FontSize="11" 
                                   TextColor="#6c757d" />
                        </StackLayout>

                        <!-- Action Buttons -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10,0,0">
                            <Button Grid.Column="0"
                                    Text="Cancelar"
                                    Command="{Binding GoBackCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#6c757d"
                                    BorderColor="#6c757d"
                                    BorderWidth="1"
                                    FontSize="16"
                                    Padding="15" />

                            <Button Grid.Column="1"
                                    Text="Crear equipo"
                                    Command="{Binding CreateTeamCommand}"
                                    BackgroundColor="#007bff"
                                    TextColor="White"
                                    FontSize="16"
                                    Padding="15"
                                    IsEnabled="{Binding CanCreate}" />
                        </Grid>

                    </StackLayout>
                </Grid>
            </Border>

        </StackLayout>
    </ScrollView>
</ContentPage>