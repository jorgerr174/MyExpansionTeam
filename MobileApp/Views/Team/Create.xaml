<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Team.Create"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Team"
             x:DataType="viewmodels:CreateViewModel"
             Title="Create">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <!-- Location -->
            <StackLayout>
                <Label Text="Location *" FontAttributes="Bold" />
                <Entry Text="{Binding Location}" 
                       Placeholder="Enter team location"
                       IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <!-- Abbreviation -->
            <StackLayout>
                <Label Text="Abbreviation *" FontAttributes="Bold" />
                <Entry Text="{Binding Abbreviation}" 
                       Placeholder="Enter team abbreviation (e.g. NYY)"
                       IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <!-- Mascot -->
            <StackLayout>
                <Label Text="Mascot *" FontAttributes="Bold" />
                <Entry Text="{Binding Mascot}" 
                       Placeholder="Enter team mascot"
                       IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}" 
                   TextColor="Red" 
                   IsVisible="{Binding HasError}"
                   HorizontalOptions="Center" />

            <!-- Create Button -->
            <Button Text="Create Team" 
                    Command="{Binding CreateTeamCommand}"
                    IsEnabled="{Binding IsFormEnabled}"
                    BackgroundColor="Green"
                    TextColor="White"
                    FontSize="16"
                    HeightRequest="50"
                    CornerRadius="10" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center" />

            <!-- Go Back Button -->
            <Button Text="Go Back" 
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Gray"
                    TextColor="White"
                    FontSize="16"
                    HeightRequest="50"
                    CornerRadius="10" />

        </StackLayout>
    </ScrollView>

</ContentPage>