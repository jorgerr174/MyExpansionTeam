<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Team.RosterSettings"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Team"
             x:DataType="viewmodels:RosterSettingsViewModel"
             Title="RosterSettings">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <!-- Title -->
            <Label Text="{Binding TeamName}" 
                FontSize="24" 
                FontAttributes="Bold" 
                HorizontalOptions="Center" />

            <Label Text="Roster Settings" 
                FontSize="18" 
                HorizontalOptions="Center" />

            <!-- Salary Cap Percentage -->
            <StackLayout>
                <Label Text="Salary Cap Percentage (60-120%)" />
                <Entry Text="{Binding RosterSettingsCap}" 
                    Placeholder="80"
                    Keyboard="Numeric"
                    IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <!-- Max Robbed Players per Franchise -->
            <StackLayout>
                <Label Text="Max # of Robbed players per Franchise (2-10)" />
                <Entry Text="{Binding RosterSettingsMaxPerTeam}" 
                    Placeholder="3"
                    Keyboard="Numeric"
                    IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <!-- Protected Players per Franchise -->
            <StackLayout>
                <Label Text="Protected Players per Franchise (0-6)" />
                <Entry Text="{Binding RosterSettingsProtectedPerTeam}" 
                    Placeholder="3"
                    Keyboard="Numeric"
                    IsEnabled="{Binding IsFormEnabled}" />

                <Button Text="Select Protected Players" 
                    Command="{Binding LoadProtectablePlayersCommand}"
                    BackgroundColor="Blue"
                    TextColor="White"
                    IsEnabled="{Binding IsFormEnabled}" />
            </StackLayout>

            <!-- Protected Players Selection (shown when ShowPlayerSelection is true) -->
            <StackLayout IsVisible="{Binding ShowPlayerSelection}">
                <Frame BackgroundColor="LightYellow" Padding="10">
                    <StackLayout>
                        <Label Text="Select Protected Players" 
                            FontAttributes="Bold" />

                        <Label Text="{Binding RosterSettingsProtectedPerTeam, StringFormat='You can select up to {0} players'}" 
                            FontSize="12" />

                        <CollectionView ItemsSource="{Binding ProtectablePlayers}"
                                    HeightRequest="300">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="5" ColumnDefinitions="Auto,*,Auto">
                                        <CheckBox Grid.Column="0"
                                            IsChecked="{Binding IsSelected}"
                                            CheckedChanged="OnPlayerSelectionChanged" />

                                        <StackLayout Grid.Column="1">
                                            <Label Text="{Binding Name}" 
                                                FontAttributes="Bold" />
                                            <Label Text="{Binding Position}" 
                                                FontSize="12" />
                                            <Label Text="{Binding TeamName}" 
                                                FontSize="10" />
                                        </StackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="Done Selecting" 
                            Command="{Binding HidePlayerSelectionCommand}"
                            BackgroundColor="Green"
                            TextColor="White" />
                    </StackLayout>
                </Frame>
            </StackLayout>

            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}" 
                TextColor="Red" 
                IsVisible="{Binding HasError}" />

            <!-- Save Button -->
            <Button Text="Save Settings" 
                Command="{Binding SaveRosterSettingsCommand}"
                IsEnabled="{Binding IsFormEnabled}"
                BackgroundColor="Green"
                TextColor="White" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                            IsVisible="{Binding IsLoading}" />

            <!-- Go Back Button -->
            <Button Text="Go Back" 
                Command="{Binding GoBackCommand}"
                BackgroundColor="Transparent"
                TextColor="Blue" />

        </StackLayout>
    </ScrollView>

</ContentPage>