<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Team.Draft"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Team"
             x:DataType="viewmodels:DraftViewModel"
             x:Name="DraftPage"
             Title="Draft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollView>
            <StackLayout Grid.Row="0" 
                     IsVisible="{Binding ShowDraftSettings}" 
                     Padding="20" 
                     Spacing="20">

                <Border BackgroundColor="#007bff" 
                        Padding="20"
                        StrokeShape="RoundRectangle 12">
                    <StackLayout Spacing="5">
                        <Label Text="{Binding TeamName}" 
                               FontSize="24" 
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                        <Label Text="Simulación del Draft" 
                               FontSize="16"
                               TextColor="White"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </Border>

                <Border BackgroundColor="White"
                        Stroke="#dee2e6"
                        StrokeThickness="1"
                        Padding="20"
                        StrokeShape="RoundRectangle 8">
                    <StackLayout Spacing="10">
                        <Label Text="Número de rondas a controlar" 
                                    FontSize="16" 
                                    FontAttributes="Bold"
                                    TextColor="#495057"
                                    HorizontalOptions="Center" />
                        <Label Text="Resto de rondas serán simuladas"
                               FontSize="12"
                               TextColor="Black"
                               HorizontalOptions="Center" />
                        <Stepper Value="{Binding ManualRounds}" 
                                HorizontalOptions="Center" 
                                Minimum="0" 
                                Maximum="7" 
                                Increment="1" />
                        <Label Text="{Binding ManualRounds}" 
                                HorizontalOptions="Center" 
                                FontSize="16" 
                                FontAttributes="Bold" 
                                TextColor="Black" />
                    </StackLayout>
                </Border>

                <Border BackgroundColor="White"
                       Stroke="#dee2e6"
                       StrokeThickness="1"
                       Padding="20"
                       Margin="0,15,0,0"
                       StrokeShape="RoundRectangle 8">
                    <StackLayout Spacing="15">
                        <Label Text="Velocidad de Simulación" 
                              FontSize="18" 
                              FontAttributes="Bold"
                              TextColor="#495057"
                              HorizontalOptions="Center" />

                        <StackLayout Spacing="10">
                            <Border BackgroundColor="#f8f9fa" 
                                   Padding="15" 
                                   StrokeShape="RoundRectangle 6">
                                <StackLayout>
                                    <StackLayout Orientation="Horizontal" Spacing="10">
                                        <RadioButton x:Name="FastSpeedRadio"
                                                    IsChecked="{Binding IsFastSpeed}"
                                                    GroupName="SimulationSpeed" />
                                        <Label Text="Rápida" 
                                              FontSize="16"
                                              FontAttributes="Bold"
                                              VerticalOptions="Center" />
                                    </StackLayout>
                                    <Label Text="Elecciones del sistema se procesan instantáneamente"
                                          FontSize="14"
                                          TextColor="#6c757d"
                                          Margin="30,0,0,0" />
                                </StackLayout>
                            </Border>

                            <Border BackgroundColor="#f8f9fa" 
                                   Padding="15" 
                                   StrokeShape="RoundRectangle 6">
                                <StackLayout>
                                    <StackLayout Orientation="Horizontal" Spacing="10">
                                        <RadioButton x:Name="MediumSpeedRadio"
                                                    IsChecked="{Binding IsNormalSpeed}"
                                                    GroupName="SimulationSpeed" />
                                        <Label Text="Normal" 
                                              FontSize="16"
                                              FontAttributes="Bold"
                                              VerticalOptions="Center" />
                                    </StackLayout>
                                    <Label Text="Pausa de 1 segundo entre elecciones del sistema"
                                            FontSize="14"
                                            TextColor="#6c757d"
                                            Margin="30,0,0,0" />
                                </StackLayout>
                            </Border>

                            <Border BackgroundColor="#f8f9fa" 
                                   Padding="15" 
                                   StrokeShape="RoundRectangle 6">
                                <StackLayout>
                                    <StackLayout Orientation="Horizontal" Spacing="10">
                                        <RadioButton x:Name="SlowSpeedRadio"
                                                    IsChecked="{Binding IsSlowSpeed}"
                                                    GroupName="SimulationSpeed" />
                                        <Label Text="Lenta" 
                                              FontSize="16"
                                              FontAttributes="Bold"
                                              VerticalOptions="Center" />
                                    </StackLayout>
                                    <Label Text="Pausa de 2 segundos entre elecciones del sistema"
                                          FontSize="14"
                                          TextColor="#6c757d"
                                          Margin="30,0,0,0" />
                                </StackLayout>
                            </Border>
                        </StackLayout>
                    </StackLayout>
                </Border>
                
                <Border BackgroundColor="White"
                        Stroke="#dee2e6"
                        StrokeThickness="1"
                        Padding="20"
                        StrokeShape="RoundRectangle 8">
                    <StackLayout Orientation="Horizontal" 
                                 Spacing="15"
                                 HorizontalOptions="Center">
                        <CheckBox IsChecked="{Binding AllowTrades}" />
                        <Label Text="Permitir trueques durante el draft" 
                               FontSize="16"
                               VerticalOptions="Center" />
                    </StackLayout>
                </Border>
                
                <Border BackgroundColor="White"
                        Stroke="#dee2e6"
                        StrokeThickness="1"
                        Padding="20"
                        StrokeShape="RoundRectangle 8">
                    <StackLayout Spacing="15">
                        <Label Text="Método de Control" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               TextColor="#495057"
                               HorizontalOptions="Center" />

                        <StackLayout Spacing="10">
                            <Border BackgroundColor="#f8f9fa" 
                                    Padding="15" 
                                    StrokeShape="RoundRectangle 6">
                                <StackLayout>
                                    <StackLayout Orientation="Horizontal" Spacing="10">
                                        <RadioButton x:Name="AutoRadio"
                                                     IsChecked="{Binding IsAutoDraft}"
                                                     GroupName="DraftMethod" />
                                        <Label Text="Automático" 
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </StackLayout>
                                    <Label Text="Sistema realiza todos las elecciones"
                                           FontSize="14"
                                           TextColor="#6c757d"
                                           Margin="30,0,0,0" />
                                </StackLayout>
                            </Border>

                            <Border BackgroundColor="#f8f9fa" 
                                    Padding="15" 
                                    StrokeShape="RoundRectangle 6">
                                <StackLayout>
                                    <StackLayout Orientation="Horizontal" Spacing="10">
                                        <RadioButton x:Name="ManualRadio"
                                                     IsChecked="{Binding IsOnlyTeam}"
                                                     GroupName="DraftMethod" />
                                        <Label Text="Draft Manual" 
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </StackLayout>
                                    <Label Text="Controlas solo los picks de tu equipo"
                                           FontSize="14"
                                           TextColor="#6c757d"
                                           Margin="30,0,0,0" />
                                </StackLayout>
                            </Border>

                            <Border BackgroundColor="#f8f9fa" 
                                    Padding="15" 
                                    StrokeShape="RoundRectangle 6">
                                <StackLayout>
                                    <StackLayout Orientation="Horizontal" Spacing="10">
                                        <RadioButton x:Name="MultipleRadio"
                                                     IsChecked="{Binding IsMultipleDraft}"
                                                     GroupName="DraftMethod" />
                                        <Label Text="Multiples equipos" 
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </StackLayout>
                                    <Label Text="Controla tu equipos y las franquicias seleccionadas"
                                           FontSize="14"
                                           TextColor="#6c757d"
                                           Margin="30,0,0,0" />
                                </StackLayout>
                            </Border>
                        </StackLayout>
                    </StackLayout>
                </Border>

                <Border BackgroundColor="White"
                        Stroke="#dee2e6"
                        StrokeThickness="1"
                        Padding="20"
                        StrokeShape="RoundRectangle 8"
                        IsVisible="{Binding IsMultipleDraft}">
                    <StackLayout Spacing="15">
                        <Label Text="Seleccione las franquicias que controlar" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="#495057"
                               HorizontalOptions="Center" />

                        <CollectionView ItemsSource="{Binding Franchises}"
                                        SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" 
                                                 Span="2" 
                                                 VerticalItemSpacing="5"
                                                 HorizontalItemSpacing="5" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:FranchiseItem">
                                    <Border BackgroundColor="{Binding SelectionColor}"
                                            Stroke="{Binding SelectionBorderColor}"
                                            StrokeThickness="2"
                                            Padding="10"
                                            StrokeShape="RoundRectangle 6">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference DraftPage}, Path=BindingContext.ToggleFranchiseSelectionCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <StackLayout Spacing="2">
                                            <Label Text="{Binding Name}" 
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Abb}" 
                                                   FontSize="10"
                                                   TextColor="#6c757d"
                                                   HorizontalOptions="Center" />
                                        </StackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Border>

                <Button Text="Empezar Draft"
                        BackgroundColor="#28a745"
                        TextColor="White"
                        FontSize="18"
                        FontAttributes="Bold"
                        Padding="15"
                        Command="{Binding LoadDraftCommand}"
                        CornerRadius="8" />
            </StackLayout>
        </ScrollView>

        <Grid Grid.Row="0" 
              IsVisible="{Binding ShowDraftInterface}"
              RowDefinitions="Auto,*,Auto">

            <Border Grid.Row="0" 
                    BackgroundColor="#007bff" 
                    Padding="15,10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="← Volver"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="14"
                            Command="{Binding ReturnCommand}"
                            HorizontalOptions="Start" />

                    <StackLayout Grid.Column="1" 
                                 Spacing="2"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                        <Label Text="{Binding TeamName}" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding CurrentPickText}" 
                               FontSize="12"
                               TextColor="White"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </Grid>
            </Border>

            <Grid Grid.Row="1" 
                  ColumnDefinitions="*,*" 
                  ColumnSpacing="2">

                <Border Grid.Column="0" 
                        BackgroundColor="White"
                        Stroke="#dee2e6"
                        StrokeThickness="1">
                    <StackLayout Spacing="0">
                        <Border BackgroundColor="#007bff" 
                                Padding="10">
                            <Label Text="Orden del Draft" 
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                        </Border>

                        <CollectionView ItemsSource="{Binding DraftOrder}"
                                        BackgroundColor="White"
                                        HeightRequest="400">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:DraftPickItem">
                                    <Border BackgroundColor="{Binding BackgroundColor}"
                                            Stroke="{Binding BorderColor}"
                                            StrokeThickness="{Binding BorderThickness}"
                                            Padding="8"
                                            Margin="2">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <StackLayout Grid.Column="0" Spacing="1">
                                                <Label Text="{Binding Overall, StringFormat='#{0}'}" 
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding TextColor}" />
                                                <Label Text="{Binding Pickround}" 
                                                       FontSize="10"
                                                       TextColor="{Binding TextColor}" />
                                            </StackLayout>

                                            <StackLayout Grid.Column="1" Spacing="1">
                                                <Label Text="{Binding TeamAbb}" 
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding TextColor}" />
                                                <Label Text="{Binding ControlText}" 
                                                       FontSize="9"
                                                       TextColor="{Binding TextColor}"
                                                       IsVisible="{Binding IsUserControlled}" />
                                            </StackLayout>

                                            <StackLayout Grid.Column="2" 
                                                         Spacing="1"
                                                         IsVisible="{Binding HasSelection}">
                                                <Label Text="{Binding Prospect.Name}" 
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding TextColor}"
                                                       HorizontalOptions="End" />
                                                <Label Text="{Binding Prospect.Position}" 
                                                       FontSize="9"
                                                       TextColor="{Binding TextColor}"
                                                       HorizontalOptions="End" />
                                            </StackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Border>

                <Border Grid.Column="1" 
                        BackgroundColor="White"
                        Stroke="#dee2e6"
                        StrokeThickness="1">
                    <StackLayout Spacing="0">
                        <Border BackgroundColor="#6c757d" 
                                Padding="10">
                            <Label Text="Prospectos Disponibles" 
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                        </Border>

                        <Border BackgroundColor="#f8f9fa" 
                                Padding="8">
                            <Picker ItemsSource="{Binding PositionFilters}"
                                    SelectedItem="{Binding SelectedPositionFilter}"
                                    Title="Filtrar por Posición"
                                    FontSize="12" />
                        </Border>

                        <Border BackgroundColor="#d1ecf1"
                                Stroke="#bee5eb"
                                StrokeThickness="1"
                                Padding="8"
                                Margin="4">
                            <StackLayout Spacing="2">
                                <Label Text="{Binding CurrentPickInfoTitle}" 
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#0c5460" />
                                <Label Text="{Binding CurrentPickInfoText}" 
                                       FontSize="10"
                                       TextColor="#0c5460" />
                            </StackLayout>
                        </Border>

                        <CollectionView ItemsSource="{Binding FilteredProspects}"
                                        BackgroundColor="White"
                                        SelectionMode="None"
                                        HeightRequest="400">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:ProspectItem">
                                    <Border BackgroundColor="White"
                                            Stroke="#dee2e6"
                                            StrokeThickness="1"
                                            Padding="8"
                                            Margin="2">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference DraftPage}, Path=BindingContext.SelectProspectCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding Name}" 
                                                       FontSize="12"
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding PositionCollege}" 
                                                       FontSize="10"
                                                       TextColor="#6c757d" />
                                                <Label Text="{Binding PhysicalInfo}" 
                                                       FontSize="9"
                                                       TextColor="#6c757d" />
                                            </StackLayout>
                                            <StackLayout Grid.Column="1" 
                                                         Spacing="2"
                                                         HorizontalOptions="End">
                                                <Label Text="{Binding ConsensusText, StringFormat='TOTAL: {0}'}" 
                                                       FontSize="10"
                                                       TextColor="#007bff"
                                                       HorizontalOptions="End" />
                                                <Label Text="{Binding Prospect.AthScore}" 
                                                       FontSize="9"
                                                       TextColor="#28a745"
                                                       HorizontalOptions="End" />
                                            </StackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Border>
            </Grid>

            <Border Grid.Row="2" 
                    BackgroundColor="White"
                    Stroke="#dee2e6"
                    StrokeThickness="1"
                    Padding="10">
                <StackLayout Orientation="Horizontal" 
                             Spacing="10"
                             HorizontalOptions="Center">
                    <Button Text="{Binding PauseResumeText}"
                            BackgroundColor="#ffc107"
                            TextColor="Black"
                            FontSize="12"
                            Padding="10,6"
                            Command="{Binding TogglePauseCommand}"
                            IsVisible="{Binding ShowPauseButton}" />
                    <Button Text="Nuevo Trueque"
                            BackgroundColor="#17a2b8"
                            TextColor="White"
                            FontSize="12"
                            Padding="10,6"
                            Command="{Binding TradeCommand}"
                            IsVisible="{Binding AllowTrades}" />
                </StackLayout>
            </Border>
        </Grid>

        <ScrollView BackgroundColor="White"
                    Grid.Row="0" 
                    IsVisible="{Binding ShowDraftSummary}">
            <StackLayout Padding="20" Spacing="20">

                <Label Text="🏆 Resumen del Draft" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" />

                <Button Text="Guardar Draft"
                        Command="{Binding SaveDraftCommand}"
                        BackgroundColor="#28a745"
                        TextColor="White"
                        FontSize="16"
                        Padding="15" />

                <CollectionView ItemsSource="{Binding DraftResults}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type viewmodels:DraftSelection}">
                            <Border BackgroundColor="#f8f9fa"
                                    Stroke="#28a745"
                                    StrokeThickness="1"
                                    Padding="15"
                                    Margin="0,5"
                                    StrokeShape="RoundRectangle 8">
                                <StackLayout>
                                    <Label Text="{Binding Pick}" 
                                           FontSize="12" 
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding Player.Name}" 
                                           FontSize="16" 
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding Player.Position}" 
                                           FontSize="14" 
                                           TextColor="#6c757d" />
                                </StackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </StackLayout>
        </ScrollView>

        <StackLayout Grid.Row="0"
                     BackgroundColor="#80000000"
                     IsVisible="{Binding IsLoading}"
                     VerticalOptions="Fill"
                     HorizontalOptions="Fill">
            <ActivityIndicator IsRunning="True" 
                               Color="White" 
                               VerticalOptions="Center" />
            <Label Text="{Binding LoadingMessage}"
                   TextColor="White"
                   FontSize="16"
                   HorizontalOptions="Center" />
        </StackLayout>
    </Grid>
</ContentPage>