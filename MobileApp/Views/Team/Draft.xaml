<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Team.Draft"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Team"
             xmlns:converters="clr-namespace:MobileApp.Converters"
             x:DataType="viewmodels:DraftViewModel"
             Title="Draft">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringEqualsConverter x:Key="StringEqualsConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <!-- Main Content Area -->
        <ScrollView Grid.Row="0">
            <StackLayout Padding="20" Spacing="15">

                <!-- Team Header -->
                <Frame BackgroundColor="Blue" Padding="15" CornerRadius="10">
                    <StackLayout>
                        <Label Text="{Binding TeamName}" 
                               TextColor="White"
                               FontSize="24" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center" />
                        <Label Text="NFL Draft Simulation" 
                               TextColor="White"
                               FontSize="16" 
                               HorizontalOptions="Center" />
                    </StackLayout>
                </Frame>

                <!-- Draft Settings (Visible before draft starts) -->
                <StackLayout IsVisible="{Binding ShowDraftSettings}" Spacing="20">

                    <!-- Draft Method Selection -->
                    <Frame BackgroundColor="LightBlue" Padding="15" CornerRadius="10">
                        <StackLayout>
                            <Label Text="Draft Control Method" 
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   HorizontalOptions="Center" />

                            <StackLayout Spacing="10" Margin="0,10,0,0">
                                <Frame BackgroundColor="White" Padding="10" CornerRadius="8">
                                    <StackLayout>
                                        <RadioButton x:Name="FullSimRadio" 
                                                     Content="Full Simulation" 
                                                     Value="full"
                                                     IsChecked="{Binding SelectedDraftMethod, Converter={StaticResource StringEqualsConverter}, ConverterParameter=full}"
                                                     CheckedChanged="OnDraftMethodChanged" />
                                        <Label Text="Watch the entire draft unfold automatically" 
                                               FontSize="12" 
                                               TextColor="Gray" 
                                               Margin="25,0,0,0" />
                                    </StackLayout>
                                </Frame>

                                <Frame BackgroundColor="White" Padding="10" CornerRadius="8">
                                    <StackLayout>
                                        <RadioButton x:Name="MyTeamRadio" 
                                                     Content="Control My Team" 
                                                     Value="myteam"
                                                     IsChecked="{Binding SelectedDraftMethod, Converter={StaticResource StringEqualsConverter}, ConverterParameter=myteam}"
                                                     CheckedChanged="OnDraftMethodChanged" />
                                        <Label Text="{Binding TeamName, StringFormat='Make picks for {0} only'}" 
                                               FontSize="12" 
                                               TextColor="Gray" 
                                               Margin="25,0,0,0" />
                                    </StackLayout>
                                </Frame>

                                <Frame BackgroundColor="White" Padding="10" CornerRadius="8">
                                    <StackLayout>
                                        <RadioButton x:Name="MultipleRadio" 
                                                     Content="Control Multiple Teams" 
                                                     Value="multiple"
                                                     IsChecked="{Binding SelectedDraftMethod, Converter={StaticResource StringEqualsConverter}, ConverterParameter=multiple}"
                                                     CheckedChanged="OnDraftMethodChanged" />
                                        <Label Text="Choose which franchises to control" 
                                               FontSize="12" 
                                               TextColor="Gray" 
                                               Margin="25,0,0,0" />
                                    </StackLayout>
                                </Frame>
                            </StackLayout>
                        </StackLayout>
                    </Frame>

                    <!-- Manual Rounds Selection -->
                    <Frame BackgroundColor="LightGreen" Padding="15" CornerRadius="10">
                        <StackLayout>
                            <Label Text="Manual Control Rounds" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   HorizontalOptions="Center" />
                            <Label Text="Number of rounds to manually control (0 = full auto)" 
                                   FontSize="12" 
                                   TextColor="Gray" 
                                   HorizontalOptions="Center" />

                            <Picker ItemsSource="{Binding RoundOptions}" 
                                    SelectedItem="{Binding ManualRounds}"
                                    Title="Select Rounds"
                                    Margin="0,10,0,0" />
                        </StackLayout>
                    </Frame>

                    <!-- Franchise Selection (Visible for multiple team method) -->
                    <Frame BackgroundColor="LightYellow" 
                           Padding="15" 
                           CornerRadius="10"
                           IsVisible="{Binding ShowFranchiseSelection}">
                        <StackLayout>
                            <Label Text="Select Franchises to Control" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   HorizontalOptions="Center" />
                            <Label Text="Choose which teams you want to control picks for" 
                                   FontSize="12" 
                                   TextColor="Gray" 
                                   HorizontalOptions="Center" 
                                   Margin="0,0,0,10" />

                            <ScrollView HeightRequest="200">
                                <CollectionView ItemsSource="{Binding SelectedFranchises}"
                                              SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="5" ColumnDefinitions="Auto,*">
                                                <CheckBox Grid.Column="0" 
                                                         IsChecked="{Binding IsSelected}"
                                                         VerticalOptions="Center" />
                                                <StackLayout Grid.Column="1" 
                                                           Orientation="Horizontal" 
                                                           VerticalOptions="Center"
                                                           Margin="10,0,0,0">
                                                    <Label Text="{Binding Abbreviation}" 
                                                           FontAttributes="Bold" 
                                                           VerticalOptions="Center" />
                                                    <Label Text="{Binding Name}" 
                                                           VerticalOptions="Center" 
                                                           Margin="10,0,0,0" />
                                                </StackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </ScrollView>
                        </StackLayout>
                    </Frame>

                    <!-- Start Draft Button -->
                    <Button Text="Start Draft" 
                            Command="{Binding StartDraftCommand}"
                            BackgroundColor="Green"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="25"
                            HeightRequest="50"
                            FontSize="18" />

                </StackLayout>

                <!-- Draft In Progress (Visible during draft) -->
                <StackLayout IsVisible="{Binding IsDraftActive}" Spacing="15">

                    <!-- Current Pick Info -->
                    <Frame BackgroundColor="Blue" Padding="15" CornerRadius="10">
                        <StackLayout HorizontalOptions="Center">
                            <Label Text="{Binding CurrentPickText}" 
                                   TextColor="White"
                                   FontSize="20" 
                                   FontAttributes="Bold" 
                                   HorizontalOptions="Center" />

                            <Label Text="{Binding TeamPicksText}" 
                                   TextColor="White"
                                   FontSize="14" 
                                   HorizontalOptions="Center" />

                            <Label Text="{Binding NextPickText}" 
                                   TextColor="White"
                                   FontSize="14" 
                                   HorizontalOptions="Center" />

                            <!-- Action Buttons -->
                            <StackLayout Orientation="Horizontal" 
                                         HorizontalOptions="Center"
                                         Spacing="10"
                                         Margin="0,15,0,0">
                                <Button Text="Make Pick"
                                        Command="{Binding MakePickCommand}"
                                        IsVisible="{Binding CanMakePick}"
                                        BackgroundColor="White"
                                        TextColor="Blue"
                                        FontAttributes="Bold"
                                        CornerRadius="20"
                                        WidthRequest="120" />

                                <Button Text="Simulate Pick"
                                        Command="{Binding SimulatePickCommand}"
                                        IsVisible="{Binding CanSimulatePick}"
                                        BackgroundColor="#4CAF50"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        CornerRadius="20"
                                        WidthRequest="120" />

                                <Button Text="{Binding PauseResumeText}"
                                        Command="{Binding PauseResumeCommand}"
                                        IsVisible="{Binding CanPauseResume}"
                                        BackgroundColor="#FF9800"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        CornerRadius="20"
                                        WidthRequest="80" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>

                    <!-- Draft Order and Prospects -->
                    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,*">

                        <!-- Tab Headers -->
                        <Frame Grid.Row="0" Grid.Column="0"
                               BackgroundColor="Blue"
                               HasShadow="False"
                               CornerRadius="10,0,0,0"
                               Margin="0,0,1,0">
                            <Label Text="Draft Order" 
                                   TextColor="White"
                                   FontAttributes="Bold" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" />
                        </Frame>

                        <Frame Grid.Row="0" Grid.Column="1"
                               BackgroundColor="Gray"
                               HasShadow="False"
                               CornerRadius="0,10,0,0"
                               Margin="1,0,0,0">
                            <Label Text="Available Prospects" 
                                   TextColor="White"
                                   FontAttributes="Bold" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" />
                        </Frame>

                        <!-- Draft Order List -->
                        <Frame Grid.Row="1" Grid.Column="0"
                               BackgroundColor="White"
                               HasShadow="False"
                               CornerRadius="0,0,0,10"
                               Margin="0,0,1,0">
                            <CollectionView ItemsSource="{Binding DraftOrder}"
                                          HeightRequest="400">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8" Margin="2">
                                            <Frame BackgroundColor="{Binding IsUserTeam, Converter={StaticResource BoolToColorConverter}}" 
                                                   Padding="10"
                                                   CornerRadius="5">
                                                <StackLayout>
                                                    <Label Text="{Binding Overall, StringFormat='#{0}'}" 
                                                           FontAttributes="Bold" 
                                                           FontSize="16" />
                                                    <Label Text="{Binding TeamAbbr}" 
                                                           FontSize="14" />
                                                    <Label Text="{Binding Round, StringFormat='Round {0}'}" 
                                                           FontSize="12" 
                                                           TextColor="Gray" />
                                                    <Label Text="{Binding SelectedPlayer.Name}" 
                                                           FontAttributes="Bold"
                                                           IsVisible="{Binding SelectedPlayer, Converter={StaticResource IsNotNullConverter}}" />
                                                </StackLayout>
                                            </Frame>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Frame>

                        <!-- Available Prospects List -->
                        <Frame Grid.Row="1" Grid.Column="1"
                               BackgroundColor="White"
                               HasShadow="False"
                               CornerRadius="0,0,10,0"
                               Margin="1,0,0,0">
                            <CollectionView ItemsSource="{Binding AvailableProspects}"
                                          HeightRequest="400">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="5" Margin="1">
                                            <Frame BackgroundColor="LightGray" Padding="8" CornerRadius="5">
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <StackLayout Grid.Column="0" VerticalOptions="Center">
                                                        <Label Text="{Binding Name}" 
                                                               FontAttributes="Bold" 
                                                               FontSize="14" />
                                                        <Label Text="{Binding Position}" 
                                                               FontSize="12" 
                                                               TextColor="Gray" />
                                                    </StackLayout>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding Position}"
                                                           TextColor="Blue"
                                                           VerticalOptions="Center"
                                                           Margin="8,0,0,0" />
                                                    <Label Grid.Column="2"
                                                           Text="{Binding Consensus, StringFormat='#{0}'}"
                                                           FontSize="12"
                                                           TextColor="Gray"
                                                           VerticalOptions="Center"
                                                           Margin="8,0,0,0" />
                                                </Grid>
                                            </Frame>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Frame>
                    </Grid>

                    <!-- Draft Controls -->
                    <StackLayout Orientation="Horizontal" 
                                 HorizontalOptions="Center"
                                 Spacing="10">
                        <Button Text="Save Draft"
                                Command="{Binding SaveDraftCommand}"
                                BackgroundColor="#2196F3"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="20"
                                WidthRequest="100" />
                    </StackLayout>

                </StackLayout>

            </StackLayout>
        </ScrollView>

        <!-- Loading Indicator -->
        <StackLayout Grid.Row="0" 
                     IsVisible="{Binding IsLoading}"
                     BackgroundColor="Black" 
                     Opacity="0.6"
                     VerticalOptions="FillAndExpand"
                     HorizontalOptions="FillAndExpand">
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                             Color="White"
                             VerticalOptions="CenterAndExpand"
                             HorizontalOptions="CenterAndExpand" />
            <Label Text="Loading..." 
                   TextColor="White"
                   HorizontalOptions="Center" />
        </StackLayout>

        <!-- Bottom Navigation -->
        <Button Grid.Row="1"
                Text="Back to Team"
                Command="{Binding BackCommand}"
                BackgroundColor="LightGray"
                TextColor="Black"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="45"
                Margin="20" />

    </Grid>

</ContentPage>