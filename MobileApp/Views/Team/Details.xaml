<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Team.Details"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Team"
             x:DataType="viewmodels:DetailsViewModel"
             Title="Team Details">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <Grid IsVisible="{Binding ShowLoadingState}" RowDefinitions="*,Auto,Auto,Auto,*">
                <ActivityIndicator Grid.Row="1" IsRunning="True" HorizontalOptions="Center" />
                <Label Grid.Row="2" Text="Loading team details..." HorizontalOptions="Center" FontSize="16" />
                <Button Grid.Row="3" Text="Go Back" Command="{Binding GoBackCommand}" HorizontalOptions="Center" BackgroundColor="Gray" TextColor="White" />
            </Grid>

            <Grid IsVisible="{Binding ShowErrorState}" RowDefinitions="*,Auto,Auto,Auto,Auto,*">
                <Label Grid.Row="1" Text="⚠️" HorizontalOptions="Center" FontSize="48" />
                <Label Grid.Row="2" Text="{Binding LoadErrorMessage}" HorizontalOptions="Center" FontSize="16" TextColor="Red" />
                <Button Grid.Row="3" Text="Go Back" Command="{Binding GoBackCommand}" HorizontalOptions="Center" BackgroundColor="Gray" TextColor="White" />
                <Button Grid.Row="4" Text="Try Again" Command="{Binding LoadViewCommand}" CommandParameter="{Binding Team.Id}" HorizontalOptions="Center" BackgroundColor="Blue" TextColor="White" />
            </Grid>

            <!-- Content State -->
            <StackLayout IsVisible="{Binding ShowContent}" Spacing="15">

                <!-- Team Info -->
                <Label Text="{Binding Team.Location}" 
                   FontSize="24" 
                   FontAttributes="Bold" />

                <Label Text="{Binding Team.Mascot}" 
                   FontSize="20" />

                <Label Text="{Binding Team.Abb}" 
                   FontSize="16" 
                   TextColor="Gray" />

                <!-- Navigation Buttons -->
                <Button Text="View Draft Results" 
                    Command="{Binding GoToDraftResultsCommand}"
                    BackgroundColor="Green" TextColor="White" />

                <Button Text="Edit Team" 
                    Command="{Binding GoToEditTeamCommand}"
                    BackgroundColor="Blue" TextColor="White" />

                <Button Text="View Roster" 
                    Command="{Binding GoToRosterCommand}"
                    BackgroundColor="Orange" TextColor="White" />

                <Button Text="View Formation" 
                    Command="{Binding GoToFormationCommand}"
                    BackgroundColor="Purple" TextColor="White" />

                <Button Text="View Trades" 
                    Command="{Binding GoToTradesCommand}"
                    BackgroundColor="Teal" TextColor="White" />

                <Button Text="Roster Settings" 
                    Command="{Binding GoToRosterSettingsCommand}"
                    BackgroundColor="Navy" TextColor="White" />

                <Button Text="Review Roster" 
                    Command="{Binding GoToReviewRosterCommand}"
                    BackgroundColor="Maroon" TextColor="White" />

                <!-- Team Actions -->
                <Button Text="Duplicate Team" 
                    Command="{Binding DuplicateTeamCommand}"
                    BackgroundColor="Gray" TextColor="White" />

                <Button Text="Delete Team" 
                    Command="{Binding DeleteTeamCommand}"
                    BackgroundColor="Red" TextColor="White" />

                <!-- Go Back Button -->
                <Button Text="Go Back" 
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="LightGray" TextColor="Black" />
            </StackLayout>
            
        </StackLayout>
    </ScrollView>
</ContentPage>