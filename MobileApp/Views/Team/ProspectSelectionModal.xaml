<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Team.ProspectSelectionModal"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Team"
             x:DataType="viewmodels:ProspectSelectionViewModel"
             Title="Select Draft Pick"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1e1e1e}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <Frame Grid.Row="0"
               BackgroundColor="{StaticResource Primary}"
               HasShadow="True"
               CornerRadius="0"
               Margin="0">
            <Label Text="Select Your Draft Pick"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Frame>

        <!-- Search and Filters -->
        <StackLayout Grid.Row="1" Padding="16" Spacing="12">

            <!-- Search Bar -->
            <Entry Text="{Binding SearchText}"
                   Placeholder="Search prospects by name or college..."
                   BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#3d3d42}"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                   PlaceholderColor="{AppThemeBinding Light=#666, Dark=#ccc}" />

            <!-- Position Filter -->
            <Grid ColumnDefinitions="Auto,*">
                <Label Grid.Column="0"
                       Text="Position:"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                       VerticalOptions="Center"
                       Margin="0,0,10,0" />
                <Picker Grid.Column="1"
                        ItemsSource="{Binding Positions}"
                        SelectedItem="{Binding SelectedPosition}"
                        BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#3d3d42}"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}" />
            </Grid>
        </StackLayout>

        <!-- Prospects List -->
        <ScrollView Grid.Row="2">
            <StackLayout Spacing="16" Padding="16,0">

                <!-- Selected Prospect Preview -->
                <Frame IsVisible="{Binding IsSelectedProspectVisible}"
                       BackgroundColor="{AppThemeBinding Light=#e8f5e8, Dark=#1a2e1a}"
                       HasShadow="True"
                       CornerRadius="10"
                       BorderColor="{StaticResource Primary}">
                    <StackLayout Spacing="8">
                        <Label Text="Selected Prospect"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding SelectedProspectName}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding SelectedProspectPosition}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />

                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding SelectedProspectCollege}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light=#666, Dark=#ccc}" />

                            <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding SelectedProspectRanking}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </Grid>

                        <Label Text="{Binding SelectedProspectCombineStats}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666, Dark=#ccc}"
                               IsVisible="{Binding SelectedProspectCombineStats, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackLayout>
                </Frame>

                <!-- Prospects Collection -->
                <CollectionView ItemsSource="{Binding FilteredProspects}"
                                SelectedItem="{Binding SelectedProspect}"
                                SelectionMode="Single"
                                HeightRequest="400">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2d2d30}"
                                   HasShadow="True"
                                   CornerRadius="8"
                                   Margin="0,4"
                                   Padding="12">

                                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">

                                    <!-- Name and Position -->
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Name}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Position}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           VerticalOptions="Center"
                                           Margin="8,0,0,0" />
                                    <Label Grid.Row="0" Grid.Column="2"
                                           Text="{Binding Consensus, StringFormat='#{0}'}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#666, Dark=#ccc}"
                                           VerticalOptions="Center"
                                           Margin="8,0,0,0" />

                                    <!-- College -->
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                           Text="{Binding College}"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light=#666, Dark=#ccc}"
                                           Margin="0,4,0,0" />

                                    <!-- Physical Stats -->
                                    <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                 Orientation="Horizontal"
                                                 Spacing="15"
                                                 Margin="0,4,0,0">
                                        <Label Text="{Binding Height}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#666, Dark=#ccc}" />
                                        <Label Text="{Binding Weight}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#666, Dark=#ccc}" />
                                        <Label Text="{Binding AthScore, StringFormat='Ath: {0}'}"
                                               FontSize="12"
                                               TextColor="{StaticResource Primary}"
                                               IsVisible="{Binding AthScore, Converter={StaticResource IntToBoolConverter}}" />
                                    </StackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ScrollView>

        <!-- Action Buttons -->
        <Grid Grid.Row="3" 
              ColumnDefinitions="*,*" 
              Padding="16"
              BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#2d2d30}">
            <Button Grid.Column="0"
                    Text="Cancel"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#3d3d42}"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,0,8,0" />

            <Button Grid.Column="1"
                    Text="Select Player"
                    Command="{Binding ConfirmSelectionCommand}"
                    BackgroundColor="{Binding IsSelectEnabled, Converter={StaticResource BoolToColorConverter}}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="8,0,0,0" />
        </Grid>
    </Grid>

</ContentPage>