<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Team.Formation"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Team"
             x:DataType="viewmodels:FormationViewModel"
             Title="Starters">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <!-- Header -->
            <Label Text="{Binding TeamName}" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />

            <Label Text="Starters" 
                   FontSize="18" 
                   HorizontalOptions="Center" />

            <!-- Formation Type Selection -->
            <StackLayout>
                <Label Text="Formation Type:" FontAttributes="Bold" />

                <CollectionView ItemsSource="{Binding FormationTypes}"
                              ItemsLayout="HorizontalList"
                              HeightRequest="50">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding Converter={StaticResource StringCapitalizeConverter}}" 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ChangeFormationTypeCommand}"
                                    CommandParameter="{Binding}"
                                    BackgroundColor="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CurrentFormationType, Converter={StaticResource SelectedFormationColorConverter}, ConverterParameter={Binding}}"
                                    TextColor="White"
                                    Margin="5" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

            <!-- Formation Selection -->
            <StackLayout>
                <Label Text="Select Formation:" FontAttributes="Bold" />

                <CollectionView ItemsSource="{Binding AvailableFormations}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding Name}" 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectFormationCommand}"
                                    CommandParameter="{Binding}"
                                    BackgroundColor="{Binding Name, Converter={StaticResource SelectedFormationColorConverter}, ConverterParameter={Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectedFormation}}"
                                    TextColor="White"
                                    Margin="2" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

            <!-- Formation Positions -->
            <StackLayout IsVisible="{Binding SelectedFormation, Converter={StaticResource StringToBoolConverter}}">
                <Label Text="Assign Players to Positions:" FontAttributes="Bold" />

                <!-- Current Formation Info -->
                <Frame BackgroundColor="LightBlue" Padding="10">
                    <Label Text="{Binding SelectedFormation, StringFormat='Formation: {0}'}" 
                           FontAttributes="Bold" />
                </Frame>

                <!-- Position Assignments -->
                <CollectionView ItemsSource="{Binding AvailableFormations}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- This would show when this formation is selected -->
                            <StackLayout IsVisible="{Binding Name, Converter={StaticResource FormationMatchConverter}, ConverterParameter={Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectedFormation}}">

                                <CollectionView ItemsSource="{Binding Positions}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Frame BackgroundColor="LightGray" Padding="10" Margin="2">
                                                <StackLayout>
                                                    <Label Text="{Binding Name}" 
                                                           FontAttributes="Bold" />
                                                    <Label Text="{Binding Position, StringFormat='Position: {0}'}" 
                                                           FontSize="12" />

                                                    <!-- Assigned Player -->
                                                    <Label Text="{Binding Id, Converter={StaticResource PositionToPlayerConverter}, ConverterParameter={Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.StarterPositions}}" 
                                                           BackgroundColor="Green"
                                                           TextColor="White"
                                                           Padding="5"
                                                           IsVisible="{Binding Id, Converter={StaticResource PositionHasPlayerConverter}, ConverterParameter={Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.StarterPositions}}" />

                                                    <!-- Select Player Button -->
                                                    <Button Text="Select Player" 
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectPlayerForPositionCommand}"
                                                            CommandParameter="{Binding Id}"
                                                            BackgroundColor="Blue"
                                                            TextColor="White" />

                                                    <!-- Remove Player Button -->
                                                    <Button Text="Remove" 
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemovePlayerFromPositionCommand}"
                                                            CommandParameter="{Binding Id}"
                                                            BackgroundColor="Red"
                                                            TextColor="White"
                                                            IsVisible="{Binding Id, Converter={StaticResource PositionHasPlayerConverter}, ConverterParameter={Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.StarterPositions}}" />
                                                </StackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

            <!-- Bench Players -->
            <StackLayout>
                <Label Text="Available Players (Bench):" FontAttributes="Bold" />

                <CollectionView ItemsSource="{Binding BenchPlayers}"
                              HeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="5" Margin="2">
                                <Frame BackgroundColor="LightYellow" Padding="10">
                                    <StackLayout Orientation="Horizontal">
                                        <Label Text="{Binding Name}" 
                                               FontAttributes="Bold" 
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding Position}" 
                                               FontSize="12"
                                               VerticalOptions="Center"
                                               Margin="10,0,0,0"
                                               BackgroundColor="Blue"
                                               TextColor="White"
                                               Padding="5,2" />
                                    </StackLayout>
                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}" 
                   TextColor="Red" 
                   IsVisible="{Binding HasError}" />

            <!-- Save Button -->
            <Button Text="Save Formation" 
                    Command="{Binding SaveFormationCommand}"
                    IsEnabled="{Binding IsFormEnabled}"
                    BackgroundColor="Green"
                    TextColor="White" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                             IsVisible="{Binding IsLoading}" />

            <!-- Go Back Button -->
            <Button Text="Go Back" 
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="Blue" />

        </StackLayout>
    </ScrollView>

</ContentPage>