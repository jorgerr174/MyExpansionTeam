<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Team.Trades"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Team"
             x:DataType="viewmodels:TradesViewModel"
             Title="Trueques Pasados">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <Label Text="{Binding TeamName}" 
                FontSize="24" 
                FontAttributes="Bold" 
                HorizontalOptions="Center" />

            <Label Text="Historial de Trueques - Phase 4" 
                FontSize="18" 
                HorizontalOptions="Center" />

            <StackLayout Orientation="Horizontal" Spacing="10">
                <Button Text="Nuevo Trade" 
                    Command="{Binding GoToNewTradeCommand}"
                    BackgroundColor="Green"
                    TextColor="White"
                    HorizontalOptions="Fill" />

                <Button Text="Recargar" 
                    Command="{Binding LoadTradesCommand}"
                    CommandParameter="{Binding TeamId}"
                    BackgroundColor="Blue"
                    TextColor="White"
                    HorizontalOptions="Fill" />
            </StackLayout>

            <StackLayout>
                <Label Text="Filtrar por Año:" FontAttributes="Bold" />

                <CollectionView ItemsSource="{Binding YearFilters}"
                            ItemsLayout="HorizontalList"
                            HeightRequest="50">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding}" 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FilterByYearCommand}"
                                CommandParameter="{Binding}"
                                BackgroundColor="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectedYearFilter, Converter={StaticResource SelectedFilterColorConverter}, ConverterParameter={Binding}}"
                                TextColor="White"
                                Margin="2" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

            <Border BackgroundColor="LightBlue" Padding="15" Stroke="Blue"  StrokeThickness="1" StrokeShape="RoundRectangle 10" 
                    IsVisible="{Binding FilteredTrades.Count, Converter={StaticResource CountToBoolConverter}}">
                <StackLayout>
                    <Label Text="{Binding FilteredTrades.Count, StringFormat='Núm Trueques: {0}'}" 
                        FontAttributes="Bold" 
                        HorizontalOptions="Center" />
                    <Label Text="{Binding SelectedYearFilter, StringFormat='Mostrando trueques de: {0}'}" 
                        FontSize="12" 
                        HorizontalOptions="Center" />
                </StackLayout>
            </Border>

            <StackLayout IsVisible="{Binding HasNoTrades, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="{Binding FilteredTrades.Count, StringFormat='Mostrando {0} trueques'}" 
                    FontSize="12" />

                <CollectionView ItemsSource="{Binding FilteredTrades}"
                            HeightRequest="400">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="5" Margin="2">
                                <Border BackgroundColor="LightGray" Padding="15" Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                                    <StackLayout>
                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewTradeDetailsCommand}"
                                                            CommandParameter="{Binding}" />
                                        </StackLayout.GestureRecognizers>

                                        <StackLayout Orientation="Horizontal">
                                            <Label Text="{Binding TradeTitle}" 
                                                FontAttributes="Bold" 
                                                VerticalOptions="Center"
                                                HorizontalOptions="Start" />

                                            <Label Text="⚠️" 
                                                VerticalOptions="Center"
                                                IsVisible="{Binding IsForced}"
                                                ToolTipProperties.Text="Trueque Forzado" />
                                        </StackLayout>

                                        <Label Text="{Binding TradeSubtitle}" 
                                            FontSize="12"
                                            TextColor="Gray" />

                                        <Label Text="{Binding TradeSummary}" 
                                            FontSize="12"
                                            FontAttributes="Italic" />

                                        <StackLayout Orientation="Horizontal" Spacing="20" Margin="0,5,0,0">
                                            <StackLayout HorizontalOptions="Fill">
                                                <Label Text="Envió:" FontSize="10" FontAttributes="Bold" />
                                                <StackLayout>
                                                    <Label Text="{Binding TeamPlayers.Count, StringFormat='{0} Jugadores'}" 
                                                        FontSize="10" 
                                                        IsVisible="{Binding TeamPlayers.Count, Converter={StaticResource CountToBoolConverter}}" />
                                                    <Label Text="{Binding TeamPicks.Count, StringFormat='{0} Picks'}" 
                                                        FontSize="10" 
                                                        IsVisible="{Binding TeamPicks.Count, Converter={StaticResource CountToBoolConverter}}" />
                                                </StackLayout>
                                            </StackLayout>

                                            <StackLayout HorizontalOptions="Fill">
                                                <Label Text="Recivió:" FontSize="10" FontAttributes="Bold" />
                                                <StackLayout>
                                                    <Label Text="{Binding FranchisePlayers.Count, StringFormat='{0} Jugadores'}" 
                                                        FontSize="10" 
                                                        IsVisible="{Binding FranchisePlayers.Count, Converter={StaticResource CountToBoolConverter}}" />
                                                    <Label Text="{Binding FranchisePicks.Count, StringFormat='{0} Picks'}" 
                                                        FontSize="10" 
                                                        IsVisible="{Binding FranchisePicks.Count, Converter={StaticResource CountToBoolConverter}}" />
                                                </StackLayout>
                                            </StackLayout>
                                        </StackLayout>

                                        <Label Text="Pulse para detalles" 
                                            FontSize="10" 
                                            TextColor="Blue"
                                            HorizontalOptions="End" />
                                    </StackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

            <StackLayout IsVisible="{Binding HasNoTrades}">
                <Border BackgroundColor="LightGray" Padding="30" Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                    <StackLayout HorizontalOptions="Center">
                        <Label Text="📈" 
                            FontSize="48" 
                            HorizontalOptions="Center" />
                        <Label Text="Sin Trueques encontrados" 
                            FontSize="18" 
                            FontAttributes="Bold"
                            HorizontalOptions="Center" />
                        <Label Text="Este equipo no ha realizado trueques aún." 
                            FontSize="14" 
                            HorizontalOptions="Center"
                            Margin="0,5,0,0" />
                        <Button Text="Haz tu primer trade" 
                            Command="{Binding GoToNewTradeCommand}"
                            BackgroundColor="Green"
                            TextColor="White"
                            Margin="0,15,0,0" />
                    </StackLayout>
                </Border>
            </StackLayout>

            <Label Text="{Binding ErrorMessage}" 
                TextColor="Red" 
                IsVisible="{Binding HasError}" />

            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                            IsVisible="{Binding IsLoading}" />

            <Button Text="Volver" 
                Command="{Binding GoBackCommand}"
                BackgroundColor="Transparent"
                TextColor="Blue" />

        </StackLayout>
    </ScrollView>

</ContentPage>