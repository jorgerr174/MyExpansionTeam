<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileApp.Views.Team.ReviewRoster"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.Models.Team"
             x:DataType="viewmodels:ReviewRosterViewModel"
             Title="Review Roster">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <!-- Header -->
            <Label Text="{Binding TeamName}" 
            FontSize="24" 
            FontAttributes="Bold" 
            HorizontalOptions="Center" />

            <Label Text="Review Roster - Phase 2" 
            FontSize="18" 
            HorizontalOptions="Center" />

            <!-- Salary Cap Summary -->
            <Border BackgroundColor="LightBlue" Padding="15" Stroke="Blue"  StrokeThickness="1" StrokeShape="RoundRectangle 10">
                <StackLayout>
                    <Label Text="{Binding SalaryCapText}" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="{Binding AvailableCapText}" FontSize="12" HorizontalOptions="Center" />
                    <Label Text="{Binding TotalPlayersCount, StringFormat='Total Players: {0}'}" FontSize="12" HorizontalOptions="Center" />
                </StackLayout>
            </Border>

            <!-- Action Buttons -->
            <StackLayout Orientation="Horizontal" Spacing="10">
                <Button Text="Add Players" Command="{Binding GoToBuildRosterCommand}" BackgroundColor="Green" TextColor="White" HorizontalOptions="Center" />
                <Button Text="Clear All" Command="{Binding ClearAllRosterCommand}" BackgroundColor="Red" TextColor="White" HorizontalOptions="Center" />
            </StackLayout>

            <StackLayout>
                <Label Text="Filter by Position:" FontAttributes="Bold" />

                <CollectionView ItemsSource="{Binding PositionFilters}" ItemsLayout="HorizontalList" HeightRequest="50">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FilterByPositionCommand}"
                            CommandParameter="{Binding}"
                            BackgroundColor="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectedPositionFilter, Converter={StaticResource SelectedFilterColorConverter}, ConverterParameter={Binding}}"
                            TextColor="White"
                            Margin="2" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

            <!-- Roster Players List -->
            <StackLayout>
                <Label Text="{Binding FilteredPlayers.Count, StringFormat='Showing {0} players'}" 
                FontSize="12" />

                <CollectionView ItemsSource="{Binding FilteredPlayers}"
                        HeightRequest="400">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="5" Margin="2">
                                <Border BackgroundColor="LightGreen" Padding="10" Stroke="Green" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                                    <Grid ColumnDefinitions="*,Auto">

                                        <StackLayout Grid.Column="0">
                                            <StackLayout Orientation="Horizontal">
                                                <Label Text="{Binding Name}" 
                                                FontAttributes="Bold" 
                                                VerticalOptions="Center" />
                                                <Label Text="{Binding Position}" 
                                                FontSize="12"
                                                VerticalOptions="Center"
                                                Margin="10,0,0,0"
                                                BackgroundColor="Blue"
                                                TextColor="White"
                                                Padding="5,2" />
                                            </StackLayout>

                                            <Label Text="{Binding APY, StringFormat='Salary: {0}'}" 
                                            FontSize="12" />
                                        </StackLayout>

                                        <Button Grid.Column="1"
                                        Text="Remove" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemovePlayerCommand}"
                                        CommandParameter="{Binding}"
                                        BackgroundColor="Red"
                                        TextColor="White"
                                        VerticalOptions="Center" />

                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

            <!-- Empty State -->
            <StackLayout IsVisible="{Binding FilteredPlayers.Count, Converter={StaticResource CountToInvertedBoolConverter}}">
                <Border BackgroundColor="LightGray" Padding="20" Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                    <StackLayout HorizontalOptions="Center">
                        <Label Text="No players in roster" 
                        FontSize="16" 
                        HorizontalOptions="Center" />
                        <Label Text="Tap 'Add Players' to start building your team" 
                        FontSize="12" 
                        HorizontalOptions="Center" />
                    </StackLayout>
                </Border>
            </StackLayout>

            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}" 
            TextColor="Red" 
            IsVisible="{Binding HasError}" />

            <!-- Save Button -->
            <Button Text="Save Roster" 
            Command="{Binding SaveRosterCommand}"
            IsEnabled="{Binding IsFormEnabled}"
            BackgroundColor="Blue"
            TextColor="White" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                        IsVisible="{Binding IsLoading}" />

            <!-- Go Back Button -->
            <Button Text="Go Back" 
            Command="{Binding GoBackCommand}"
            BackgroundColor="Transparent"
            TextColor="Blue" />

        </StackLayout>
    </ScrollView>

</ContentPage>