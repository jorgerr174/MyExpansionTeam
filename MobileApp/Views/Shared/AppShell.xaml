<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="MobileApp.Views.Shared.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:viewmodels="clr-namespace:MobileApp.Models.Shared"
       x:DataType="viewmodels:AppShellViewModel"
       xmlns:home="clr-namespace:MobileApp.Views.Home"
       xmlns:team="clr-namespace:MobileApp.Views.Team"
       xmlns:account="clr-namespace:MobileApp.Views.Account">

    <TabBar>
        <ShellContent Title="Home" 
                      Icon="home.png"
                      Route="Home"
                      ContentTemplate="{DataTemplate home:Index}" />

        <ShellContent Title="Teams" 
                      Icon="teams.png"
                      Route="List"
                      ContentTemplate="{DataTemplate team:List}" />

        <ShellContent Title="My Teams" 
                      Icon="myteams.png"
                      Route="MyTeams"
                      ContentTemplate="{DataTemplate team:MyTeams}" />

        <ShellContent Title="Profile" 
                      IsVisible="{Binding isLoggedIn}"
                      Icon="profile.png"
                      Route="Profile"
                      ContentTemplate="{DataTemplate account:Profile}" />
    </TabBar>
</Shell>