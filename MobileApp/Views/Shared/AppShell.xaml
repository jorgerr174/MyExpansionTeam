<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="MobileApp.Views.Shared.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:viewmodels="clr-namespace:MobileApp.Models.Shared"
       x:DataType="viewmodels:AppShellViewModel"
       xmlns:home="clr-namespace:MobileApp.Views.Home"
       xmlns:team="clr-namespace:MobileApp.Views.Team"
       xmlns:account="clr-namespace:MobileApp.Views.Account">

    <TabBar>
        <Tab Title="Inicio" Icon="home.png" Route="HomeTab">
            <ShellContent Route="HomeMain" ContentTemplate="{DataTemplate home:Index}" />
        </Tab>

        <Tab Title="Mis Equipos" Icon="myteams.png" Route="MyTeamsTab">
            <ShellContent Route="MyTeamsList" ContentTemplate="{DataTemplate team:MyTeams}" />
        </Tab>

        <Tab Title="Cuenta" Icon="profile.png" Route="ProfileTab">
            <ShellContent Route="ProfileMain" ContentTemplate="{DataTemplate account:ProfileTab}" />
        </Tab>
    </TabBar>
</Shell>