<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="MobileApp.Views.Shared.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:viewmodels="clr-namespace:MobileApp.Models.Shared"
       x:DataType="viewmodels:AppShellViewModel"
       xmlns:home="clr-namespace:MobileApp.Views.Home"
       xmlns:team="clr-namespace:MobileApp.Views.Team"
       xmlns:account="clr-namespace:MobileApp.Views.Account">

    <TabBar>
        <!-- Home Tab with its own navigation stack -->
        <Tab Title="Home" Icon="home.png" Route="HomeTab">
            <ShellContent Route="HomeMain" ContentTemplate="{DataTemplate home:Index}" />
        </Tab>

        <!-- Teams Tab with its own navigation stack -->
        <Tab Title="Teams" Icon="teams.png" Route="TeamsTab">
            <ShellContent Route="TeamsList" ContentTemplate="{DataTemplate team:List}" />
        </Tab>

        <!-- My Teams Tab with its own navigation stack -->
        <Tab Title="My Teams" Icon="myteams.png" Route="MyTeamsTab">
            <ShellContent Route="MyTeamsList" ContentTemplate="{DataTemplate team:MyTeams}" />
        </Tab>

        <!-- Profile Tab with its own navigation stack -->
        <Tab Title="Profile" Icon="profile.png" Route="ProfileTab" IsVisible="{Binding isLoggedIn}">
            <ShellContent Route="ProfileMain" ContentTemplate="{DataTemplate account:Profile}" />
        </Tab>
    </TabBar>
</Shell>