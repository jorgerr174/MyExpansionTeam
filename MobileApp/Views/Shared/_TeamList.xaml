<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="MobileApp.Views.Shared._TeamList"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <CollectionView ItemsSource="{Binding Teams}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid Padding="10" BackgroundColor="LightGray" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label
                           FontSize="18" 
                           FontAttributes="Bold" 
                           Grid.Row="0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Location}" />
                                <Span Text=" " />
                                <Span Text="{Binding Mascot}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <StackLayout Orientation="Horizontal" Grid.Row="2">
                        <Button Text="View Details" 
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.ViewTeamCommand}"
                            CommandParameter="{Binding Id}"
                            BackgroundColor="Blue"
                            TextColor="White" />
                    </StackLayout>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentView>