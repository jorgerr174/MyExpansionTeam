@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <!-- Header Card -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-shield-alt me-2"></i>Privacy Policy
                        </h4>
                        <span class="badge bg-light text-primary fs-6">Last Updated: January 2025</span>
                    </div>
                </div>
                <div class="card-body">
                    <p class="mb-0 text-muted">Our commitment to protecting your privacy and personal information</p>
                </div>
            </div>

            <!-- Information Collection Card -->
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-database me-2"></i>Information We Collect
                    </h5>
                </div>
                <div class="card-body">
                    <p>We collect information you provide directly to us, such as when you create an account, update your profile, or contact us for support.</p>

                    <h6 class="fw-bold mt-3 mb-2">Personal Information includes:</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Name and contact information</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Username and password</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Email address and phone number</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Team and fantasy football related data</li>
                    </ul>
                </div>
            </div>

            <!-- How We Use Information Card -->
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-cogs me-2"></i>How We Use Your Information
                    </h5>
                </div>
                <div class="card-body">
                    <p>We use the information we collect to provide, maintain, and improve our fantasy football management services.</p>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="card-title text-success">
                                        <i class="fas fa-user-cog me-1"></i>Account Management
                                    </h6>
                                    <p class="card-text small mb-0">Create and manage your user account and team profiles</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="card-title text-success">
                                        <i class="fas fa-envelope me-1"></i>Communication
                                    </h6>
                                    <p class="card-text small mb-0">Send you important updates and respond to your inquiries</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="card-title text-success">
                                        <i class="fas fa-chart-line me-1"></i>Service Improvement
                                    </h6>
                                    <p class="card-text small mb-0">Analyze usage patterns to enhance our platform</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="card-title text-success">
                                        <i class="fas fa-shield-alt me-1"></i>Security
                                    </h6>
                                    <p class="card-text small mb-0">Protect against fraud and maintain platform security</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Information Sharing Card -->
            <div class="card mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="fas fa-share-alt me-2"></i>Information Sharing
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>We do not sell, trade, or rent your personal information to third parties.</strong>
                    </div>

                    <p>We may share your information in the following limited circumstances:</p>
                    <ul>
                        <li class="mb-2">With your explicit consent</li>
                        <li class="mb-2">To comply with legal obligations</li>
                        <li class="mb-2">To protect our rights and the safety of our users</li>
                        <li class="mb-2">In connection with a business transfer or merger</li>
                    </ul>
                </div>
            </div>

            <!-- Data Security Card -->
            <div class="card mb-4">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-lock me-2"></i>Data Security
                    </h5>
                </div>
                <div class="card-body">
                    <p>We implement appropriate technical and organizational measures to protect your personal information against unauthorized access, alteration, disclosure, or destruction.</p>

                    <div class="row">
                        <div class="col-md-4 text-center mb-3">
                            <div class="p-3">
                                <i class="fas fa-key fa-3x text-danger mb-2"></i>
                                <h6 class="fw-bold">Encryption</h6>
                                <small class="text-muted">Data encrypted in transit and at rest</small>
                            </div>
                        </div>
                        <div class="col-md-4 text-center mb-3">
                            <div class="p-3">
                                <i class="fas fa-server fa-3x text-danger mb-2"></i>
                                <h6 class="fw-bold">Secure Servers</h6>
                                <small class="text-muted">Protected infrastructure and databases</small>
                            </div>
                        </div>
                        <div class="col-md-4 text-center mb-3">
                            <div class="p-3">
                                <i class="fas fa-user-shield fa-3x text-danger mb-2"></i>
                                <h6 class="fw-bold">Access Control</h6>
                                <small class="text-muted">Limited access on a need-to-know basis</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Your Rights Card -->
            <div class="card mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-user-check me-2"></i>Your Rights
                    </h5>
                </div>
                <div class="card-body">
                    <p>You have the right to access, update, or delete your personal information. You can exercise these rights through your account settings or by contacting us.</p>

                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-primary fs-6 p-2">
                            <i class="fas fa-eye me-1"></i>Access Your Data
                        </span>
                        <span class="badge bg-success fs-6 p-2">
                            <i class="fas fa-edit me-1"></i>Update Information
                        </span>
                        <span class="badge bg-warning text-dark fs-6 p-2">
                            <i class="fas fa-download me-1"></i>Export Data
                        </span>
                        <span class="badge bg-danger fs-6 p-2">
                            <i class="fas fa-trash me-1"></i>Delete Account
                        </span>
                    </div>
                </div>
            </div>

            <!-- Contact Information Card -->
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-envelope me-2"></i>Contact Us
                    </h5>
                </div>
                <div class="card-body">
                    <p>If you have any questions about this Privacy Policy or our privacy practices, please contact us:</p>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fas fa-envelope text-primary me-2"></i>
                                <span>privacy@fantasyteammanager.com</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fas fa-clock text-primary me-2"></i>
                                <span>Response within 48 hours</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Back Navigation -->
            <div class="card">
                <div class="card-body text-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        transition: transform 0.2s ease;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

    .badge {
        transition: all 0.2s ease;
    }

        .badge:hover {
            transform: scale(1.05);
        }

    .alert {
        border-left: 4px solid var(--bs-info);
    }

    .text-muted {
        font-size: 0.875rem;
    }

    .card-title {
        font-size: 1rem;
        margin-bottom: 0.5rem;
    }

    .list-unstyled li {
        padding-left: 0.5rem;
    }
</style>