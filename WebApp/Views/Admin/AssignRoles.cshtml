@model IList<METCore.DTOs.User.UserDto>
@using METCore.Enums

@{
    ViewData["Title"] = "Assign Roles";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Header Card -->
            <div class="card mb-4">
                <div class="card-header bg-warning text-dark">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-users-cog me-2"></i>Role Assignment
                        </h4>
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-dark btn-sm">
                            <i class="fas fa-arrow-left me-1"></i>Back to Admin
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <p class="mb-0 text-muted">Manage user roles and permissions across the system</p>
                </div>
            </div>

            <!-- Search and Filters Card -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-search me-2"></i>Search Users
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-8">
                            <label for="searchInput" class="form-label fw-bold">Search Users</label>
                            <input type="text" id="searchInput" class="form-control" placeholder="Search by username, name, email, or phone..." />
                        </div>
                        <div class="col-md-4">
                            <button type="button" id="searchBtn" class="btn btn-primary w-100">
                                <i class="fas fa-search me-1"></i>Search
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Results Controls Card -->
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0">Results</h6>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center">
                                <label for="pageSizeSelect" class="form-label me-2 mb-0 fw-bold">Show:</label>
                                <select id="pageSizeSelect" class="form-select w-auto">
                                    <option value="10">10</option>
                                    <option value="25" selected>25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                    <option value="250">250</option>
                                </select>
                                <span class="ms-2 text-muted">users per page</span>
                            </div>
                        </div>
                        <div class="col-md-6 text-end">
                            <span id="resultsInfo" class="text-muted fw-bold"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Users Table Card -->
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-table me-2"></i>User Management
                    </h5>
                </div>
                <div class="card-body">
                    <div id="loadingSpinner" class="text-center py-5" style="display: none;">
                        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3 text-muted">Loading users...</p>
                    </div>

                    <div class="table-responsive" id="tableContainer">
                        <table class="table table-striped table-hover" id="usersTable">
                            <thead class="table-dark">
                                <tr>
                                    <th scope="col">
                                        <i class="fas fa-user me-1"></i>Username
                                    </th>
                                    <th scope="col">
                                        <i class="fas fa-id-card me-1"></i>Name
                                    </th>
                                    <th scope="col">
                                        <i class="fas fa-envelope me-1"></i>Email
                                    </th>
                                    <th scope="col">
                                        <i class="fas fa-phone me-1"></i>Phone
                                    </th>
                                    <th scope="col">
                                        <i class="fas fa-user-tag me-1"></i>Current Role
                                    </th>
                                    <th scope="col">
                                        <i class="fas fa-cogs me-1"></i>Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody id="usersTableBody">
                                @Html.Partial("_UserRolesList", Model)
                            </tbody>
                        </table>

                        <div id="noResultsMessage" class="text-center py-5" style="display: none;">
                            <i class="fas fa-search fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No users found</h5>
                            <p class="text-muted">Try adjusting your search criteria</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pagination Card -->
            <div class="card" id="paginationCard" style="display: none;">
                <div class="card-body">
                    <nav aria-label="User pagination" id="paginationNav">
                        <ul class="pagination justify-content-center mb-0" id="paginationList">
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .user-row {
        transition: all 0.2s ease;
    }

        .user-row:hover {
            background-color: rgba(0,123,255,0.1) !important;
        }

    .role-select {
        min-width: 120px;
        transition: all 0.2s ease;
    }

        .role-select:focus {
            border-color: var(--bs-warning);
            box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.25);
        }

    .save-role-btn {
        animation: fadeIn 0.3s ease-in;
    }

    keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .table th {
        border-top: none;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .pagination .page-link {
        color: var(--bs-primary);
        border-color: var(--bs-gray-300);
    }

    .pagination .page-item.active .page-link {
        background-color: var(--bs-warning);
        border-color: var(--bs-warning);
        color: var(--bs-dark);
        font-weight: 600;
    }

    .pagination .page-link:hover {
        background-color: rgba(255, 193, 7, 0.1);
        border-color: var(--bs-warning);
    }

    .spinner-border {
        border-color: var(--bs-primary);
        border-right-color: transparent;
    }

    .card-header {
        border-bottom: 2px solid rgba(255,255,255,0.2);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        let currentPage = 1;
        let currentPageSize = 25;
        let totalUsers = 0;
        let totalPages = 0;
        let currentFilter = '';

        const pageSizeSelect = document.getElementById('pageSizeSelect');
        const resultsInfo = document.getElementById('resultsInfo');
        const paginationNav = document.getElementById('paginationNav');
        const paginationCard = document.getElementById('paginationCard');
        const paginationList = document.getElementById('paginationList');
        const searchInput = document.getElementById('searchInput');
        const searchBtn = document.getElementById('searchBtn');
        const usersTableBody = document.getElementById('usersTableBody');
        const loadingSpinner = document.getElementById('loadingSpinner');
        const tableContainer = document.getElementById('tableContainer');
        const noResultsMessage = document.getElementById('noResultsMessage');

        // Search functionality
        async function performSearch(page = 1, pageSize = null) {
            if (pageSize) currentPageSize = pageSize;
            currentPage = page;
            currentFilter = searchInput.value.trim();

            // Show loading
            showLoading();

            try {
                const response = await fetch('/Admin/UserList', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        Filter: currentFilter,
                        Page: currentPage,
                        PageSize: currentPageSize
                    })
                });

                if (!response.ok) throw new Error('Search failed');

                const result = await response.json();
                totalUsers = result.total;
                totalPages = Math.ceil(totalUsers / currentPageSize);
                updateUserTable(result.list);
                updatePagination();
                updateResultsInfo();
            } catch (error) {
                showError('Search failed. Please try again.');
            } finally {
                hideLoading();
            }
        }

        function showLoading() {
            loadingSpinner.style.display = 'block';
            tableContainer.style.display = 'none';
            searchBtn.disabled = true;
            searchBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Searching...';
        }

        function hideLoading() {
            loadingSpinner.style.display = 'none';
            tableContainer.style.display = 'block';
            searchBtn.disabled = false;
            searchBtn.innerHTML = '<i class="fas fa-search me-1"></i>Search';
        }

        function showError(message) {
            const alert = document.createElement('div');
            alert.className = 'alert alert-danger alert-dismissible fade show';
            alert.innerHTML = `
                <i class="fas fa-exclamation-triangle me-2"></i>${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.querySelector('.container-fluid').insertBefore(alert, document.querySelector('.card'));
        }

        // Update table with new user data
        function updateUserTable(users) {
            if (users.length === 0) {
                usersTableBody.innerHTML = '';
                noResultsMessage.style.display = 'block';
                return;
            }

            noResultsMessage.style.display = 'none';

            let html = '';
            users.forEach(user => {
                const isAdmin = user.role === 2;
                const isInactive = !user.active;

                html += `
                    <tr class="user-row">
                        <td class="${isInactive ? 'text-danger' : ''} fw-bold">
                            ${user.username}
                            ${isInactive ? '<i class="fas fa-exclamation-circle text-danger ms-1" title="Inactive User"></i>' : ''}
                        </td>
                        <td>${user.firstName} ${user.lastName}</td>
                        <td><a href="mailto:${user.email}" class="text-decoration-none">${user.email}</a></td>
                        <td>${user.tlf || '<span class="text-muted">Not provided</span>'}</td>
                        <td>
                            <select class="form-select form-select-sm role-select ${isAdmin ? 'border-danger' : ''}"
                                    ${isAdmin ? 'disabled' : ''}
                                    data-original-role="${user.role}"
                                    data-username="${user.username}">
                                <option value="0" ${user.role === 0 ? 'selected' : ''}>User</option>
                                <option value="1" ${user.role === 1 ? 'selected' : ''}>Manager</option>
                                <option value="2" ${user.role === 2 ? 'selected' : ''}>Admin</option>
                            </select>
                            ${isAdmin ? '<small class="text-danger d-block">Admin role protected</small>' : ''}
                        </td>
                        <td>
                            <button type="button"
                                    class="btn btn-success btn-sm save-role-btn"
                                    style="display: none;"
                                    data-username="${user.username}">
                                <i class="fas fa-save me-1"></i>Save Role
                            </button>
                        </td>
                    </tr>
                `;
            });

            usersTableBody.innerHTML = html;
            attachEventListeners();
        }

        // Attach event listeners to dynamically created elements
        function attachEventListeners() {
            // Role change detection
            document.querySelectorAll('.role-select').forEach(select => {
                select.addEventListener('change', function() {
                    const username = this.dataset.username;
                    const originalRole = parseInt(this.dataset.originalRole);
                    const newRole = parseInt(this.value);
                    const saveBtn = document.querySelector(`button[data-username="${username}"]`);

                    if (newRole !== originalRole) {
                        saveBtn.style.display = 'inline-block';
                    } else {
                        saveBtn.style.display = 'none';
                    }
                });
            });

            // Save role functionality
            document.querySelectorAll('.save-role-btn').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const username = this.dataset.username;
                    const roleSelect = document.querySelector(`select[data-username="${username}"]`);
                    const newRole = parseInt(roleSelect.value);
                    const originalRole = parseInt(roleSelect.dataset.originalRole);

                    // Disable button during request
                    this.disabled = true;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Saving...';

                    try {
                        const response = await fetch('/Admin/AssignRole', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                Username: username,
                                Role: newRole
                            })
                        });

                        const result = await response.json();

                        if (response.ok && (!result.message || result.message === "")) {
                            roleSelect.dataset.originalRole = newRole;
                            this.style.display = 'none';

                            // Show success message
                            const alert = document.createElement('div');
                            alert.className = 'alert alert-success alert-dismissible fade show';
                            alert.innerHTML = `
                                <i class="fas fa-check-circle me-2"></i>Role updated successfully for ${username}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            `;
                            document.querySelector('.container-fluid').insertBefore(alert, document.querySelector('.card'));

                            // Auto-dismiss after 3 seconds
                            setTimeout(() => {
                                alert.remove();
                            }, 3000);
                        } else {
                            throw new Error(result.message || 'Role change failed');
                        }
                    } catch (error) {
                        roleSelect.value = originalRole;
                        showError(`Failed to update role for ${username}: ${error.message}`);
                    } finally {
                        this.disabled = false;
                        this.innerHTML = '<i class="fas fa-save me-1"></i>Save Role';
                    }
                });
            });
        }

        function updatePagination() {
            if (totalPages <= 1) {
                paginationCard.style.display = 'none';
                return;
            }

            paginationCard.style.display = 'block';
            let html = '';

            // Previous button
            html += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                <a class="page-link" href="#" data-page="${currentPage - 1}">
                    <i class="fas fa-chevron-left me-1"></i>Previous
                </a>
            </li>`;

            // Page numbers with smart truncation
            const startPage = Math.max(1, currentPage - 2);
            const endPage = Math.min(totalPages, currentPage + 2);

            if (startPage > 1) {
                html += `<li class="page-item"><a class="page-link" href="#" data-page="1">1</a></li>`;
                if (startPage > 2) {
                    html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                }
            }

            for (let i = startPage; i <= endPage; i++) {
                html += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                    <a class="page-link" href="#" data-page="${i}">${i}</a>
                </li>`;
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                }
                html += `<li class="page-item"><a class="page-link" href="#" data-page="${totalPages}">${totalPages}</a></li>`;
            }

            // Next button
            html += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="#" data-page="${currentPage + 1}">
                    Next<i class="fas fa-chevron-right ms-1"></i>
                </a>
            </li>`;

            paginationList.innerHTML = html;

            // Attach pagination click events
            document.querySelectorAll('#paginationList .page-link').forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    const page = parseInt(this.dataset.page);
                    if (page && page !== currentPage) {
                        performSearch(page);
                    }
                });
            });
        }

        function updateResultsInfo() {
            const start = (currentPage - 1) * currentPageSize + 1;
            const end = Math.min(currentPage * currentPageSize, totalUsers);
            resultsInfo.textContent = `Showing ${start}-${end} of ${totalUsers} users`;
        }

        // Event listeners
        searchBtn.addEventListener('click', () => performSearch());

        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                performSearch();
            }
        });

        pageSizeSelect.addEventListener('change', function() {
            performSearch(1, parseInt(this.value));
        });

        // Initial load
        performSearch();
    });
</script>