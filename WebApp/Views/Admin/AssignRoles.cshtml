@model IList<METCore.DTOs.User.UserDto>
@using METCore.Enums

@{
    ViewData["Title"] = "Assign Roles";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h2>Role Assignment</h2>

            <!-- Search Section -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <input type="text" id="searchInput" class="form-control" placeholder="Search by username, name, email, or phone..." />
                        </div>
                        <div class="col-md-4">
                            <button type="button" id="searchBtn" class="btn btn-primary">Search</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pagination Controls -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center">
                                <label for="pageSizeSelect" class="form-label me-2 mb-0">Show:</label>
                                <select id="pageSizeSelect" class="form-select w-auto">
                                    <option value="10">10</option>
                                    <option value="25" selected>25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                    <option value="250">250</option>
                                </select>
                                <span class="ms-2">users per page</span>
                            </div>
                        </div>
                        <div class="col-md-6 text-end">
                            <span id="resultsInfo" class="text-muted"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Users Table -->
            <div class="card">
                <div class="card-body">
                    <div id="loadingSpinner" class="text-center" style="display: none;">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    <div class="table-responsive" id="tableContainer">
                        <table class="table table-striped" id="usersTable">
                            <thead>
                                <tr>
                                    <th>Username</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Current Role</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="usersTableBody">
                                @Html.Partial("_UserRolesList", Model)
                            </tbody>
                        </table>
                        <div id="noResultsMessage" style="display: none;">
                            <p class="text-center text-muted">No users found.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pagination Navigation -->
            <nav aria-label="User pagination" id="paginationNav" style="display: none;">
                <ul class="pagination justify-content-center" id="paginationList">
                </ul>
            </nav>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        let currentPage = 1;
        let currentPageSize = 25;
        let totalUsers = 0;
        let totalPages = 0;
        let currentFilter = '';

        const pageSizeSelect = document.getElementById('pageSizeSelect');
        const resultsInfo = document.getElementById('resultsInfo');
        const paginationNav = document.getElementById('paginationNav');
        const paginationList = document.getElementById('paginationList');
        const searchInput = document.getElementById('searchInput');
        const searchBtn = document.getElementById('searchBtn');
        const usersTableBody = document.getElementById('usersTableBody');
        const loadingSpinner = document.getElementById('loadingSpinner');
        const tableContainer = document.getElementById('tableContainer');
        const noResultsMessage = document.getElementById('noResultsMessage');

        // Search functionality
        async function performSearch(page = 1, pageSize = null) {
            if (pageSize) currentPageSize = pageSize;
            currentPage = page;
            currentFilter = searchInput.value.trim();

            // Show loading
            loadingSpinner.style.display = 'block';
            tableContainer.style.display = 'none';
            searchBtn.disabled = true;
            searchBtn.textContent = 'Searching...';

            try {
                fetch('/Admin/UserList', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        Filter: currentFilter,
                        Page: currentPage,
                        PageSize: currentPageSize
                    })
                })
                .then(response => response.json())
                .then(result => {
                    totalUsers = result.total;
                    totalPages = Math.ceil(totalUsers / currentPageSize);
                    updateUserTable(result.list);
                    updatePagination();
                    updateResultsInfo();
                })            
                .catch(error => {
                    alert('Search failed. Please try again.');
                });
            } catch (error) {
                alert('Search failed. Please try again.');
            } finally {
                // Hide loading
                loadingSpinner.style.display = 'none';
                tableContainer.style.display = 'block';
                searchBtn.disabled = false;
                searchBtn.textContent = 'Search';
            }
        }

        // Update table with new user data
        function updateUserTable(users) {
            if (users.length === 0) {
                usersTableBody.innerHTML = '';
                noResultsMessage.style.display = 'block';
                return;
            }

            noResultsMessage.style.display = 'none';

            let html = '';
            users.forEach(user => {
                const isAdmin = user.Role === 2; // Assuming Admin enum value is 2

                html += `
                    <tr class="user-row">
                        <td class="${!user.active ? 'text-danger' : ''}">${user.username}</td>
                        <td>${user.firstName} ${user.lastName}</td>
                        <td>${user.email}</td>
                        <td>${user.tlf || ''}</td>
                        <td>
                            <select class="form-select role-select" ${isAdmin ? 'disabled' : ''} data-original-role="${user.role}" data-username="${user.username}">
                                <option value="0" ${user.role === 0 ? 'selected' : ''}>User</option>
                                <option value="1" ${user.role === 1 ? 'selected' : ''}>Manager</option>
                                <option value="2" ${user.role === 2 ? 'selected' : ''}>Admin</option>
                            </select>
                        </td>
                        <td>
                            <button type="button" class="btn btn-success btn-sm save-role-btn" style="display: none;" data-username="${user.username}">
                                Save New Role
                            </button>
                        </td>
                    </tr>
                `;
            });

            usersTableBody.innerHTML = html;
            attachEventListeners();
        }

        // Attach event listeners to dynamically created elements
        function attachEventListeners() {
            // Role change detection
            document.querySelectorAll('.role-select').forEach(select => {
                select.addEventListener('change', function() {
                    const username = this.dataset.username;
                    const originalRole = parseInt(this.dataset.originalRole);
                    const newRole = parseInt(this.value);
                    const saveBtn = document.querySelector(`button[data-username="${username}"]`);

                    if (newRole !== originalRole) {
                        saveBtn.style.display = 'inline-block';
                    } else {
                        saveBtn.style.display = 'none';
                    }
                });
            });

            // Save role functionality
            document.querySelectorAll('.save-role-btn').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const username = this.dataset.username;
                    const roleSelect = document.querySelector(`select[data-username="${username}"]`);
                    const newRole = parseInt(roleSelect.value);
                    const originalRole = parseInt(roleSelect.dataset.originalRole);

                    // Disable button during request
                    this.disabled = true;
                    this.textContent = 'Saving...';

                    try {
                        fetch('/Admin/AssignRole', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                Username: username,
                                Role: newRole
                            })
                        })
                        .then(response => response.json())
                        .then(result => {
                            if (!result.message || result.message == "") {
                                roleSelect.dataset.originalRole = newRole;
                                this.style.display = 'none';
                            } else {
                                roleSelect.value = originalRole;
                                alert('Role change not successful');
                            }
                        })
                        .catch(error => {
                            alert('Search failed. Please try again.');
                        });

                    } catch (error) {
                        // Network error - revert role and show alert
                        roleSelect.value = originalRole;
                        alert('Role change not successful');
                    } finally {
                        // Re-enable button
                        this.disabled = false;
                        this.textContent = 'Save New Role';
                    }
                });
            });
        }

        function updatePagination() {
            if (totalPages <= 1) {
                paginationNav.style.display = 'none';
                return;
            }

            paginationNav.style.display = 'block';
            let html = '';

            // Previous button
            html += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                <a class="page-link" href="#" data-page="${currentPage - 1}">Previous</a>
            </li>`;

            // Page numbers
            const startPage = Math.max(1, currentPage - 2);
            const endPage = Math.min(totalPages, currentPage + 2);

            if (startPage > 1) {
                html += `<li class="page-item"><a class="page-link" href="#" data-page="1">1</a></li>`;
                if (startPage > 2) {
                    html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                }
            }

            for (let i = startPage; i <= endPage; i++) {
                html += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                    <a class="page-link" href="#" data-page="${i}">${i}</a>
                </li>`;
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                }
                html += `<li class="page-item"><a class="page-link" href="#" data-page="${totalPages}">${totalPages}</a></li>`;
            }

            // Next button
            html += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="#" data-page="${currentPage + 1}">Next</a>
            </li>`;

            paginationList.innerHTML = html;
        }

        function updateResultsInfo() {
            if (totalUsers === 0) {
                resultsInfo.textContent = 'No users found';
                return;
            }

            const startIndex = (currentPage - 1) * currentPageSize + 1;
            const endIndex = Math.min(currentPage * currentPageSize, totalUsers);
            resultsInfo.textContent = `Showing ${startIndex}-${endIndex} of ${totalUsers} users`;
        }

        // Page size change
        pageSizeSelect.addEventListener('change', function() {
            performSearch(1, parseInt(this.value));
        });

        // Pagination click
        paginationList.addEventListener('click', function(e) {
            e.preventDefault();
            if (e.target.classList.contains('page-link') && e.target.dataset.page) {
                const page = parseInt(e.target.dataset.page);
                if (page !== currentPage && page >= 1 && page <= totalPages) {
                    performSearch(page);
                }
            }
        });

        // Event listeners for search
        searchBtn.addEventListener('click', () => performSearch(1));
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                performSearch();
            }
        });

        // Initialize event listeners for initial load
        attachEventListeners();


        // Load initial data
        performSearch(1);
    });
</script>