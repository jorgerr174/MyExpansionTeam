@{
    ViewData["Title"] = "Admin Control Center";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card mt-4">
                <div class="card-header bg-danger text-white d-flex justify-content-center align-items-center">
                    <h4 class="mb-0">
                        <i class="fas fa-shield-alt me-2"></i>Centro de Control del Administrador
                    </h4>
                </div>

                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="card h-100 admin-action-card">
                                <div class="card-body text-center d-flex flex-column">
                                    <div class="mb-3">
                                        <i class="fas fa-users-cog fa-3x text-warning"></i>
                                    </div>
                                    <p class="card-text flex-grow-1">Administra roles de usuario y administrador para usuarios del sistema.</p>
                                    <a asp-action="AssignRoles" class="btn btn-warning btn-lg mt-auto">
                                        <i class="fas fa-user-tag me-2"></i>Asignar Roles
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card h-100 admin-action-card">
                                <div class="card-body text-center d-flex flex-column">
                                    <div class="mb-3">
                                        <i class="fas fa-file-import fa-3x text-info"></i>
                                    </div>
                                    <p class="card-text flex-grow-1">Importa información de jugadores, estadíticas, contratos o prospectos.</p>
                                    <a asp-action="Import" class="btn btn-info btn-lg mt-auto">
                                        <i class="fas fa-upload me-2"></i>Importar Datos
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light text-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Volver
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Font Awesome Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
    .admin-action-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 1px solid #dee2e6;
    }

        .admin-action-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.15);
        }

        .admin-action-card .card-body {
            padding: 2rem;
        }

        .admin-action-card i {
            transition: transform 0.2s ease;
        }

        .admin-action-card:hover i {
            transform: scale(1.1);
        }
</style>