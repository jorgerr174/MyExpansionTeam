@using METCore.DTOs.Shared
@using METCore.DTOs.Team
@model IEnumerable<TeamInfoDto>

@{
    bool myTeams = ViewData["myTeams"] as bool? ?? false;
}

<div class="container-fluid mt-4">
    @if (Model is not null && Model.Count() > 0)
    {
		<div class="row g-3 pb-3">
            @foreach (TeamInfoDto team in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 team-card">
                        <div class="card-header @(myTeams ? "bg-primary" : "bg-info") text-white d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0 fw-bold">@team.Location @team.Mascot</h6>
                                <small class="opacity-75">@team.Abb</small>
                            </div>
                            <div class="text-end">
                                <i class="fas fa-football-ball fa-lg"></i>
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="row mb-2">
                                <div class="col-4">
                                    <small class="text-muted fw-bold">Created:</small>
                                </div>
                                <div class="col-8">
                                    <small>@team.Date.ToString("dd/MM/yyyy")</small>
                                </div>
                            </div>

                            @if (!myTeams)
                            {
                                <div class="row mb-2">
                                    <div class="col-4">
                                        <small class="text-muted fw-bold">Owner:</small>
                                    </div>
                                    <div class="col-8">
                                        <small>
                                            <a href="@Url.RouteUrl("UserDetails", new { username = team.UserUsername })"
                                               class="text-decoration-none">
                                                @team.UserUsername
                                            </a>
                                        </small>
                                    </div>
                                </div>
                            }

                            <div class="row mb-3">
                                <div class="col-4">
                                    <small class="text-muted fw-bold">Status:</small>
                                </div>
                                <div class="col-8">
                                    <span class="badge @(team.Complete ? "bg-success" : "bg-warning")">
                                        @(team.Complete ? "Complete" : "In Progress")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-light">
                            <div class="d-grid gap-2">
                                <a href="@Url.RouteUrl("TeamDetails", new { Id = team.Id })"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-eye me-2"></i>View Details
                                </a>
                                @if (myTeams)
                                {
                                    <a href="@Url.RouteUrl("EditTeam", new { Id = team.Id })"
                                       class="btn btn-outline-secondary btn-sm">
                                        <i class="fas fa-edit me-2"></i>Edit Team
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="fas fa-football-ball fa-3x text-muted"></i>
            </div>
            <h5 class="text-muted">No teams found</h5>
            <p class="text-muted">@(myTeams ? "You haven't created any teams yet." : "No teams are available.")</p>
        </div>
    }
</div>

<!-- Font Awesome Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
    .team-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 1px solid #dee2e6;
    }

        .team-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.15);
        }
</style>