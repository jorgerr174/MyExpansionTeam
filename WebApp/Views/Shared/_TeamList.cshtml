@using METCore.DTOs.Shared
@using METCore.DTOs.Team
@model IEnumerable<TeamInfoDto>

@{
    bool myTeams = ViewData["myTeams"] as bool? ?? false; // Default to true if missing
}

<div>
    <br />
    <hr />
    <div class="container">
        @if (Model is not null && Model.Count() > 0)
        {
        @if (myTeams)
        {
            <div class="row">
                <div class="col-auto">Team</div>
                <div class="col-3">Date</div>
                <div class="col-2">Información</div>
                <div class="col-2">Edición</div>
            </div>
            @foreach (TeamInfoDto team in Model)
            {
            <div class="row">
				<div class="col-auto">@team.Location @team.Mascot (@team.Abb)</div>
                <div class="col-3">@team.Date.ToString("dd/MM/yyyy")</div>
                <div class="col-2"><a href="@Url.RouteUrl("TeamDetails", new { Id = team.Id })">Detalles</a></div>
                <div class="col-2"><a href="@Url.RouteUrl("EditTeam", new { Id = team.Id })">Editar</a></div>
            </div>
	        }
        }
        else
        {
            <div class="row">
                <div class="col-3">Date</div>
                <div class="col-2">Abb</div>
                <div class="col-3">User</div>
                <div class="col-auto"></div>
            </div>
            @foreach (TeamInfoDto team in Model)
            {
            <div class="row">
                <div class="col-3">@team.Date.ToString("dd/MM/yyyy")</div>
                <div class="col-2">@team.Abb</div>
                <div class="col-3"><a href="@Url.RouteUrl("UserDetails", new { username = team.UserUsername })">@team.UserUsername</a></div>
                <div class="col-auto"><a href="@Url.RouteUrl("TeamDetails", new { Id = team.Id })">@team.Location @team.Mascot</a></div>
            </div>
            }
        }
        }
    </div>
    
    <br />
    <dl class="row">
        <dt class="col-12">
            @if (myTeams) {
                <a class="btn btn-primary" asp-action="Create" asp-controller="Team">Nuevo equipo</a>
                <a class="btn btn-primary" asp-action="Index" asp-controller="Home">Volver</a>
            } else {
                <a class="btn btn-primary" asp-action="MyTeams" asp-controller="Team">Mis equipos</a>
            }
		</dt>
    </dl>

</div>