        // ===== TAB 5: DRAFT RESULTS FUNCTIONS =====
        // Functions for loading and displaying draft results

        // Load draft results data via AJAX when tab is first activated
        function loadDraftResults() {
            const draftDisplay = document.getElementById('draftResultsDisplay');
            
            fetch(`/Team/GetTeamDraft/${teamId}`, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(draftData => {
                // draftData contains { prospects: [], selections: [] }
                const prospects = draftData.prospects || [];
                const selections = draftData.selections || [];
                
                displayDraftResults(prospects, selections);
                updateDraftPicksCount(prospects.length);
            })
            .catch(error => {
                console.error('Error loading draft results:', error);
                draftDisplay.innerHTML = `
                    <div class="text-center text-muted p-5">
                        <i class="fas fa-exclamation-triangle fa-2x mb-3 text-warning"></i>
                        <p>Error loading draft results. Please try again.</p>
                    </div>
                `;
            });
        }

        // Display draft results with prospect cards showing pick details
        function displayDraftResults(prospects, selections) {
            const draftDisplay = document.getElementById('draftResultsDisplay');
            
            if (!prospects || prospects.length === 0) {
                draftDisplay.innerHTML = `
                    <div class="text-center text-muted p-5">
                        <i class="fas fa-trophy fa-2x mb-3"></i>
                        <p>No draft completed yet.</p>
                        <p><small class="text-muted">Complete the roster building process and proceed to the draft.</small></p>
                    </div>
                `;
                return;
            }

            // Create a map of player ID to pick number from selections
            const pickMap = {};
            if (selections && selections.length > 0) {
                selections.forEach(selection => {
                    if (selection.playerId && selection.pick) {
                        pickMap[selection.playerId] = selection.pick;
                    }
                });
            }

            let draftHtml = '<div class="row">';
            prospects.forEach((prospect, index) => {
                // Get the actual pick number from selections, or use index + 1 as fallback
                const draftPick = pickMap[prospect.id] || (index + 1);
                const round = Math.ceil(draftPick / 32);
                
                draftHtml += `
                    <div class="col-md-4 mb-3">
                        <div class="card border-success">
                            <div class="card-header bg-success text-white">
                                <h6 class="mb-0">Pick #${draftPick}</h6>
                                <small>Round ${round}</small>
                            </div>
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">${prospect.name || prospect.player || 'Unknown Player'}</h6>
                                        <small class="text-muted">${prospect.position || 'N/A'} - ${prospect.college || 'N/A'}</small>
                                    </div>
                                </div>
                                <div class="row text-center">
                                    <div class="col-4">
                                        <small class="text-muted">Height</small>
                                        <div>${prospect.height || 0}"</div>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted">Weight</small>
                                        <div>${prospect.weight || 0} lbs</div>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted">Consensus</small>
                                        <div>#${prospect.consensus || 'N/A'}</div>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar bg-info" style="width: ${(prospect.athScore || 0)}%"></div>
                                    </div>
                                    <small class="text-muted">Athletic Score: ${prospect.athScore || 0}</small>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
            draftHtml += '</div>';
            
            draftDisplay.innerHTML = draftHtml;
        }

        // Update the draft picks count badge in navigation
        function updateDraftPicksCount(count) {
            document.getElementById('draft-picks-count').textContent = count;
        }

        // ===== TAB EVENT HANDLERS =====
        // Event handlers for tab navigation and lazy loading

        // Load trades when trades tab is first clicked
        document.getElementById('trades-tab').addEventListener('click', function() {
            if (!tradesLoaded) {
                loadTradeHistory();
                tradesLoaded = true;
            }
        });
        
        // Load draft results when draft results tab is first clicked
        document.getElementById('draft-results-tab').addEventListener('click', function() {
            if (!draftResultsLoaded) {
                loadDraftResults();
                draftResultsLoaded = true;
            }
        });

        // Refresh roster display when review tab is clicked
        document.getElementById('review-tab').addEventListener('click', function() {
            refreshRosterDisplay();
        });

        // Initialize formation display when formation tab is clicked
        document.getElementById('formation-tab').addEventListener('click', function() {
            initializeFormationDisplay();
        });

        // Handle new trade offer button clicks
        document.getElementById('newTradeOffer').addEventListener('click', function() {
            openTradeModal();
        });
        
        document.getElementById('newTradeOfferDraft').addEventListener('click', function() {
            openTradeModal();
        });

        // ===== FORM SUBMISSION AND VALIDATION =====
        // Handle form submission and final validation

        // Validate roster before form submission
        document.getElementById('teamRosterForm').addEventListener('submit', function(e) {
            if (rosterPlayersArray.length === 0) {
                e.preventDefault();
                alert('Please select at least one player before saving.');
                return false;
            }

            // Update hidden fields one final time
            updateRosterPlayersHiddenFields();
            updateStartersHiddenFields();
            updateSalaryCapDisplay();
        });

        // ===== INITIALIZATION =====
        // Main initialization function and application startup

        // Initialize the complete roster interface
        function initialize() {
            initializeRosterPlayers();
            populateFranchisesList();
            updateSalaryCapDisplay();
            
            // Auto-select first franchise if none selected
            if (!currentFranchiseId) {
                selectFranchise(1);
            }
        }

        // Start the application
        initialize();
    });
</script>

