        // NEW: Load trade history function
        function loadTradeHistory() {
            const tradesDisplay = document.getElementById('tradesDisplay');
            
            fetch(`/Team/GetTeamTrades/${teamId}`, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => {
                if (!response.ok) {
                    // If endpoint doesn't exist (404), show empty state
                    if (response.status === 404) {
                        throw new Error('ENDPOINT_NOT_IMPLEMENTED');
                    }
                    throw new Error('API_ERROR');
                }
                return response.json();
            })
            .then(trades => {
                displayTrades(trades);
                updateTradesCount(trades.length);
            })
            .catch(error => {
                console.error('Error loading trades:', error);
                if (error.message === 'ENDPOINT_NOT_IMPLEMENTED') {
                    // Show that feature is not implemented yet
                    tradesDisplay.innerHTML = `
                        <div class="text-center text-muted p-5">
                            <i class="fas fa-exchange-alt fa-2x mb-3"></i>
                            <p>No trades completed yet.</p>
                            <p><small class="text-muted">Use the "New Trade Offer" button to propose your first trade.</small></p>
                        </div>
                    `;
                } else {
                    tradesDisplay.innerHTML = `
                        <div class="text-center text-muted p-5">
                            <i class="fas fa-exclamation-triangle fa-2x mb-3 text-warning"></i>
                            <p>Error loading trade history. Please try again.</p>
                        </div>
                    `;
                }
            });
        }

        // NEW: Load draft results function
        function loadDraftResults() {
            const draftDisplay = document.getElementById('draftResultsDisplay');
            
            fetch(`/Team/GetTeamDraft/${teamId}`, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(draftData => {
                // draftData contains { prospects: [], selections: [] }
                const prospects = draftData.prospects || [];
                const selections = draftData.selections || [];
                
                displayDraftResults(prospects, selections);
                updateDraftPicksCount(prospects.length);
            })
            .catch(error => {
                console.error('Error loading draft results:', error);
                draftDisplay.innerHTML = `
                    <div class="text-center text-muted p-5">
                        <i class="fas fa-exclamation-triangle fa-2x mb-3 text-warning"></i>
                        <p>Error loading draft results. Please try again.</p>
                    </div>
                `;
            });
        }

        // NEW: Display trades function
        function displayTrades(trades) {
            const tradesDisplay = document.getElementById('tradesDisplay');
            
            if (!trades || trades.length === 0) {
                tradesDisplay.innerHTML = `
                    <div class="text-center text-muted p-5">
                        <i class="fas fa-exchange-alt fa-2x mb-3"></i>
                        <p>No trades completed yet.</p>
                        <p><small class="text-muted">Use the "New Trade Offer" button to propose your first trade.</small></p>
                    </div>
                `;
                return;
            }

            let tradesHtml = '<div class="row">';
            trades.forEach((trade, index) => {
                tradesHtml += `
                    <div class="col-md-6 mb-3">
                        <div class="card border-info">
                            <div class="card-header bg-info text-white">
                                <h6 class="mb-0">Trade #${index + 1}</h6>
                                <small>Date: ${new Date(trade.date).toLocaleDateString()}</small>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-6">
                                        <h6 class="text-success">Received:</h6>
                                        <ul class="list-unstyled small">
                                            ${trade.teamPlayers ? trade.teamPlayers.map(p => `<li><i class="fas fa-user me-1"></i>${p.name}</li>`).join('') : ''}
                                            ${trade.teamPicks ? trade.teamPicks.map(p => `<li><i class="fas fa-trophy me-1"></i>Pick ${p}</li>`).join('') : ''}
                                        </ul>
                                    </div>
                                    <div class="col-6">
                                        <h6 class="text-danger">Traded Away:</h6>
                                        <ul class="list-unstyled small">
                                            ${trade.franchisePlayers ? trade.franchisePlayers.map(p => `<li><i class="fas fa-user me-1"></i>${p.name}</li>`).join('') : ''}
                                            ${trade.franchisePicks ? trade.franchisePicks.map(p => `<li><i class="fas fa-trophy me-1"></i>Pick ${p}</li>`).join('') : ''}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
            tradesHtml += '</div>';
            
            tradesDisplay.innerHTML = tradesHtml;
        }

        // NEW: Display draft results function
        function displayDraftResults(prospects, selections) {
            const draftDisplay = document.getElementById('draftResultsDisplay');
            
            if (!prospects || prospects.length === 0) {
                draftDisplay.innerHTML = `
                    <div class="text-center text-muted p-5">
                        <i class="fas fa-trophy fa-2x mb-3"></i>
                        <p>No draft completed yet.</p>
                        <p><small class="text-muted">Complete the roster building process and proceed to the draft.</small></p>
                    </div>
                `;
                return;
            }

            // Create a map of player ID to pick number from selections
            const pickMap = {};
            if (selections && selections.length > 0) {
                selections.forEach(selection => {
                    if (selection.playerId && selection.pick) {
                        pickMap[selection.playerId] = selection.pick;
                    }
                });
            }

            let draftHtml = '<div class="row">';
            prospects.forEach((prospect, index) => {
                // Get the actual pick number from selections, or use index + 1 as fallback
                const draftPick = pickMap[prospect.id] || (index + 1);
                const round = Math.ceil(draftPick / 32);
                
                draftHtml += `
                    <div class="col-md-4 mb-3">
                        <div class="card border-success">
                            <div class="card-header bg-success text-white">
                                <h6 class="mb-0">Pick #${draftPick}</h6>
                                <small>Round ${round}</small>
                            </div>
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">${prospect.name || prospect.player || 'Unknown Player'}</h6>
                                        <small class="text-muted">${prospect.position || 'N/A'} - ${prospect.college || 'N/A'}</small>
                                    </div>
                                </div>
                                <div class="row text-center">
                                    <div class="col-4">
                                        <small class="text-muted">Height</small>
                                        <div>${prospect.height || 0}"</div>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted">Weight</small>
                                        <div>${prospect.weight || 0} lbs</div>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted">Consensus</small>
                                        <div>#${prospect.consensus || 'N/A'}</div>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar bg-info" style="width: ${(prospect.athScore || 0)}%"></div>
                                    </div>
                                    <small class="text-muted">Athletic Score: ${prospect.athScore || 0}</small>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
            draftHtml += '</div>';
            
            draftDisplay.innerHTML = draftHtml;
        }

        // NEW: Update badge counts
        function updateTradesCount(count) {
            document.getElementById('trades-count').textContent = count;
        }

        function updateDraftPicksCount(count) {
            document.getElementById('draft-picks-count').textContent = count;
        }

        // NEW: Open trade modal function
