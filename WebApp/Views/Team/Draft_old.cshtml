@model METCore.DTOs.Team.DraftDto

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h2>NFL Draft Configuration - @Model.Location @Model.Mascot</h2>

            <!-- Phase Navigation -->
            <ul class="nav nav-pills mb-4" id="phaseNavigation" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="settings-tab" data-bs-toggle="pill" data-bs-target="#settings-phase" type="button" role="tab">
                        <i class="fas fa-cog me-2"></i>Draft Settings
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link disabled" id="draft-tab" data-bs-toggle="pill" data-bs-target="#draft-phase" type="button" role="tab" disabled>
                        <i class="fas fa-trophy me-2"></i>Draft Simulation
                        <span class="badge bg-secondary ms-2" id="current-pick">Pick 1</span>
                    </button>
                </li>
            </ul>

            <form asp-action="SaveDraft" method="post" id="draftForm">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.Location)
                @Html.HiddenFor(m => m.Mascot)
                @Html.HiddenFor(m => m.Abb)
                @Html.HiddenFor(m => m.UserUsername)
                @Html.HiddenFor(m => m.Date)
                @Html.HiddenFor(m => m.Complete)

                <!-- Hidden field for selected franchises to control -->
                <input type="hidden" id="selectedFranchises" name="SelectedFranchises" value="" />
                
                <!-- Hidden field for team's draft picks only -->
                <input type="hidden" id="draftPicks" name="Draft" value="@Model.Draft" />

                <div class="tab-content">
                    <!-- Phase 1: Draft Settings Configuration -->
                    <div class="tab-pane fade show active" id="settings-phase" role="tabpanel">
                        <div class="card">
                            <div class="card-header">
                                <h4>Configure Draft Participation</h4>
                                <p class="text-muted mb-0">Set up how you want to participate in the NFL draft</p>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group mb-3">
                                            @Html.LabelFor(m => m.Rounds, "Manual Rounds", new { @class = "form-label" })
                                            @Html.TextBoxFor(m => m.Rounds, new { @class = "form-control", @type = "number", @min = "0", @max = "7" })
                                            @Html.ValidationMessageFor(m => m.Rounds, "", new { @class = "text-danger" })
                                            <div class="form-text">Rounds you want to control manually (0 = full simulation, 7 = control all)</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group mb-3">
                                            @Html.LabelFor(m => m.Speed, "Simulation Speed", new { @class = "form-label" })
                                            @Html.DropDownListFor(m => m.Speed, new SelectList(new[] {
                                            new { Value = "instant", Text = "Instant" },
                                            new { Value = "fast", Text = "Fast (0.5s per pick)" },
                                            new { Value = "normal", Text = "Normal (1s per pick)" },
                                            new { Value = "slow", Text = "Slow (2s per pick)" }
                                            }, "Value", "Text"), new { @class = "form-select"})
                                            @Html.ValidationMessageFor(m => m.Speed, "", new { @class = "text-danger" })
                                            <div class="form-text">Speed of automated picks during simulation</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Draft Control Method Selection -->
                                <div class="card bg-light mb-4">
                                    <div class="card-body">
                                        <h6>Draft Participation Method</h6>
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="radio" name="draftMethod" id="fullSimulation" value="full" checked>
                                            <label class="form-check-label" for="fullSimulation">
                                                <strong>Full Simulation</strong>
                                                <div class="form-text">Simulate the entire draft automatically (quickest option)</div>
                                            </label>
                                        </div>
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="radio" name="draftMethod" id="myTeamOnly" value="myteam">
                                            <label class="form-check-label" for="myTeamOnly">
                                                <strong>Control My Team Only</strong>
                                                <div class="form-text">Make manual selections for your expansion team only</div>
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="draftMethod" id="multipleTeams" value="multiple">
                                            <label class="form-check-label" for="multipleTeams">
                                                <strong>Control Multiple Teams</strong>
                                                <div class="form-text">Select teams during the draft to control manually</div>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Team Selection for Multiple Teams -->
                                <div class="card bg-light mb-4" id="teamSelectionCard" style="display: none;">
                                    <div class="card-body">
                                        <h6>Select Teams to Control</h6>
                                        <div class="row" id="franchiseSelection">
                                            <!-- Franchise checkboxes will be populated here -->
                                        </div>
                                    </div>
                                </div>

                                <!-- Trading Options -->
                                <div class="card bg-light mb-4">
                                    <div class="card-body">
                                        <h6>Trading Options</h6>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="enableTrading" name="EnableTrading" value="true" checked>
                                            <label class="form-check-label" for="enableTrading">
                                                <strong>Enable Trading</strong>
                                                <div class="form-text">Allow proposing trades during the draft simulation</div>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Draft Impact Preview -->
                                <div class="alert alert-info" id="draftPreview">
                                    <h6><i class="fas fa-info-circle me-2"></i>Draft Configuration Preview</h6>
                                    <div id="draftSummary">
                                        <div><strong>Total Rounds:</strong> 7 rounds</div>
                                        <div><strong>Manual Control:</strong> <span id="manualDescription">Full simulation</span></div>
                                        <div><strong>Your Team Picks:</strong> <span id="yourTeamPicks">7 picks (rounds 1-7)</span></div>
                                        <div><strong>Trading:</strong> <span id="tradingStatus">Enabled</span></div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end mt-4">
                                    <button type="button" class="btn btn-primary" id="startDraftButton">
                                        <i class="fas fa-play me-2"></i>Start Draft Simulation
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Phase 2: Draft Simulation -->
                    <div class="tab-pane fade" id="draft-phase" role="tabpanel">
                        <div class="row">
                            <!-- Draft Board Sidebar -->
                            <div class="col-md-3">
                                <div class="card sticky-top" style="top: 20px;">
                                    <div class="card-header">
                                        <h5>Draft Board</h5>
                                        <div class="progress mt-2" style="height: 6px;">
                                            <div class="progress-bar" id="draftProgress" style="width: 0%"></div>
                                        </div>
                                        <small class="text-muted">
                                            Round <span id="currentRound">1</span> - Pick <span id="currentPickNumber">1</span> of 259
                                        </small>
                                    </div>
                                    <div class="card-body p-0" style="max-height: 600px; overflow-y: auto;">
                                        <div id="draftOrder">
                                            <!-- Draft order will be populated here -->
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Main Draft Area -->
                            <div class="col-md-9">
                                <!-- Current Pick Card -->
                                <div class="card mb-3" id="currentPickCard">
                                    <div class="card-header bg-primary text-white">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h5 class="mb-0">On The Clock</h5>
                                                <span id="onTheClockTeam">Loading...</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body" id="currentPickBody">
                                        <!-- Current pick content will be dynamically loaded -->
                                    </div>
                                </div>

                                <!-- Available Players -->
                                <div class="card">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <div>
                                            <h5>Available Players</h5>
                                            <div class="btn-group btn-group-sm" role="group" id="positionFilters">
                                                <button type="button" class="btn btn-outline-primary active" data-position="all">All</button>
                                                <button type="button" class="btn btn-outline-primary" data-position="QB">QB</button>
                                                <button type="button" class="btn btn-outline-primary" data-position="RB">RB</button>
                                                <button type="button" class="btn btn-outline-primary" data-position="WR">WR</button>
                                                <button type="button" class="btn btn-outline-primary" data-position="TE">TE</button>
                                                <button type="button" class="btn btn-outline-primary" data-position="OL">OL</button>
                                                <button type="button" class="btn btn-outline-primary" data-position="DL">DL</button>
                                                <button type="button" class="btn btn-outline-primary" data-position="LB">LB</button>
                                                <button type="button" class="btn btn-outline-primary" data-position="DB">DB</button>
                                                <button type="button" class="btn btn-outline-primary" data-position="P/K">P/K</button>
                                            </div>
                                        </div>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button" class="btn btn-outline-secondary" id="tradingButton" style="display: none;">
                                                <i class="fas fa-exchange-alt me-1"></i>Propose Trade
                                            </button>
                                            <button type="button" class="btn btn-outline-warning" id="autoPickButton" disabled>
                                                <i class="fas fa-robot me-1"></i>Auto Pick
                                            </button>
                                        </div>
                                    </div>
                                    <div class="card-body" style="max-height: 500px; overflow-y: auto;">
                                        <div id="availablePlayers">
                                            <!-- Available players will be loaded here -->
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="d-flex justify-content-between">
                            <div>
                                <a href="/Team/MyTeams" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left me-2"></i>Back to My Teams
                                </a>
                            </div>
                            <div class="btn-group">
                                <button type="submit" class="btn btn-success" name="saveAction" value="complete" id="completeDraftButton">
                                    <i class="fas fa-check me-2"></i>Complete Draft
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function () {
        // State variables
        let selectedFranchises = []; // Array of franchise IDs for multiple team control
        let draftMethod = 'full';
        let draftOrder = [];
        let currentPickIndex = 0;
        let availablePlayersData = [];
        let isUserControlled = false;
        let enableTrading = true;
        let manualRounds = 0;
        let currentPositionFilter = 'all';
        let simulationSpeed = 'normal';
        let isDraftActive = false;
        let teamDraftPicks = new Map(); // Only team picks: pickNumber -> playerId
        let userControlledPicks = []; // List of picks user needs to make
        let franchiseControlledPicks = []; // List of picks for other franchises user controls
        let franchiseDraftOrder = []; // Array of 32 franchises with draft positions and needs

        // NFL Franchises using enum values (1-32)
        const nflFranchises = {
            1: { name: "Arizona Cardinals", abbreviation: "ARIZ" },
            2: { name: "Atlanta Falcons", abbreviation: "ATL" },
            3: { name: "Baltimore Ravens", abbreviation: "BAL" },
            4: { name: "Buffalo Bills", abbreviation: "BUF" },
            5: { name: "Carolina Panthers", abbreviation: "CAR" },
            6: { name: "Chicago Bears", abbreviation: "CHI" },
            7: { name: "Cincinnati Bengals", abbreviation: "CIN" },
            8: { name: "Cleveland Browns", abbreviation: "CLE" },
            9: { name: "Dallas Cowboys", abbreviation: "DAL" },
            10: { name: "Denver Broncos", abbreviation: "DEN" },
            11: { name: "Detroit Lions", abbreviation: "DET" },
            12: { name: "Green Bay Packers", abbreviation: "GB" },
            13: { name: "Houston Texans", abbreviation: "HOU" },
            14: { name: "Indianapolis Colts", abbreviation: "IND" },
            15: { name: "Jacksonville Jaguars", abbreviation: "JAX" },
            16: { name: "Kansas City Chiefs", abbreviation: "KC" },
            17: { name: "Las Vegas Raiders", abbreviation: "LV" },
            18: { name: "Los Angeles Chargers", abbreviation: "LAC" },
            19: { name: "Los Angeles Rams", abbreviation: "LAR" },
            20: { name: "Miami Dolphins", abbreviation: "MIA" },
            21: { name: "Minnesota Vikings", abbreviation: "MIN" },
            22: { name: "New England Patriots", abbreviation: "NE" },
            23: { name: "New Orleans Saints", abbreviation: "NO" },
            24: { name: "New York Giants", abbreviation: "NYG" },
            25: { name: "New York Jets", abbreviation: "NYJ" },
            26: { name: "Philadelphia Eagles", abbreviation: "PHI" },
            27: { name: "Pittsburgh Steelers", abbreviation: "PIT" },
            28: { name: "San Francisco 49ers", abbreviation: "SF" },
            29: { name: "Seattle Seahawks", abbreviation: "SEA" },
            30: { name: "Tampa Bay Buccaneers", abbreviation: "TB" },
            31: { name: "Tennessee Titans", abbreviation: "TEN" },
            32: { name: "Washington Commanders", abbreviation: "WAS" }
        };

        // Initialize team draft picks from hidden field
        function initializeTeamDraftPicks() {
            const draftString = document.getElementById('draftPicks').value;
            teamDraftPicks.clear();
            
            if (draftString && draftString.trim()) {
                // Parse: "1: 101, 33: 102, 65: 103"
                const picks = draftString.split(',');
                picks.forEach(pick => {
                    const trimmedPick = pick.trim();
                    if (trimmedPick) {
                        const [pickNumber, playerId] = trimmedPick.split(':').map(s => s.trim());
                        if (pickNumber && playerId) {
                            teamDraftPicks.set(parseInt(pickNumber), parseInt(playerId));
                        }
                    }
                });
            }
        }

        // Update team draft picks hidden field
        function updateTeamDraftPicksHiddenField() {
            const draftPairs = [];
            teamDraftPicks.forEach((playerId, pickNumber) => {
                draftPairs.push(`${pickNumber}: ${playerId}`);
            });
            document.getElementById('draftPicks').value = draftPairs.join(', ');
        }

        // Initialize selected franchises
        function initializeSelectedFranchises() {
            const hiddenField = document.getElementById('selectedFranchises');
            const value = hiddenField.value.trim();
            selectedFranchises = value ? value.split(',').map(id => parseInt(id)).filter(id => !isNaN(id)) : [];
        }

        // Create franchise selection checkboxes
        function createFranchiseSelection() {
            const container = document.getElementById('franchiseSelection');
            container.innerHTML = '';
            
            Object.entries(nflFranchises).forEach(([id, franchise]) => {
                const franchiseId = parseInt(id);
                const col = document.createElement('div');
                col.className = 'col-md-4 col-sm-6 mb-2';
                
                col.innerHTML = `
                    <div class="form-check">
                        <input class="form-check-input franchise-checkbox" type="checkbox" 
                               id="franchise${franchiseId}" value="${franchiseId}"
                               ${selectedFranchises.includes(franchiseId) ? 'checked' : ''}>
                        <label class="form-check-label" for="franchise${franchiseId}">
                            ${franchise.name}
                        </label>
                    </div>
                `;
                
                container.appendChild(col);
            });
            
            // Add event listeners
            document.querySelectorAll('.franchise-checkbox').forEach(checkbox => {
                checkbox.addEventListener('change', updateSelectedFranchises);
            });
        }

        // Update selected franchises array
        function updateSelectedFranchises() {
            selectedFranchises = Array.from(document.querySelectorAll('.franchise-checkbox:checked'))
                .map(cb => parseInt(cb.value));
            updateSelectedFranchisesField();
        }

        // Update selected franchises hidden field
        function updateSelectedFranchisesField() {
            document.getElementById('selectedFranchises').value = selectedFranchises.join(',');
        }

        // Settings phase functions
        function updateDraftPreview() {
            manualRounds = parseInt(document.getElementById('Rounds').value) || 0;
            draftMethod = document.querySelector('input[name="draftMethod"]:checked').value;
            enableTrading = document.getElementById('enableTrading').checked;

            // Show/hide team selection
            const teamSelectionCard = document.getElementById('teamSelectionCard');
            if (draftMethod === 'multiple') {
                teamSelectionCard.style.display = 'block';
                if (!document.querySelector('.franchise-checkbox')) {
                    createFranchiseSelection();
                }
            } else {
                teamSelectionCard.style.display = 'none';
            }

            // Update preview text
            let manualDescription = '';
            if (draftMethod === 'full') {
                manualDescription = 'Full simulation';
            } else if (draftMethod === 'myteam') {
                manualDescription = manualRounds === 0 ? 'Auto-pick for your team' :
                                 manualRounds === 7 ? 'Manual control for all your picks' :
                                 `Manual control for ${manualRounds} rounds`;
            } else if (draftMethod === 'multiple') {
                manualDescription = `Manual control for ${selectedFranchises.length} selected teams (${manualRounds} rounds)`;
            }

            document.getElementById('manualDescription').textContent = manualDescription;
            document.getElementById('tradingStatus').textContent = enableTrading ? 'Enabled' : 'Disabled';
        }

        // Event handlers for settings
        document.getElementById('Rounds').addEventListener('change', updateDraftPreview);
        document.getElementById('Speed').addEventListener('change', updateDraftPreview);

        document.querySelectorAll('input[name="draftMethod"]').forEach(radio => {
            radio.addEventListener('change', updateDraftPreview);
        });

        document.getElementById('enableTrading').addEventListener('change', updateDraftPreview);

        // Start draft button
        document.getElementById('startDraftButton').addEventListener('click', function () {
            if (validateSettings()) {
                startDraftSimulation();
            }
        });

        function validateSettings() {
            const rounds = parseInt(document.getElementById('Rounds').value);
            if (rounds < 0 || rounds > 7) {
                alert('Manual rounds must be between 0 and 7');
                return false;
            }

            if (draftMethod === 'multiple' && selectedFranchises.length === 0) {
                alert('Please select at least one team to control');
                return false;
            }

            return true;
        }

        // Draft simulation functions
        function startDraftSimulation() {
            isDraftActive = true;
            simulationSpeed = document.getElementById('Speed').value || 'normal';

            // Enable draft tab
            const draftTab = document.getElementById('draft-tab');
            draftTab.classList.remove('disabled');
            draftTab.disabled = false;

            const tab = new bootstrap.Tab(draftTab);
            tab.show();

            // Show/hide trading button based on settings
            const tradingButton = document.getElementById('tradingButton');
            tradingButton.style.display = enableTrading ? 'inline-block' : 'none';

            // Make API calls to initialize draft
            initializeDraftData();
        }

        function initializeDraftData() {
            // API Call 1: Get user-controlled picks
            const pickData = {
                teamId: parseInt('@Model.Id'), // Use actual model ID
                franchiseIds: draftMethod === 'multiple' ? selectedFranchises : (draftMethod === 'myteam' ? [parseInt('@Model.Id')] : []),
                rounds: manualRounds
            };

            // Build query parameters for GET request
            const queryParams = new URLSearchParams({
                teamId: parseInt('@Model.Id'),
                rounds: manualRounds
            });
            
            // Add franchise IDs as separate parameters
            const franchiseIds = draftMethod === 'multiple' ? selectedFranchises : (draftMethod === 'myteam' ? [parseInt('@Model.Id')] : []);
            franchiseIds.forEach(id => queryParams.append('franchiseIds', id));

            fetch(`/Team/GetUserControlledPicks?${queryParams.toString()}`, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                userControlledPicks = data.teamPicks || [];
                franchiseControlledPicks = data.franchisePicks || [];
                franchiseDraftOrder = data.franchiseDraftOrder || [];
                
                // Initialize draft order with franchise data
                loadDraftOrderFromAPI();
            });

            // API Call 2: Load prospects (separate call)
            fetch('/Team/GetDraftProspects')
            .then(response => response.json())
            .then(prospects => {
                availablePlayersData = prospects;
                displayAvailablePlayers();
                
                // Start draft processing once both calls complete
                if (userControlledPicks.length > 0 || franchiseControlledPicks.length > 0) {
                    processDraftPick();
                }
            });
        }

        function loadDraftOrderFromAPI() {
            // Use API data
            draftOrder = [];
            for (let round = 1; round <= 7; round++) {
                franchiseDraftOrder.forEach((franchise, index) => {
                    const overallPick = ((round - 1) * 33) + (index + 1);
                    const teamId = franchise.teamId;
                    const teamName = teamId === parseInt('@Model.Id') ? '@Model.Location @Model.Mascot' : 
                                    nflFranchises[teamId]?.name || `Team ${teamId}`;
                    const teamAbbr = teamId === parseInt('@Model.Id') ? '@Model.Abb' : 
                                    nflFranchises[teamId]?.abbreviation || `T${teamId}`;
                    
                    draftOrder.push({
                        round: round,
                        pick: index + 1,
                        overallPick: overallPick,
                        teamId: teamId,
                        teamName: teamName,
                        teamAbbr: teamAbbr,
                        neededPositions: franchise.neededPositions || []
                    });
                });
            }
        }





        function processDraftPick() {
            if (currentPickIndex >= draftOrder.length) {
                completeDraft();
                return;
            }

            const currentPick = draftOrder[currentPickIndex];
            isUserControlled = shouldPickBeUserControlled(currentPick);

            updateCurrentPickDisplay(currentPick);

            if (isUserControlled) {
                showManualPickInterface();
            } else {
                simulateAutomaticPick();
            }
        }

        function shouldPickBeUserControlled(pick) {
            // Check if this pick is in user's controlled picks
            return userControlledPicks.includes(pick.overallPick) || franchiseControlledPicks.includes(pick.overallPick);
        }

        function updateCurrentPickDisplay(pick) {
            document.getElementById('onTheClockTeam').textContent = `${pick.teamName} - Pick ${pick.overallPick}`;
            document.getElementById('currentRound').textContent = pick.round;
            document.getElementById('currentPickNumber').textContent = pick.overallPick;
            document.getElementById('current-pick').textContent = `Pick ${pick.overallPick}`;

            // Enable/disable buttons
            document.getElementById('autoPickButton').disabled = !isUserControlled;
        }

        function showManualPickInterface() {
            const container = document.getElementById('currentPickBody');
            container.innerHTML = `
                <div class="text-center">
                    <h5>Your Turn to Pick!</h5>
                    <p>Select a player from the available players list below.</p>
                </div>
            `;
        }

        function simulateAutomaticPick() {
            const container = document.getElementById('currentPickBody');
            container.innerHTML = `
                <div class="text-center">
                    <div class="spinner-border text-primary mb-2" role="status"></div>
                    <p>Making selection...</p>
                </div>
            `;

            const delays = { 'instant': 100, 'fast': 500, 'normal': 1000, 'slow': 2000 };
            setTimeout(() => {
                makeLocalAIPick();
            }, delays[simulationSpeed] || 1000);
        }

        function makeLocalAIPick() {
            const currentPick = draftOrder[currentPickIndex];
            const neededPositions = currentPick.neededPositions || [];
            
            let selectedPlayer = null;
            
            // First try to fill needed positions
            if (neededPositions.length > 0) {
                for (let position of neededPositions) {
                    selectedPlayer = availablePlayersData.find(p => p.position === position);
                    if (selectedPlayer) break;
                }
            }
            
            // If no needed position player found, pick best available
            if (!selectedPlayer && availablePlayersData.length > 0) {
                selectedPlayer = availablePlayersData.reduce((prev, current) =>
                    (prev.athScore > current.athScore) ? prev : current
                );
            }
            
            if (selectedPlayer) {
                makeDraftPick(selectedPlayer.id);
            } else {
                // No players available, skip pick
                currentPickIndex++;
                processDraftPick();
            }
        }



        function makeDraftPick(playerId) {
            const player = availablePlayersData.find(p => p.id == playerId);
            if (!player) return;

            const currentPick = draftOrder[currentPickIndex];

            // Only save to team picks if this is the user's team
            if (currentPick.teamId === parseInt('@Model.Id')) {
                teamDraftPicks.set(currentPick.overallPick, playerId);
                updateTeamDraftPicksHiddenField();
            }

            // Remove player from available players (hide selected players)
            availablePlayersData = availablePlayersData.filter(p => p.id != playerId);
            displayAvailablePlayers(); // Refresh display to hide selected player

            showPickResult(currentPick, player);

            setTimeout(() => {
                currentPickIndex++;
                processDraftPick();
            }, 2000);
        }

        function showPickResult(pick, player) {
            const container = document.getElementById('currentPickBody');
            container.innerHTML = `
                <div class="text-center">
                    <div class="alert alert-success">
                        <h5><i class="fas fa-check-circle me-2"></i>Pick Made!</h5>
                        <p class="mb-0">
                            <strong>${pick.teamName}</strong> selects <strong>${player.name}</strong>
                            (${player.position}, ${player.school})
                        </p>
                    </div>
                </div>
            `;
        }

        function startPickTimer() {
            let timeRemaining = 300;
            const timerDisplay = document.getElementById('pickTimer');

            currentPickTimer = setInterval(() => {
                const minutes = Math.floor(timeRemaining / 60);
                const seconds = timeRemaining % 60;
                timerDisplay.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;

                timeRemaining--;
                if (timeRemaining < 0) {
                    clearInterval(currentPickTimer);
                    autoPickBestAvailable();
                }
            }, 1000);
        }

        function clearPickTimer() {
            if (currentPickTimer) {
                clearInterval(currentPickTimer);
                currentPickTimer = null;
            }
        }

        function displayAvailablePlayers() {
            const container = document.getElementById('availablePlayers');

            // Position group mappings
            const positionGroups = {
                'QB': ['QB'],
                'RB': ['RB', 'FB'],
                'WR': ['WR'],
                'TE': ['TE'],
                'OL': ['OT', 'CG', 'C'],
                'DL': ['NT', 'DT', 'ED'],
                'LB': ['MLB', 'OLB'],
                'DB': ['DB'],
                'P/K': ['P', 'K']
            };

            // Filter by position
            const filteredPlayers = availablePlayersData.filter(player => {
                if (currentPositionFilter === 'all') return true;
                
                const allowedPositions = positionGroups[currentPositionFilter] || [currentPositionFilter];
                return allowedPositions.includes(player.position);
            });

            container.innerHTML = '';

            if (filteredPlayers.length === 0) {
                container.innerHTML = `
                    <div class="text-center text-muted p-4">
                        <i class="fas fa-users-slash fa-2x mb-2"></i>
                        <p>No available players for this position</p>
                    </div>
                `;
                return;
            }

            filteredPlayers.forEach(player => {
                const playerDiv = document.createElement('div');
                playerDiv.className = 'col-12 mb-2';

                const cardDiv = document.createElement('div');
                cardDiv.className = 'card player-card';
                cardDiv.setAttribute('data-player-id', player.id);

                if (isUserControlled) {
                    cardDiv.classList.add('selectable');
                }

                // Format height from inches to feet'inches
                const heightFeet = Math.floor((player.height || 0) / 12);
                const heightInches = (player.height || 0) % 12;
                const heightDisplay = `${heightFeet}'${heightInches}"`;

                cardDiv.innerHTML = `
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8">
                                <div class="player-header">
                                    <h6 class="player-title mb-1">${player.name || 'Unknown'}</h6>
                                    <div class="player-basic-info mb-2">
                                        <span class="badge bg-primary me-2">${player.position || 'N/A'}</span>
                                        <span class="text-muted">${player.college || 'Unknown College'}</span>
                                        <span class="text-muted mx-2">|</span>
                                        <span class="text-muted">${player.year || 'N/A'} Year</span>
                                    </div>
                                    <div class="player-physical mb-2">
                                        <small class="text-muted">
                                            <strong>Physical:</strong> ${heightDisplay} | ${player.weight || 0} lbs
                                            ${player.handSize ? ` | Hands: ${player.handSize}` : ''}
                                            ${player.armLength ? ` | Arms: ${player.armLength}` : ''}
                                            ${player.wingspan ? ` | Wingspan: ${player.wingspan}` : ''}
                                        </small>
                                    </div>
                                    <div class="player-combine">
                                        <small class="text-info">
                                            <strong>Combine:</strong>
                                            ${player.fortyYardDash ? ` 40yd: ${player.fortyYardDash}` : ''}
                                            ${player.vertJump ? ` | Vert: ${player.vertJump}"` : ''}
                                            ${player.broadJump ? ` | Broad: ${player.broadJump}"` : ''}
                                            ${player.benchPress ? ` | Bench: ${player.benchPress}` : ''}
                                            ${player.threeConeDrill ? ` | 3-Cone: ${player.threeConeDrill}` : ''}
                                            ${player.twentyYardShuttle ? ` | 20yd: ${player.twentyYardShuttle}` : ''}
                                        </small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 text-end">
                                <div class="player-scores">
                                    <div class="mb-2">
                                        <span class="badge bg-success fs-6">Ath: ${player.athScore || 0}</span>
                                    </div>
                                    <div>
                                        <span class="badge bg-warning text-dark">Consensus: ${player.consensus || 0}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                // Add click handler for manual picks
                cardDiv.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    if (isUserControlled) {
                        const playerId = parseInt(this.getAttribute('data-player-id'));
                        console.log('Player clicked:', playerId, 'User controlled:', isUserControlled);
                        makeDraftPick(playerId);
                    } else {
                        console.log('Click ignored - not user controlled pick');
                    }
                });

                // Add visual feedback for selectable cards
                if (isUserControlled) {
                    cardDiv.style.cursor = 'pointer';
                    cardDiv.title = 'Click to draft this player';
                }

                playerDiv.appendChild(cardDiv);
                container.appendChild(playerDiv);
            });
        }

        function completeDraft() {
            const container = document.getElementById('currentPickBody');
            container.innerHTML = `
                <div class="text-center">
                    <div class="alert alert-success">
                        <h4><i class="fas fa-trophy me-2"></i>Draft Complete!</h4>
                        <p>The NFL Draft has been completed.</p>
                    </div>
                </div>
            `;
            isDraftActive = false;
            
            // Enable the complete draft button
            document.getElementById('completeDraftButton').disabled = false;
        }

        // Position filter functionality
        document.querySelectorAll('#positionFilters button').forEach(button => {
            button.addEventListener('click', function () {
                document.querySelectorAll('#positionFilters button').forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                currentPositionFilter = this.getAttribute('data-position');
                displayAvailablePlayers();
            });
        });

        // Auto pick button
        document.getElementById('autoPickButton').addEventListener('click', function() {
            if (isUserControlled) {
                makeLocalAIPick();
            }
        });

        // Trading button - opens trade modal
        document.getElementById('tradingButton').addEventListener('click', function() {
            if (enableTrading && isUserControlled) {
                openTradeModal();
            }
        });

        function openTradeModal() {
            const currentPick = draftOrder[currentPickIndex];
            
            // Create modal backdrop
            const modalBackdrop = document.createElement('div');
            modalBackdrop.className = 'modal-backdrop fade show';
            modalBackdrop.style.zIndex = '1040';
            document.body.appendChild(modalBackdrop);
            
            // Create modal container
            const modalContainer = document.createElement('div');
            modalContainer.className = 'modal fade show';
            modalContainer.style.display = 'block';
            modalContainer.style.zIndex = '1050';
            modalContainer.innerHTML = `
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Propose Trade - Pick ${currentPick.overallPick}</h5>
                            <button type="button" class="btn-close" onclick="closeTradeModal()"></button>
                        </div>
                        <div class="modal-body" id="tradeModalBody">
                            <div class="text-center p-4">
                                <div class="spinner-border text-primary mb-3" role="status"></div>
                                <p>Loading trade interface...</p>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            modalContainer.id = 'tradeModal';
            document.body.appendChild(modalContainer);
            
            // Load trade partial view
            fetch(`/Team/GetTradePartial?currentTeam=${currentPick.teamId}&currentPick=${currentPick.overallPick}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('tradeModalBody').innerHTML = html;
                    
                    // Initialize any trade-specific JavaScript here
                    if (window.initializeTradeView) {
                        window.initializeTradeView();
                    }
                })
                .catch(error => {
                    console.error('Error loading trade view:', error);
                    document.getElementById('tradeModalBody').innerHTML = `
                        <div class="alert alert-danger">
                            <h6>Error Loading Trade View</h6>
                            <p>Unable to load the trade interface. Please try again.</p>
                            <button type="button" class="btn btn-secondary" onclick="closeTradeModal()">Close</button>
                        </div>
                    `;
                });
        }

        // Global function to close trade modal
        window.closeTradeModal = function() {
            const modal = document.getElementById('tradeModal');
            const backdrop = document.querySelector('.modal-backdrop');
            
            if (modal) modal.remove();
            if (backdrop) backdrop.remove();
        };

        // Global function to handle trade completion
        window.onTradeCompleted = function(tradeResult) {
            closeTradeModal();
            
            if (tradeResult && tradeResult.success) {
                handleTradeResult(tradeResult);
            }
        };

        function handleTradeResult(tradeData) {
            if (tradeData.success) {
                // tradeData contains: { success: true, picksReceived: [], picksGiven: [] }
                
                // Update draft order based on trade
                if (tradeData.picksReceived && tradeData.picksReceived.length > 0) {
                    console.log('Picks received:', tradeData.picksReceived);
                    // Update draft order logic here
                }
                
                if (tradeData.picksGiven && tradeData.picksGiven.length > 0) {
                    console.log('Picks given:', tradeData.picksGiven);
                    // Update draft order logic here
                }
                
                // Refresh the draft display
                loadDraftOrder();
                
                // Show trade success message
                const container = document.getElementById('currentPickBody');
                container.innerHTML = `
                    <div class="text-center">
                        <div class="alert alert-success">
                            <h5><i class="fas fa-handshake me-2"></i>Trade Completed!</h5>
                            <p>Trade has been processed. Draft order updated.</p>
                        </div>
                    </div>
                `;
                
                setTimeout(() => {
                    processDraftPick();
                }, 2000);
            }
        }

        // Initialize everything
        initializeTeamDraftPicks();
        initializeSelectedFranchises();
        updateDraftPreview();
    });
</script>

