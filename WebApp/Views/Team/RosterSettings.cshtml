@model METCore.DTOs.Team.TeamInfoDto

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Team Header Card -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">Roster Settings: @Model.Location @Model.Mascot</h4>
                        <span class="badge bg-light text-primary fs-6">@Model.Abb</span>
                    </div>
                </div>
                <div class="card-body">
                    <p class="mb-0 text-muted">Configure your expansion team draft settings and protected players</p>
                </div>
            </div>

            <!-- Navigation Tabs Card -->
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <ul class="nav nav-pills card-header-pills mb-0" id="phaseNavigation" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="settings-tab" data-bs-toggle="pill" data-bs-target="#settings-phase" type="button" role="tab">
                                <i class="fas fa-cog me-2"></i>Team Settings
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link disabled" id="protection-tab" data-bs-toggle="pill" data-bs-target="#protection-phase" type="button" role="tab" disabled>
                                <i class="fas fa-shield-alt me-2"></i>Protected Players
                                <span class="badge bg-secondary ms-2" id="protection-count">0/0</span>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>

            <form asp-action="SaveRosterSettings" method="post" id="teamSettingsForm">
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.Location)
                @Html.HiddenFor(m => m.Mascot)
                @Html.HiddenFor(m => m.Abb)
                @Html.HiddenFor(m => m.UserUsername)
                @Html.HiddenFor(m => m.Date)
                @Html.HiddenFor(m => m.Complete)

                <!-- Container for dynamic protected player hidden fields -->
                <div id="protectedPlayersContainer">
                    @if (Model.RosterSettingsProtectedPlayersIds != null)
                    {
                        @for (int i = 0; i < Model.RosterSettingsProtectedPlayersIds.Count; i++)
                        {
                            <input type="hidden" name="RosterSettingsProtectedPlayersIds[@i]" value="@Model.RosterSettingsProtectedPlayersIds[i]" />
                        }
                    }
                </div>

                <div class="tab-content">
                    <!-- Phase 1: Team Settings Configuration -->
                    <div class="tab-pane fade show active" id="settings-phase" role="tabpanel">
                        <div class="card">
                            <div class="card-header bg-success text-white">
                                <h5 class="mb-0">Configure Team Settings</h5>
                            </div>
                            <div class="card-body">
                                <p class="text-muted mb-4">Set the parameters for your expansion team creation</p>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label for="salaryCapInput" class="form-label fw-bold">@Html.DisplayNameFor(m => m.RosterSettingsCap)</label>
                                        @Html.TextBoxFor(m => m.RosterSettingsCap, new { @class = "form-control", @type = "number", @step = "1", @min = "60", @max = "120", @id = "salaryCapInput" })
                                        @Html.ValidationMessageFor(m => m.RosterSettingsCap, "", new { @class = "text-danger" })
                                        <div class="form-text">Percentage of current salary cap available (60-120%)</div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label for="maxPerTeamInput" class="form-label fw-bold">@Html.DisplayNameFor(m => m.RosterSettingsMaxPerTeam)</label>
                                        @Html.TextBoxFor(m => m.RosterSettingsMaxPerTeam, new { @class = "form-control", @type = "number", @min = "2", @max = "10", @id = "maxPerTeamInput" })
                                        @Html.ValidationMessageFor(m => m.RosterSettingsMaxPerTeam, "", new { @class = "text-danger" })
                                        <div class="form-text">Maximum players you can draft from each team (2-10)</div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label for="protectedPerTeamInput" class="form-label fw-bold">@Html.DisplayNameFor(m => m.RosterSettingsProtectedPerTeam)</label>
                                        @Html.TextBoxFor(m => m.RosterSettingsProtectedPerTeam, new { @class = "form-control", @type = "number", @min = "3", @max = "20", @id = "protectedPerTeamInput" })
                                        @Html.ValidationMessageFor(m => m.RosterSettingsProtectedPerTeam, "", new { @class = "text-danger" })
                                        <div class="form-text">Number of players each team can protect (3-20)</div>
                                    </div>
                                </div>

                                <!-- Settings Preview -->
                                <div class="card bg-light mt-4">
                                    <div class="card-body">
                                        <h6 class="card-title">Settings Preview</h6>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <small class="text-muted d-block">Salary Cap:</small>
                                                <strong id="previewSalaryCap">$0M</strong>
                                            </div>
                                            <div class="col-md-6">
                                                <small class="text-muted d-block">Total Available Players:</small>
                                                <strong id="previewTotalPlayers">0 players</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between mt-4">
                                    <a href="@Url.Action("Details", "Team", new { id = Model.Id })" class="btn btn-outline-secondary">
                                        <i class="fas fa-arrow-left me-1"></i>Back to Team
                                    </a>
                                    <button type="button" class="btn btn-success" id="proceedToProtection">
                                        <i class="fas fa-arrow-right me-1"></i>Continue to Player Protection
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Phase 2: Protected Players Selection -->
                    <div class="tab-pane fade" id="protection-phase" role="tabpanel">
                        <div class="row">
                            <!-- Teams List -->
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-header bg-info text-white">
                                        <h5 class="mb-0">NFL Teams</h5>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="list-group list-group-flush" id="teamsList" style="max-height: 600px; overflow-y: auto;">
                                            <!-- Teams will be populated here -->
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Player Selection Area -->
                            <div class="col-md-8">
                                <div class="card h-100">
                                    <div class="card-header bg-warning text-dark">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h5 class="mb-0" id="currentTeamName">Select a team to view players</h5>
                                            <div>
                                                <span class="badge bg-dark me-2" id="selectedCount">0 selected</span>
                                                <button type="button" class="btn btn-sm btn-outline-dark" id="clearTeamSelection" style="display: none;">
                                                    Clear Selection
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <div id="playerSelectionArea">
                                            <div class="text-center text-muted p-5">
                                                <i class="fas fa-users fa-3x mb-3"></i>
                                                <h5>Select a Team</h5>
                                                <p>Choose a team from the left to view and protect their players</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="card mt-4">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <button type="button" class="btn btn-outline-secondary" id="backToSettings">
                                        <i class="fas fa-arrow-left me-1"></i>Back to Settings
                                    </button>
                                    <button type="submit" class="btn btn-success">
                                        <i class="fas fa-save me-1"></i>Save Roster Settings
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/Views/Team/RosterSettings.js"></script>

<style>
    .player-card {
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .player-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .player-card.protected {
            border-color: var(--bs-primary) !important;
            background-color: rgba(13, 110, 253, 0.1);
        }

            .player-card.protected .player-stats::after {
                content: "\f3ed";
                font-family: "Font Awesome 5 Free";
                font-weight: 900;
                color: var(--bs-primary);
                float: right;
            }

    .player-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .player-stats {
        text-align: right;
    }

    .player-title {
        margin-bottom: 0.25rem;
        font-weight: 600;
    }

    .player-details {
        color: var(--bs-gray-600);
        font-size: 0.875rem;
    }

    .player-salary {
        color: var(--bs-success);
        font-weight: bold;
        font-size: 0.875rem;
    }

    .nav-pills .nav-link.disabled {
        opacity: 0.5;
        pointer-events: none;
    }

    .list-group-item-action:hover {
        background-color: rgba(0,0,0,0.05);
    }

    .team-item.active {
        background-color: #0d6efd;
        color: white;
    }

        .team-item.active .badge {
            background-color: rgba(255,255,255,0.2) !important;
        }
</style>