@model METCore.DTOs.Team.TeamInfoDto

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <!-- Team Header Card -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">Configuración: @Model.Location @Model.Mascot</h4>
                        <span class="badge bg-light text-primary fs-6">@Model.Abb</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-2"><strong>@Html.LabelFor(m => m.UserUsername):</strong> <span class="text-muted">@Model.UserUsername</span></p>
                            <p class="mb-0"><strong>@Html.LabelFor(m => m.Date):</strong> <span class="text-muted">@Model.Date.ToString("MMM dd, yyyy")</span></p>
                        </div>
                        <div class="col-md-6">
                            <div class="text-md-end">
                                @if (Model.Complete)
                                {
                                    <span class="badge bg-success fs-6">Equipo completado</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning fs-6">Configuración necesaria</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <form asp-action="SaveRosterSettings" method="post" id="rosterSettingsForm">
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.Location)
                @Html.HiddenFor(m => m.Mascot)
                @Html.HiddenFor(m => m.Abb)
                @Html.HiddenFor(m => m.UserUsername)
                @Html.HiddenFor(m => m.Date)
                @Html.HiddenFor(m => m.Complete)

                <!-- Roster Configuration Card -->
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-cog me-2"></i>Configuración de la Plantilla
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-4">
                            <div class="col-md-4">
                                <label for="capInput" class="form-label fw-bold text-muted">
                                    <i class="fas fa-dollar-sign me-1"></i>@Html.LabelFor(m => m.RosterSettingsCap)
                                </label>
                                <input type="number" class="form-control" id="capInput" name="RosterSettingsCap" value="@Html.DisplayFor(m => m.RosterSettingsCap)" min="60" max="120" required>
                                <div class="form-text">Porcentaje respecto al total actual ($224M)</div>
                            </div>
                            <div class="col-md-4">
                                <label for="maxPerTeamInput" class="form-label fw-bold text-muted">
                                    <i class="fas fa-users me-1"></i>@Html.LabelFor(m => m.RosterSettingsMaxPerTeam)
                                </label>
                                <input type="number" class="form-control" id="maxPerTeamInput" name="RosterSettingsMaxPerTeam" value="@Html.DisplayFor(m => m.RosterSettingsMaxPerTeam)" min="2" max="10" required>
                                <div class="form-text">Máximo de jugadores a robar por equipo</div>
                            </div>
                            <div class="col-md-4">
                                <label for="protectedPerTeamInput" class="form-label fw-bold text-muted">
                                    <i class="fas fa-shield-alt me-1"></i>@Html.LabelFor(m => m.RosterSettingsProtectedPerTeam)
                                </label>
                                <input type="number" class="form-control" id="protectedPerTeamInput" name="RosterSettingsProtectedPerTeam" value="@Html.DisplayFor(m => m.RosterSettingsProtectedPerTeam)" min="0" max="6" required>
                                <div class="form-text">Número de jugadores que podrán ser protegidos por cada equipo</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Protected Players Selection Card -->
                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-user-shield me-2"></i>Selección de Jugadores Protegidos
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted">Método de Selección</label>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="protectionMethod" id="autoProtection" value="auto" checked>
                                        <label class="form-check-label" for="autoProtection">
                                            <strong>Protección Automatica</strong>
                                            <div class="form-text">Protege a los jugadores por defecto para cada franquicia</div>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="protectionMethod" id="manualProtection" value="manual">
                                        <label class="form-check-label" for="manualProtection">
                                            <strong>Protección Manual</strong>
                                            <div class="form-text">Seleccione a que jugadores proteger por equipo.</div>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="manualSelectionArea" style="display: none;">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="card">
                                        <div class="card-header bg-warning text-dark">
                                            <h6 class="mb-0">
                                                <i class="fas fa-football-ball me-1"></i>Franquicias NFL
                                            </h6>
                                            <div class="progress mt-2" style="height: 6px;">
                                                <div class="progress-bar bg-success" id="selectionProgress" style="width: 0%"></div>
                                            </div>
                                            <small class="text-muted">
                                                <span id="franchisesWithSelections">0</span> de 32 franquicias completadas
                                            </small>
                                        </div>
                                        <div class="card-body p-0" style="max-height: 600px; overflow-y: auto;">
                                            <div class="list-group list-group-flush" id="franchisesList">
                                                <!-- Franchises will be populated here -->
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-8">
                                    <div class="card h-100">
                                        <div class="card-header bg-secondary text-white">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <h6 class="mb-0" id="currentTeamName">Seleccione una franquicia para ver sus jugadores</h6>
                                                <div>
                                                    <span class="badge bg-dark me-2" id="selectedCount">0 seleccionados</span>
                                                    <button type="button" class="btn btn-sm btn-outline-light" id="clearTeamSelection" style="display: none;">
                                                        Limpiar selección
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card-body">
                                            <div id="playerSelectionArea">
                                                <div class="text-center text-muted p-5">
                                                    <i class="fas fa-users fa-3x mb-3"></i>
                                                    <h5>Elija a una franquicia</h5>
                                                    <p>Elija una franquicia de la izquierda para mostrar y proteger sus jugadores</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons Card -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Details", "Team", new { id = Model.Id })" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Volver al listado
                            </a>
                            <button type="submit" class="btn btn-success" id="saveSettings">
                                <i class="fas fa-save me-2"></i>Guardar configuración
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Font Awesome Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
    .list-group-item:hover {
        background-color: #f8f9fa;
    }

    .list-group-item.active {
        background-color: #007bff;
        border-color: #007bff;
    }

    .player-card {
        transition: all 0.2s ease;
        border: 1px solid #dee2e6;
        cursor: pointer;
        position: relative;
    }

        .player-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .player-card.selected {
            border-color: #28a745;
            background-color: rgba(40, 167, 69, 0.05);
        }

            .player-card.selected::after {
                content: "✓";
                position: absolute;
                top: 8px;
                right: 8px;
                background: #28a745;
                color: white;
                border-radius: 50%;
                width: 20px;
                height: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 12px;
                font-weight: bold;
            }

    .player-card > div > div > div {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .form-check-input:checked {
        background-color: #007bff;
        border-color: #007bff;
    }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function () {
        let protectedPlayersArray = [];
        let currentTeamId = null;
        let protectedPerTeam = parseInt(document.getElementById('protectedPerTeamInput').value) || 3;
        let isManualProtection = false;

        const nflTeams = {};
        const teamPlayersCache = {};

        const teamNames = {
            1: { name: "Arizona Cardinals", abbreviation: "ARI" },
            2: { name: "Atlanta Falcons", abbreviation: "ATL" },
            3: { name: "Baltimore Ravens", abbreviation: "BAL" },
            4: { name: "Buffalo Bills", abbreviation: "BUF" },
            5: { name: "Carolina Panthers", abbreviation: "CAR" },
            6: { name: "Chicago Bears", abbreviation: "CHI" },
            7: { name: "Cincinnati Bengals", abbreviation: "CIN" },
            8: { name: "Cleveland Browns", abbreviation: "CLE" },
            9: { name: "Dallas Cowboys", abbreviation: "DAL" },
            10: { name: "Denver Broncos", abbreviation: "DEN" },
            11: { name: "Detroit Lions", abbreviation: "DET" },
            12: { name: "Green Bay Packers", abbreviation: "GB" },
            13: { name: "Houston Texans", abbreviation: "HOU" },
            14: { name: "Indianapolis Colts", abbreviation: "IND" },
            15: { name: "Jacksonville Jaguars", abbreviation: "JAX" },
            16: { name: "Kansas City Chiefs", abbreviation: "KC" },
            17: { name: "Las Vegas Raiders", abbreviation: "LV" },
            18: { name: "Los Angeles Chargers", abbreviation: "LAC" },
            19: { name: "Los Angeles Rams", abbreviation: "LAR" },
            20: { name: "Miami Dolphins", abbreviation: "MIA" },
            21: { name: "Minnesota Vikings", abbreviation: "MIN" },
            22: { name: "New England Patriots", abbreviation: "NE" },
            23: { name: "New Orleans Saints", abbreviation: "NO" },
            24: { name: "New York Giants", abbreviation: "NYG" },
            25: { name: "New York Jets", abbreviation: "NYJ" },
            26: { name: "Philadelphia Eagles", abbreviation: "PHI" },
            27: { name: "Pittsburgh Steelers", abbreviation: "PIT" },
            28: { name: "San Francisco 49ers", abbreviation: "SF" },
            29: { name: "Seattle Seahawks", abbreviation: "SEA" },
            30: { name: "Tampa Bay Buccaneers", abbreviation: "TB" },
            31: { name: "Tennessee Titans", abbreviation: "TEN" },
            32: { name: "Washington Commanders", abbreviation: "WAS" }
        };

        initializePage();

        function initializePage() {
            const existingProtectedPlayers = @Html.Raw(Json.Serialize(Model.RosterSettingsProtectedPlayersIds));
            if (existingProtectedPlayers && existingProtectedPlayers.length > 0) {
                protectedPlayersArray = existingProtectedPlayers;
            }

            setupEventListeners();
            populateTeamsList();

            document.getElementById('protectedPerTeamInput').addEventListener('change', function() {
                protectedPerTeam = parseInt(this.value) || 3;
                updateSelectedCount();
                populateTeamsList();
            });
        }

        function setupEventListeners() {
            document.querySelectorAll('input[name="protectionMethod"]').forEach(radio => {
                radio.addEventListener('change', function() {
                    isManualProtection = this.value === 'manual';
                    const manualArea = document.getElementById('manualSelectionArea');

                    if (isManualProtection) {
                        manualArea.style.display = 'block';
                        populateTeamsList();
                    } else {
                        manualArea.style.display = 'none';
                        protectedPlayersArray = [];
                        updateProtectedPlayersHiddenFields();
                    }
                });
            });

            document.getElementById('clearTeamSelection').addEventListener('click', function() {
                if (currentTeamId !== null) {
                    clearTeamSelection(currentTeamId);
                }
            });

            document.getElementById('rosterSettingsForm').addEventListener('submit', function(e) {
                updateProtectedPlayersHiddenFields();
            });
        }

        function populateTeamsList() {
            const container = document.getElementById('franchisesList');
            container.innerHTML = '';

            Object.entries(teamNames).forEach(([teamId, teamInfo]) => {
                const teamIdInt = parseInt(teamId);
                const protectedCount = protectedPlayersArray.filter(playerId => {
                    return getPlayerTeamId(playerId) === teamIdInt;
                }).length;

                const listItem = document.createElement('a');
                listItem.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
                listItem.href = '#';
                listItem.setAttribute('data-team-id', teamId);

                const statusColor = protectedCount >= protectedPerTeam ? 'success' :
                                  protectedCount > 0 ? 'warning' : 'secondary';

                listItem.innerHTML = `
                    <div>
                        <div class="fw-bold">${teamInfo.name}</div>
                        <small class="text-muted">${teamInfo.abbreviation}</small>
                    </div>
                    <span class="badge bg-${statusColor}">${protectedCount}/${protectedPerTeam}</span>
                `;

                listItem.addEventListener('click', function(e) {
                    e.preventDefault();
                    selectTeam(teamIdInt);
                });

                container.appendChild(listItem);
            });

            updateSelectionProgress();
        }

        function selectTeam(teamId) {
            currentTeamId = teamId;

            document.querySelectorAll('#franchisesList .list-group-item').forEach(item => {
                item.classList.remove('active');
            });
            document.querySelector(`[data-team-id="${teamId}"]`).classList.add('active');

            const teamInfo = teamNames[teamId];
            document.getElementById('currentTeamName').textContent = `${teamInfo.name} (${teamInfo.abbreviation})`;

            document.getElementById('clearTeamSelection').style.display = 'inline-block';

            loadTeamPlayers(teamId);
        }

        function loadTeamPlayers(teamId) {
            const container = document.getElementById('playerSelectionArea');

            container.innerHTML = `
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2">Cargando jugadores...</p>
                </div>
            `;

            if (teamPlayersCache[teamId]) {
                displayPlayersForTeam(teamPlayersCache[teamId]);
                return;
            }

            fetch(`/Team/GetProtectablePlayers?FranchiseId=${teamId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(playersData => {
                    const teamData = createTeamDataFromJson(playersData, teamId);
                    nflTeams[teamId] = teamData;
                    teamPlayersCache[teamId] = teamData;
                    displayPlayersForTeam(teamData);
                })
                .catch(error => {
                    console.error('Error loading team players:', error);
                    container.innerHTML = `
                        <div class="text-center text-danger p-4">
                            <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                            <p>Error cargando jugadores. Por favor, pruebe de nuevo.</p>
                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="selectTeam(${teamId})">
                                <i class="fas fa-redo me-1"></i>Retry
                            </button>
                        </div>
                    `;
                });
        }

        function createTeamDataFromJson(playersData, teamId) {
            const teamInfo = teamNames[teamId] || { name: `Team ${teamId}`, abbreviation: `T${teamId}` };

            const teamData = {
                id: teamId,
                name: teamInfo.name,
                abbreviation: teamInfo.abbreviation,
                players: playersData
            };

            return teamData;
        }

        function displayPlayersForTeam(team) {
            const container = document.getElementById('playerSelectionArea');
            container.innerHTML = '';

            updateProtectedPlayersHiddenFields();
            updateSelectedCount();
            populateTeamsList();

            const playersByPosition = {};
            team.players.forEach(player => {
                if (!playersByPosition[player.position]) {
                    playersByPosition[player.position] = [];
                }
                playersByPosition[player.position].push(player);
            });

            Object.keys(playersByPosition).forEach(position => {
                const positionSection = document.createElement('div');
                positionSection.className = 'mb-4';
                positionSection.innerHTML = `
                    <h6 class="text-muted mb-3">${position}</h6>
                    <div class="row" id="position-${position}">
                    </div>
                `;

                const positionContainer = positionSection.querySelector(`#position-${position}`);

                playersByPosition[position].forEach(player => {
                    const isSelected = protectedPlayersArray.includes(player.id);
                    const playerDiv = document.createElement('div');
                    playerDiv.className = 'col-md-6 col-lg-4 mb-2';

                    playerDiv.innerHTML = `
                        <div class="card player-card ${isSelected ? 'selected' : ''}" data-player-id="${player.id}">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="flex-grow-1">
                                        <h6 class="card-title mb-1">${player.name}</h6>
                                        <p class="card-text mb-1">
                                            <small class="text-success fw-bold">${player.apy}</small>
                                        </p>
                                        <p class="card-text mb-0">
                                            <span class="badge bg-primary">${player.position}</span>
                                            ${player.defaultProtected ? '<span class="badge bg-warning ms-1" style="font-size: x-small;">Por Defecto</span>' : ''}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;

                    const card = playerDiv.querySelector('.player-card');
                    card.addEventListener('click', function() {
                        togglePlayerSelection(player.id, team.id);
                    });

                    positionContainer.appendChild(playerDiv);
                });

                container.appendChild(positionSection);
            });
        }

        function togglePlayerSelection(playerId, teamId) {
            const playerIndex = protectedPlayersArray.indexOf(playerId);
            const teamPlayers = protectedPlayersArray.filter(id => getPlayerTeamId(id) === teamId);

            if (playerIndex > -1) {
                protectedPlayersArray.splice(playerIndex, 1);
            } else {
                if (teamPlayers.length >= protectedPerTeam) {
                    alert(`You can only protect ${protectedPerTeam} players per team.`);
                    return;
                }
                protectedPlayersArray.push(playerId);
            }

            updatePlayerCardAppearance(playerId);
            updateSelectedCount();
            updateProtectedPlayersHiddenFields();
            populateTeamsList();
        }

        function updatePlayerCardAppearance(playerId) {
            const card = document.querySelector(`[data-player-id="${playerId}"]`);
            if (card) {
                const isProtected = protectedPlayersArray.includes(playerId);
                card.classList.toggle('selected', isProtected);
            }
        }

        function clearTeamSelection(teamId) {
            if(!teamPlayersCache[teamId]) return;
            
            teamPlayersCache[teamId].players.forEach(player => {
                const index = protectedPlayersArray.indexOf(player.id);
                if (index > -1) {
                    protectedPlayersArray.splice(index, 1);
                    $('[data-player-id="'+player.id+'"]').removeClass('selected');
                }
            });

            updateSelectedCount();
            updateProtectedPlayersHiddenFields();
            populateTeamsList();
        }

        function updateSelectedCount() {
            if (currentTeamId) {
                const teamPlayers = protectedPlayersArray.filter(id => getPlayerTeamId(id) === currentTeamId);
                document.getElementById('selectedCount').textContent = `${teamPlayers.length}/${protectedPerTeam} seleccionados`;
            }
        }

        function updateSelectionProgress() {
            const teamsWithSelections = Object.keys(teamNames).filter(teamId => {
                const teamIdInt = parseInt(teamId);
                const teamPlayers = protectedPlayersArray.filter(id => getPlayerTeamId(id) === teamIdInt);
                return teamPlayers.length > 0;
            }).length;

            const progressPercentage = (teamsWithSelections / 32) * 100;
            document.getElementById('selectionProgress').style.width = `${progressPercentage}%`;
            document.getElementById('franchisesWithSelections').textContent = teamsWithSelections;
        }

        function updateProtectedPlayersHiddenFields() {
            const existingInputs = document.querySelectorAll('input[name^="RosterSettingsProtectedPlayersIds["]');
            existingInputs.forEach(input => input.remove());

            const form = document.getElementById('rosterSettingsForm');
            protectedPlayersArray.forEach((playerId, index) => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = `RosterSettingsProtectedPlayersIds[${index}]`;
                input.value = playerId;
                form.appendChild(input);
            });
        }

        function getPlayerTeamId(playerId) {
            for (const [teamId, teamData] of Object.entries(nflTeams)) {
                if (teamData.players && teamData.players.some(player => player.id === playerId)) {
                    return parseInt(teamId);
                }
            }

            for (const [teamId, teamData] of Object.entries(teamPlayersCache)) {
                if (teamData.players && teamData.players.some(player => player.id === playerId)) {
                    return parseInt(teamId);
                }
            }

            return null;
        }
    });
</script>