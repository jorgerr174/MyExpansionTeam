@model METCore.DTOs.Team.TeamDto

<div class="container-fluid">
    <div class="row">
        <!-- Team Header Card -->
        <div class="col-12 mb-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">@Model.Location @Model.Mascot</h4>
                        <span class="badge bg-light text-primary fs-6">@Model.Abb</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Owner:</strong> <span class="text-muted">@Model.UserUsername</span></p>
                            <p class="mb-0"><strong>Created:</strong> <span class="text-muted">@Model.Date.ToString("MMM dd, yyyy")</span></p>
                        </div>
                        <div class="col-md-6">
                            <div class="text-md-end">
                                @if (Model.Complete)
                                {
                                    <span class="badge bg-success fs-6">Team Complete</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning fs-6">Setup Required</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Team Information Cards -->
        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Team Information</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">Location</label>
                        <p class="mb-0">@Model.Location</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">Mascot</label>
                        <p class="mb-0">@Model.Mascot</p>
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-bold text-muted">Abbreviation</label>
                        <p class="mb-0">@Model.Abb</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Roster Settings Card -->
        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Roster Settings</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">Salary Cap %</label>
                        <p class="mb-0">@Model.RosterSettingsCap.ToString("N0")</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">Max Players Per Team</label>
                        <p class="mb-0">@Model.RosterSettingsMaxPerTeam players</p>
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-bold text-muted">Protected Players Per Team</label>
                        <p class="mb-0">@Model.RosterSettingsProtectedPerTeam players</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2 justify-content-between">
                        <div class="d-flex flex-wrap gap-2">
                            @if (Model.UserUsername == User?.Identity?.Name)
                            {
                                <a asp-controller="Team" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                                    <i class="fas fa-edit me-1"></i>Edit Team
                                </a>
                                <a asp-controller="Team" asp-action="RosterSettings" asp-route-id="@Model.Id" class="btn btn-success btn-sm">
                                    <i class="fas fa-cog me-1"></i>Roster Settings
                                </a>
                                <a asp-controller="Team" asp-action="EditRoster" asp-route-id="@Model.Id" class="btn btn-info btn-sm">
                                    <i class="fas fa-users me-1"></i>Build Roster
                                </a>
                            }
                        </div>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-arrow-left me-1"></i>Back to Teams
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Team Roster Overview -->
        <div class="col-12 mb-3">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="fas fa-users me-2"></i>Team Roster Overview
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Position Filters -->
                    <div class="mb-3">
                        <div class="btn-group" role="group" id="rosterPositionFilters">
                            <button type="button" class="btn btn-outline-primary btn-sm active" data-position="all">All</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-position="QB">QB</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-position="HB">HB</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-position="WR">WR</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-position="TE">TE</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-position="OL">OL</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-position="DL">DL</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-position="LB">LB</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-position="DB">DB</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-position="P/K">P/K</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-position="PR/KR">PR/KR</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-position="LS">LS</button>
                        </div>
                    </div>

                    <!-- Roster Display -->
                    <div id="rosterDisplay" style="max-height: 500px; overflow-y: auto; overflow-x: hidden;">
                        <div class="text-center text-muted p-4">
                            <i class="fas fa-users fa-2x mb-3"></i>
                            <p>Loading roster...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Formation & Starters Overview -->
        <div class="col-12 mb-3">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-chess-board me-2"></i>Formation & Starters
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Formation Type Selector -->
                    <div class="mb-3">
                        <div class="btn-group" role="group" id="formationSelector">
                            <button type="button" class="btn btn-outline-primary active" data-formation="offense">
                                <i class="fas fa-football-ball me-1"></i>Offense
                            </button>
                            <button type="button" class="btn btn-outline-primary" data-formation="defense">
                                <i class="fas fa-shield-alt me-1"></i>Defense
                            </button>
                            <button type="button" class="btn btn-outline-primary" data-formation="special">
                                <i class="fas fa-star me-1"></i>Special Teams
                            </button>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Formation Display -->
                        <div class="col-md-8">
                            <h6 class="mb-3">Current Formation: <span id="currentFormationName" class="text-primary">Loading...</span></h6>
                            <div id="formationDisplay" style="position: relative; height: 400px; background: linear-gradient(to bottom, #228B22 0%, #32CD32 50%, #228B22 100%); border-radius: 8px;">
                                <div class="text-center text-white p-5">
                                    <i class="fas fa-football-ball fa-2x mb-3"></i>
                                    <p>Loading formation...</p>
                                </div>
                            </div>
                        </div>

                        <!-- Bench Players -->
                        <div class="col-md-4">
                            <h6 class="mb-3">Bench Players</h6>
                            <div id="benchDisplay" style="max-height: 400px; overflow-y: auto;" class="bg-light p-3 rounded">
                                <div class="text-center text-muted p-3">
                                    <i class="fas fa-clock fa-2x mb-3"></i>
                                    <p>Loading bench players...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Trade History -->
        <div class="col-12 mb-3">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-exchange-alt me-2"></i>Trade History
                    </h5>
                </div>
                <div class="card-body">
                    <div id="tradeHistoryDisplay" style="max-height: 400px; overflow-y: auto;">
                        <div class="text-center text-muted p-4">
                            <i class="fas fa-handshake fa-2x mb-3"></i>
                            <p>Loading trade history...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Draft Results -->
        <div class="col-12 mb-3">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-trophy me-2"></i>Draft Results
                    </h5>
                </div>
                <div class="card-body">
                    <div id="draftResultsDisplay" style="overflow-y: auto;">
                        <div class="text-center text-muted p-4">
                            <i class="fas fa-award fa-2x mb-3"></i>
                            <p>Loading draft results...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

