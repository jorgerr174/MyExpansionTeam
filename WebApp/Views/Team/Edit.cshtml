@model METCore.DTOs.Team.TeamBasicInfoDto

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <!-- Team Header Card -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">Edit Team: @Model.Location @Model.Mascot</h4>
                        <span class="badge bg-light text-primary fs-6">@Model.Abb</span>
                    </div>
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Owner:</strong> <span class="text-muted">@Model.UserUsername</span></p>
                    <p class="mb-0"><strong>Created:</strong> <span class="text-muted">@Model.Date.ToString("MMM dd, yyyy")</span></p>
                </div>
            </div>

            <!-- Edit Team Information Card -->
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Team Information</h5>
                </div>
                <div class="card-body">
                    <form asp-action="EditTeam" method="post">
                        @Html.HiddenFor(m => m.Id)
                        @Html.HiddenFor(m => m.Complete)
                        @Html.HiddenFor(m => m.UserUsername)
                        @Html.HiddenFor(m => m.Date)
                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Location, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Location, new { @class = "form-control", placeholder = "Enter team location (e.g., New York)" })
                            @Html.ValidationMessageFor(m => m.Location, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Mascot, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Mascot, new { @class = "form-control", placeholder = "Enter team mascot (e.g., Yankees)" })
                            @Html.ValidationMessageFor(m => m.Mascot, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(m => m.Abb, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Abb, new { @class = "form-control", placeholder = "Enter abbreviation (e.g., NYY)", maxlength = "5" })
                            @Html.ValidationMessageFor(m => m.Abb, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Details", "Team", new { id = Model.Id })" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-1"></i>Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Team Management Actions Card -->
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Team Management</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <a class="btn btn-info w-100" href="@Url.RouteUrl("EditSettings", new { Id = Model.Id })">
                                <i class="fas fa-cog me-1"></i>Edit Settings
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a class="btn btn-info w-100" href="@Url.RouteUrl("EditRoster", new { Id = Model.Id })">
                                <i class="fas fa-users me-1"></i>Edit Roster
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Advanced Actions Card -->
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">Advanced Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <form asp-action="DuplicateTeam" method="post" class="w-100">
                                @Html.HiddenFor(m => m.Id)
                                <button type="submit" class="btn btn-outline-primary w-100">
                                    <i class="fas fa-copy me-1"></i>Duplicate Team
                                </button>
                            </form>
                        </div>
                        <div class="col-md-6">
                            <button type="button" class="btn btn-outline-danger w-100" onclick="confirmDelete(event)">
                                <i class="fas fa-trash me-1"></i>Delete Team
                            </button>
                        </div>
                    </div>
                    <div class="mt-3">
                        <small class="text-muted">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            Warning: These actions cannot be undone. Please proceed with caution.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmDelete(event) {
        event.preventDefault();
        if (confirm('Are you sure you want to delete this team? This action cannot be undone.')) {
            window.location.href = '@Url.Action("DeleteTeam", "Team", new { TeamId = @Model.Id })';
        }
    }
</script>