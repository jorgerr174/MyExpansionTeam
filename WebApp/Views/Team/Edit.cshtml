@model METCore.DTOs.Team.TeamBasicInfoDto

<form asp-action="EditTeam" method="post">
    <h1>@Model.Location @Model.Mascot</h1>
    <h4>@User?.Identity?.Name</h4>
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.Complete)
    @Html.HiddenFor(m => m.UserUsername)
    @Html.HiddenFor(m => m.Date)

	@Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Date)</dt>
        <dd class="col-sm-10">@Model.Date.ToString("dd/MM/yyyy")</dd>
    </div>
    <hr />

    <div class="form-group">
		@Html.ValidationMessageFor(m => m.Location, "", new { @class = "text-danger" })
		@Html.LabelFor(m => m.Location, htmlAttributes: new { @class = "control-label" })
        @Html.TextBoxFor(m => m.Location, new { @class = "form-control" })
	</div>

    <div class="form-group">
        @Html.LabelFor(m => m.Abb, htmlAttributes: new { @class = "control-label" })
        @Html.TextBoxFor(m => m.Abb, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Abb, "", new { @class = "text-danger" })
    </div>
	
    <div class="form-group">
		@Html.ValidationMessageFor(m => m.Mascot, "", new { @class = "text-danger" })
		@Html.LabelFor(m => m.Mascot, new { @class = "control-label" })
        @Html.TextBoxFor(m => m.Mascot, new { @class = "form-control" })
    </div>

    <div class="row justify-content-between">
		<button type="submit" class="btn btn-primary col-3">Guardar Info</button>
        <a class="btn btn-info col-3" href="@Url.RouteUrl("EditSettings", new { Id = Model.Id })">Editar ajustes</a>
        <a class="btn btn-info col-3" href="@Url.RouteUrl("EditRoster", new { Id = Model.Id })">Editar plantilla</a>
    </div>
    <div class="row justify-content-around">
        <button type="submit" class="btn btn-outline-primary col-3" asp-action="DuplicateTeam">Duplicar equipo</button>
		<a class="btn btn-danger col-3" href="#" onclick="confirmDelete(event)">Borrar equioo</a>
    </div>
</form>

<script>
    function confirmDelete(event)
    {
        event.preventDefault();
        if (confirm('¿Está seguro de que desea eliminar este equipo?'))
            window.location.href = '@Url.Action("DeleteTeam", "Team", new { TeamId = @Model.Id })';
    }
</script>