@model METCore.DTOs.Team.TeamBasicInfoDto

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">Editar Información: @Model.Location @Model.Mascot</h4>
                        <span class="badge bg-light text-primary fs-6">@Model.Abb</span>
                    </div>
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>@Html.LabelFor(m => m.UserUsername):</strong> <span class="text-muted">@Html.DisplayFor(m => m.UserUsername)</span></p>
                    <p class="mb-0"><strong>@Html.LabelFor(m => m.Date):</strong> <span class="text-muted">@Html.DisplayFor(m => m.Date)</span></p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Información</h5>
                </div>
                <div class="card-body">
                    <form asp-action="EditTeam" method="post">
                        @Html.HiddenFor(m => m.Id)
                        @Html.HiddenFor(m => m.Complete)
                        @Html.HiddenFor(m => m.UserUsername)
                        @Html.HiddenFor(m => m.Date)
                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Location, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Location, new { @class = "form-control", placeholder = "Introduzca la ubicación (p.ej., New York)" })
                            @Html.ValidationMessageFor(m => m.Location, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Mascot, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Mascot, new { @class = "form-control", placeholder = "Introduzca la mascota (p.ej., Giants)" })
                            @Html.ValidationMessageFor(m => m.Mascot, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(m => m.Abb, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Abb, new { @class = "form-control", placeholder = "Introduzca la abreviatura (e.g., NYG)", maxlength = "5" })
                            @Html.ValidationMessageFor(m => m.Abb, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Details", "Team", new { id = Model.Id })" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-1"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Administración del Equipo</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <a class="btn btn-info w-100" href="@Url.RouteUrl("EditSettings", new { Id = Model.Id })">
                                <i class="fas fa-cog me-1"></i>Editar Ajustes del Equipo
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a class="btn btn-info w-100" href="@Url.RouteUrl("EditRoster", new { Id = Model.Id })">
                                <i class="fas fa-users me-1"></i>Editar Plantilla
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">Acciones Avanzadas</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <button type="button" class="btn btn-outline-primary w-100" onclick="confirmDuplicate(event)">
                                <i class="fas fa-copy me-1"></i>Duplicar Equipo
                            </button>
                        </div>
                        <div class="col-md-6">
                            <button type="button" class="btn btn-outline-danger w-100" onclick="confirmDelete(event)">
                                <i class="fas fa-trash me-1"></i>Borrar Equipo
                            </button>
                        </div>
                    </div>
                    <div class="mt-3">
						<small class="text-muted bg-warning-subtle">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            Atención: Estas acciones no se podrán deshacer. Proceder con precaución.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmDuplicate(event) {
        event.preventDefault();
        if (confirm('¿Estás seguro de que deseas duplicar este equipo?')) {
            window.location.href = '@Url.Action("DuplicateTeam", "Team", new { TeamId = @Model.Id })';
        }
    }
    function confirmDelete(event) {
        event.preventDefault();
        if (confirm('¿Estás seguro de que deseas borrar este equipo? Esta acción no se podrá deshacer.')) {
            window.location.href = '@Url.Action("DeleteTeam", "Team", new { TeamId = @Model.Id })';
        }
    }
</script>