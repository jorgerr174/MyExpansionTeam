@model METCore.DTOs.Team.DraftDto

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h2>NFL Draft Configuration - @Model.Location @Model.Mascot</h2>

            <!-- Phase Navigation -->
            <ul class="nav nav-pills mb-4" id="phaseNavigation" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="settings-tab" data-bs-toggle="pill" data-bs-target="#settings-phase" type="button" role="tab">
                        <i class="fas fa-cog me-2"></i>Draft Settings
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link disabled" id="draft-tab" data-bs-toggle="pill" data-bs-target="#draft-phase" type="button" role="tab" disabled>
                        <i class="fas fa-trophy me-2"></i>Draft Simulation
                        <span class="badge bg-secondary ms-2" id="current-pick">Pick 1</span>
                    </button>
                </li>
            </ul>

            <form asp-action="SaveDraft" method="post" id="draftForm">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.Location)
                @Html.HiddenFor(m => m.Mascot)
                @Html.HiddenFor(m => m.Abb)
                @Html.HiddenFor(m => m.UserUsername)
                @Html.HiddenFor(m => m.Date)
                @Html.HiddenFor(m => m.Complete)

                <!-- Hidden field for selected franchises to control -->
                <input type="hidden" id="selectedFranchises" name="SelectedFranchises" value="" />
                
                <!-- Hidden field for team's draft selections (IDictionary<int,int>) -->
                <input type="hidden" id="draftSelections" name="Selections" value="" />

                <!-- Hidden field for all picks data (IList<int>[]) -->
                <input type="hidden" id="allPicksData" name="Picks" value="" />

                <div class="tab-content">
                    <!-- Phase 1: Draft Settings Configuration -->
                    <div class="tab-pane fade show active" id="settings-phase" role="tabpanel">
                        <div class="card">
                            <div class="card-header">
                                <h4>Configure Draft Participation</h4>
                                <p class="text-muted mb-0">Set up how you want to participate in the NFL draft</p>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group mb-3">
                                            @Html.LabelFor(m => m.Rounds, "Manual Rounds", new { @class = "form-label" })
                                            @Html.TextBoxFor(m => m.Rounds, new { @class = "form-control", @type = "number", @min = "0", @max = "7" })
                                            @Html.ValidationMessageFor(m => m.Rounds, "", new { @class = "text-danger" })
                                            <div class="form-text">Rounds you want to control manually (0 = full simulation, 7 = control all)</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group mb-3">
                                            <label for="Speed" class="form-label">Simulation Speed</label>
                                            <select id="Speed" name="Speed" class="form-select">
                                                <option value="instant">Instant</option>
                                                <option value="fast">Fast (0.5s per pick)</option>
                                                <option value="normal" selected>Normal (1s per pick)</option>
                                                <option value="slow">Slow (2s per pick)</option>
                                            </select>
                                            <div class="form-text">Speed of automated picks during simulation</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Draft Control Method Selection -->
                                <div class="card bg-light mb-4">
                                    <div class="card-header">
                                        <h5 class="mb-0">Draft Control Method</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="draftMethod" id="draftMethodFull" value="full" checked>
                                                    <label class="form-check-label" for="draftMethodFull">
                                                        <strong>Full Simulation</strong><br>
                                                        <small class="text-muted">Watch the entire draft unfold automatically</small>
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="draftMethod" id="draftMethodMyTeam" value="myteam">
                                                    <label class="form-check-label" for="draftMethodMyTeam">
                                                        <strong>Control My Team</strong><br>
                                                        <small class="text-muted">Make picks for @Model.Location @Model.Mascot only</small>
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="draftMethod" id="draftMethodMultiple" value="multiple">
                                                    <label class="form-check-label" for="draftMethodMultiple">
                                                        <strong>Control Multiple Teams</strong><br>
                                                        <small class="text-muted">Select which teams you want to control</small>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Multiple Team Selection (Hidden by default) -->
                                <div id="multipleTeamSelection" class="card mb-4" style="display: none;">
                                    <div class="card-header">
                                        <h5 class="mb-0">Select Teams to Control</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row" id="franchiseCheckboxes">
                                            <!-- Franchise checkboxes will be populated by JavaScript -->
                                        </div>
                                    </div>
                                </div>

                                <!-- Additional Settings -->
                                <div class="card mb-4">
                                    <div class="card-header">
                                        <h5 class="mb-0">Additional Settings</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="enableTrading" checked>
                                            <label class="form-check-label" for="enableTrading">
                                                Enable Draft Day Trading
                                            </label>
                                            <div class="form-text">Allow trading picks and players during the draft</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Draft Preview -->
                                <div class="card mb-4">
                                    <div class="card-header">
                                        <h5 class="mb-0">Draft Configuration Summary</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <p><strong>Control Method:</strong> <span id="manualDescription">Full simulation</span></p>
                                                <p><strong>Trading:</strong> <span id="tradingStatus">Enabled</span></p>
                                            </div>
                                            <div class="col-md-6">
                                                <p><strong>Your Draft Picks:</strong> <span id="teamPicksCount">Loading...</span></p>
                                                <p><strong>Next Pick:</strong> <span id="nextPickInfo">Loading...</span></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-flex justify-content-between">
                                    <button type="button" class="btn btn-secondary" onclick="history.back()">
                                        <i class="fas fa-arrow-left me-2"></i>Back
                                    </button>
                                    <button type="button" class="btn btn-primary btn-lg" id="startDraftButton">
                                        <i class="fas fa-play me-2"></i>Start Draft Simulation
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Phase 2: Draft Simulation -->
                    <div class="tab-pane fade" id="draft-phase" role="tabpanel">
                        <div class="row">
                            <!-- Draft Order Column -->
                            <div class="col-md-4">
                                <div class="card">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">Draft Order</h5>
                                        <button type="button" class="btn btn-success btn-sm" id="tradingButton" style="display: none;">
                                            <i class="fas fa-exchange-alt me-1"></i>Trade
                                        </button>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="draft-order-container" style="max-height: 600px; overflow-y: auto;">
                                            <div id="draftOrderList">
                                                <!-- Draft order will be populated by JavaScript -->
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Player Selection Column -->
                            <div class="col-md-8">
                                <div class="card">
                                    <div class="card-header">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h5 class="mb-0">Available Players</h5>
                                            <div class="d-flex align-items-center">
                                                <label for="positionFilter" class="form-label me-2 mb-0">Filter:</label>
                                                <select id="positionFilter" class="form-select form-select-sm" style="width: auto;">
                                                    <option value="all">All Positions</option>
                                                    <option value="QB">Quarterback</option>
                                                    <option value="RB">Running Back</option>
                                                    <option value="WR">Wide Receiver</option>
                                                    <option value="TE">Tight End</option>
                                                    <option value="OL">Offensive Line</option>
                                                    <option value="DL">Defensive Line</option>
                                                    <option value="LB">Linebacker</option>
                                                    <option value="DB">Defensive Back</option>
                                                    <option value="K">Kicker</option>
                                                    <option value="P">Punter</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body p-0">
                                        <div id="currentPickInfo" class="alert alert-info m-3" style="display: none;">
                                            <!-- Current pick information -->
                                        </div>
                                        <div class="players-container" style="max-height: 600px; overflow-y: auto;">
                                            <div id="availablePlayersList">
                                                <!-- Available players will be populated by JavaScript -->
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Save Button -->
                <div class="mt-4 text-center" style="display: none;" id="saveSection">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="fas fa-save me-2"></i>Save Draft Results
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bootstrap and jQuery -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function () {
        // State variables
        let selectedFranchises = []; // Array of franchise IDs for multiple team control
        let draftMethod = 'full';
        let draftOrder = [];
        let currentPickIndex = 0;
        let availablePlayersData = [];
        let isUserControlled = false;
        let enableTrading = true;
        let manualRounds = 0;
        let currentPositionFilter = 'all';
        let simulationSpeed = 'normal';
        let isDraftActive = false;
        let teamDraftSelections = new Map(); // Team selections: pickNumber -> playerId
        let userControlledPicks = []; // List of picks user needs to make
        let franchiseControlledPicks = []; // List of picks for other franchises user controls
        let franchiseDraftOrder = []; // Array of 32 franchises with draft positions and needs
        let allPicksData = []; // IList<int>[] containing picks for all 33 entities (0=team, 1-32=franchises)

        // NFL Franchises using enum values (1-32)
        const nflFranchises = {
            1: { name: "Arizona Cardinals", abbreviation: "ARIZ" },
            2: { name: "Atlanta Falcons", abbreviation: "ATL" },
            3: { name: "Baltimore Ravens", abbreviation: "BAL" },
            4: { name: "Buffalo Bills", abbreviation: "BUF" },
            5: { name: "Carolina Panthers", abbreviation: "CAR" },
            6: { name: "Chicago Bears", abbreviation: "CHI" },
            7: { name: "Cincinnati Bengals", abbreviation: "CIN" },
            8: { name: "Cleveland Browns", abbreviation: "CLE" },
            9: { name: "Dallas Cowboys", abbreviation: "DAL" },
            10: { name: "Denver Broncos", abbreviation: "DEN" },
            11: { name: "Detroit Lions", abbreviation: "DET" },
            12: { name: "Green Bay Packers", abbreviation: "GB" },
            13: { name: "Houston Texans", abbreviation: "HOU" },
            14: { name: "Indianapolis Colts", abbreviation: "IND" },
            15: { name: "Jacksonville Jaguars", abbreviation: "JAX" },
            16: { name: "Kansas City Chiefs", abbreviation: "KC" },
            17: { name: "Las Vegas Raiders", abbreviation: "LV" },
            18: { name: "Los Angeles Chargers", abbreviation: "LAC" },
            19: { name: "Los Angeles Rams", abbreviation: "LAR" },
            20: { name: "Miami Dolphins", abbreviation: "MIA" },
            21: { name: "Minnesota Vikings", abbreviation: "MIN" },
            22: { name: "New England Patriots", abbreviation: "NE" },
            23: { name: "New Orleans Saints", abbreviation: "NO" },
            24: { name: "New York Giants", abbreviation: "NYG" },
            25: { name: "New York Jets", abbreviation: "NYJ" },
            26: { name: "Philadelphia Eagles", abbreviation: "PHI" },
            27: { name: "Pittsburgh Steelers", abbreviation: "PIT" },
            28: { name: "San Francisco 49ers", abbreviation: "SF" },
            29: { name: "Seattle Seahawks", abbreviation: "SEA" },
            30: { name: "Tampa Bay Buccaneers", abbreviation: "TB" },
            31: { name: "Tennessee Titans", abbreviation: "TEN" },
            32: { name: "Washington Commanders", abbreviation: "WAS" }
        };

        // Initialize page
        initializeSelections();
        initializeAllPicksData();
        initializeSelectedFranchises();
        updateDraftPreview();
        setupEventHandlers();
        displayTeamPicksInfo();

        // Initialize team draft selections from model
        function initializeSelections() {
            teamDraftSelections.clear();
            
            // Parse Selections dictionary from model if it exists
            if (@Html.Raw(Json.Serialize(Model.Selections)) && Object.keys(@Html.Raw(Json.Serialize(Model.Selections))).length > 0) {
                const selections = @Html.Raw(Json.Serialize(Model.Selections));
                Object.entries(selections).forEach(([pickNumber, playerId]) => {
                    teamDraftSelections.set(parseInt(pickNumber), parseInt(playerId));
                });
            }
        }

        // Initialize all picks data from model
        function initializeAllPicksData() {
            // Parse Picks array from model if it exists
            if (@Html.Raw(Json.Serialize(Model.Picks))) {
                allPicksData = @Html.Raw(Json.Serialize(Model.Picks));
            } else {
                // If no picks data, initialize with empty arrays
                allPicksData = new Array(33).fill(null).map(() => []);
            }
        }

        // Update hidden fields with current selections and picks data
        function updateHiddenFields() {
            // Update Selections hidden field (IDictionary<int,int>)
            const selectionsObj = {};
            teamDraftSelections.forEach((playerId, pickNumber) => {
                selectionsObj[pickNumber] = playerId;
            });
            document.getElementById('draftSelections').value = JSON.stringify(selectionsObj);

            // Update Picks hidden field (IList<int>[])
            document.getElementById('allPicksData').value = JSON.stringify(allPicksData);
        }

        // Initialize selected franchises
        function initializeSelectedFranchises() {
            const hiddenField = document.getElementById('selectedFranchises');
            const value = hiddenField.value.trim();
            selectedFranchises = value ? value.split(',').map(id => parseInt(id)) : [];
            
            // Update checkboxes if they exist
            selectedFranchises.forEach(franchiseId => {
                const checkbox = document.getElementById(`franchise_${franchiseId}`);
                if (checkbox) checkbox.checked = true;
            });
        }

        // Setup event handlers
        function setupEventHandlers() {
            // Settings event handlers
            document.getElementById('Rounds').addEventListener('change', updateDraftPreview);
            document.getElementById('Speed').addEventListener('change', updateDraftPreview);

            document.querySelectorAll('input[name="draftMethod"]').forEach(radio => {
                radio.addEventListener('change', function() {
                    draftMethod = this.value;
                    updateDraftPreview();
                    toggleMultipleTeamSelection();
                });
            });

            document.getElementById('enableTrading').addEventListener('change', function() {
                enableTrading = this.checked;
                updateDraftPreview();
            });

            // Start draft button
            document.getElementById('startDraftButton').addEventListener('click', function () {
                if (validateSettings()) {
                    startDraftSimulation();
                }
            });

            // Position filter
            document.getElementById('positionFilter').addEventListener('change', function() {
                currentPositionFilter = this.value;
                displayAvailablePlayers();
            });
        }

        // Display team picks information
        function displayTeamPicksInfo() {
            if (allPicksData.length > 0 && allPicksData[0]) {
                const teamPicks = allPicksData[0]; // Index 0 is for the team
                document.getElementById('teamPicksCount').textContent = `${teamPicks.length} picks`;
                
                if (teamPicks.length > 0) {
                    const nextPickRpp = teamPicks[0]; // rpp format
                    const round = Math.floor(nextPickRpp / 100);
                    const pickInRound = nextPickRpp % 100;
                    const overallPick = ((round - 1) * 32) + pickInRound;
                    document.getElementById('nextPickInfo').textContent = `Round ${round}, Pick ${pickInRound} (Overall #${overallPick})`;
                } else {
                    document.getElementById('nextPickInfo').textContent = 'No picks available';
                }
            } else {
                document.getElementById('teamPicksCount').textContent = 'Loading...';
                document.getElementById('nextPickInfo').textContent = 'Loading...';
            }
        }

        // Toggle multiple team selection visibility
        function toggleMultipleTeamSelection() {
            const multipleSection = document.getElementById('multipleTeamSelection');
            if (draftMethod === 'multiple') {
                multipleSection.style.display = 'block';
                generateFranchiseCheckboxes();
            } else {
                multipleSection.style.display = 'none';
            }
        }

        // Generate franchise checkboxes
        function generateFranchiseCheckboxes() {
            const container = document.getElementById('franchiseCheckboxes');
            container.innerHTML = '';

            Object.entries(nflFranchises).forEach(([id, franchise]) => {
                const colDiv = document.createElement('div');
                colDiv.className = 'col-md-4 col-sm-6 mb-2';
                
                const checkDiv = document.createElement('div');
                checkDiv.className = 'form-check';
                
                const checkbox = document.createElement('input');
                checkbox.className = 'form-check-input';
                checkbox.type = 'checkbox';
                checkbox.id = `franchise_${id}`;
                checkbox.value = id;
                checkbox.checked = selectedFranchises.includes(parseInt(id));
                
                checkbox.addEventListener('change', function() {
                    if (this.checked) {
                        if (!selectedFranchises.includes(parseInt(id))) {
                            selectedFranchises.push(parseInt(id));
                        }
                    } else {
                        selectedFranchises = selectedFranchises.filter(fId => fId !== parseInt(id));
                    }
                    updateSelectedFranchisesHiddenField();
                    updateDraftPreview();
                });
                
                const label = document.createElement('label');
                label.className = 'form-check-label';
                label.setAttribute('for', `franchise_${id}`);
                label.textContent = `${franchise.name} (${franchise.abbreviation})`;
                
                checkDiv.appendChild(checkbox);
                checkDiv.appendChild(label);
                colDiv.appendChild(checkDiv);
                container.appendChild(colDiv);
            });
        }

        // Update selected franchises hidden field
        function updateSelectedFranchisesHiddenField() {
            document.getElementById('selectedFranchises').value = selectedFranchises.join(',');
        }

        // Update draft preview
        function updateDraftPreview() {
            manualRounds = parseInt(document.getElementById('Rounds').value) || 0;
            simulationSpeed = document.getElementById('Speed').value || 'normal';
            
            let manualDescription = '';
            if (draftMethod === 'full') {
                manualDescription = 'Full simulation - watch the entire draft';
            } else if (draftMethod === 'myteam') {
                manualDescription = manualRounds === 0 ? 'Auto-pick for your team' :
                                 manualRounds === 7 ? 'Manual control for all your picks' :
                                 `Manual control for ${manualRounds} rounds`;
            } else if (draftMethod === 'multiple') {
                manualDescription = `Manual control for ${selectedFranchises.length} selected teams (${manualRounds} rounds)`;
            }

            document.getElementById('manualDescription').textContent = manualDescription;
            document.getElementById('tradingStatus').textContent = enableTrading ? 'Enabled' : 'Disabled';
        }

        // Validate settings
        function validateSettings() {
            const rounds = parseInt(document.getElementById('Rounds').value);
            if (rounds < 0 || rounds > 7) {
                alert('Manual rounds must be between 0 and 7');
                return false;
            }

            if (draftMethod === 'multiple' && selectedFranchises.length === 0) {
                alert('Please select at least one team to control');
                return false;
            }

            return true;
        }

        // Start draft simulation
        function startDraftSimulation() {
            isDraftActive = true;
            simulationSpeed = document.getElementById('Speed').value || 'normal';

            // Enable draft tab
            const draftTab = document.getElementById('draft-tab');
            draftTab.classList.remove('disabled');
            draftTab.disabled = false;

            const tab = new bootstrap.Tab(draftTab);
            tab.show();

            // Show/hide trading button based on settings
            const tradingButton = document.getElementById('tradingButton');
            tradingButton.style.display = enableTrading ? 'inline-block' : 'none';

            // Initialize draft data
            initializeDraftData();
        }

        // Initialize draft data
        function initializeDraftData() {
            // Use the picks data we already have from the model
            loadDraftOrderFromPicksData();

            // Load prospects
            fetch('/Team/GetDraftProspects')
            .then(response => response.json())
            .then(prospects => {
                availablePlayersData = prospects;
                displayAvailablePlayers();
                
                // Start draft processing
                processDraftPick();
            });
        }

        // Load draft order from picks data
        function loadDraftOrderFromPicksData() {
            draftOrder = [];
            
            // Create a map of all picks to see the order
            const allPicks = [];
            
            // Add all picks from all entities (team + 32 franchises)
            for (let i = 0; i < allPicksData.length; i++) {
                if (allPicksData[i] && allPicksData[i].length > 0) {
                    allPicksData[i].forEach(pickNum => {
                        // Convert rpp format to overall pick number
                        const round = Math.floor(pickNum / 100);
                        const pickInRound = pickNum % 100;
                        const overallPick = ((round - 1) * 32) + pickInRound;
                        
                        allPicks.push({
                            pickNumber: overallPick,
                            rppNumber: pickNum, // Keep original rpp format
                            round: round,
                            pickInRound: pickInRound,
                            entityIndex: i,
                            isTeam: i === 0,
                            franchiseId: i === 0 ? parseInt('@Model.Id') : i
                        });
                    });
                }
            }
            
            // Sort by overall pick number
            allPicks.sort((a, b) => a.pickNumber - b.pickNumber);
            
            // Create draft order
            allPicks.forEach(pick => {
                let teamName, teamAbbr;
                if (pick.isTeam) {
                    teamName = '@Model.Location @Model.Mascot';
                    teamAbbr = '@Model.Abb';
                } else {
                    const franchise = nflFranchises[pick.franchiseId];
                    teamName = franchise ? franchise.name : `Team ${pick.franchiseId}`;
                    teamAbbr = franchise ? franchise.abbreviation : `T${pick.franchiseId}`;
                }

                draftOrder.push({
                    overall: pick.pickNumber,
                    rppFormat: pick.rppNumber, // Store rpp format for reference
                    round: pick.round,
                    pickInRound: pick.pickInRound,
                    teamId: pick.franchiseId,
                    teamName: teamName,
                    teamAbbr: teamAbbr,
                    isUserControlled: shouldControlPick(pick),
                    selectedPlayer: null,
                    neededPositions: [] // This could be enhanced with actual team needs
                });
            });

            displayDraftOrder();
        }

        // Determine if user should control this pick
        function shouldControlPick(pick) {
            if (draftMethod === 'full') return false;
            if (draftMethod === 'myteam') return pick.isTeam;
            if (draftMethod === 'multiple') {
                return pick.isTeam || selectedFranchises.includes(pick.franchiseId);
            }
            return false;
        }

        // Display draft order
        function displayDraftOrder() {
            const container = document.getElementById('draftOrderList');
            container.innerHTML = '';

            draftOrder.forEach((pick, index) => {
                const pickDiv = document.createElement('div');
                pickDiv.className = `draft-pick-item p-3 border-bottom ${index === currentPickIndex ? 'bg-primary text-white' : ''} ${pick.isUserControlled ? 'border-start border-warning border-3' : ''}`;
                pickDiv.id = `pick-${index}`;

                const isSelected = pick.selectedPlayer !== null;
                const playerName = isSelected ? pick.selectedPlayer.name : '';
                const playerPosition = isSelected ? pick.selectedPlayer.position : '';

                pickDiv.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>#${pick.overall}</strong> - ${pick.teamAbbr}
                            <br><small>Round ${pick.round}, Pick ${pick.pickInRound}</small>
                            ${pick.isUserControlled ? '<br><span class="badge bg-warning text-dark">Your Control</span>' : ''}
                        </div>
                        <div class="text-end">
                            ${isSelected ? `<strong>${playerName}</strong><br><small>${playerPosition}</small>` : 
                              index === currentPickIndex ? '<span class="badge bg-light text-dark">On the Clock</span>' : ''}
                        </div>
                    </div>
                `;

                container.appendChild(pickDiv);
            });
        }

        // Display available players
        function displayAvailablePlayers() {
            const container = document.getElementById('availablePlayersList');
            container.innerHTML = '';

            if (!availablePlayersData || availablePlayersData.length === 0) {
                container.innerHTML = '<div class="text-center p-4"><div class="spinner-border" role="status"></div><p class="mt-2">Loading players...</p></div>';
                return;
            }

            // Filter players by position
            let filteredPlayers = availablePlayersData;
            if (currentPositionFilter !== 'all') {
                filteredPlayers = availablePlayersData.filter(player => 
                    player.position === currentPositionFilter
                );
            }

            filteredPlayers.forEach(player => {
                const playerDiv = document.createElement('div');
                playerDiv.className = 'player-item p-3 border-bottom cursor-pointer';
                playerDiv.addEventListener('click', () => selectPlayer(player));

                playerDiv.innerHTML = `
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <strong>${player.name}</strong>
                            <br><small class="text-muted">${player.college || 'N/A'}</small>
                        </div>
                        <div class="col-md-2 text-center">
                            <span class="badge bg-secondary">${player.position}</span>
                        </div>
                        <div class="col-md-2 text-center">
                            <small>${player.height || 'N/A'}" / ${player.weight || 'N/A'} lbs</small>
                        </div>
                        <div class="col-md-2 text-center">
                            <span class="badge bg-primary">${player.athScore || 0}</span>
                            <br><small class="text-muted">Score</small>
                        </div>
                    </div>
                `;

                container.appendChild(playerDiv);
            });

            // Add hover effects
            container.querySelectorAll('.player-item').forEach(item => {
                item.addEventListener('mouseenter', () => item.classList.add('bg-light'));
                item.addEventListener('mouseleave', () => item.classList.remove('bg-light'));
            });
        }

        // Process current draft pick
        function processDraftPick() {
            if (currentPickIndex >= draftOrder.length) {
                // Draft is complete
                completeDraft();
                return;
            }

            const currentPick = draftOrder[currentPickIndex];
            
            // Update current pick display
            document.getElementById('current-pick').textContent = `Pick ${currentPick.overall}`;
            
            // Show current pick info
            const pickInfo = document.getElementById('currentPickInfo');
            pickInfo.style.display = 'block';
            pickInfo.innerHTML = `
                <strong>Pick #${currentPick.overall}</strong> - ${currentPick.teamName}
                <br>Round ${currentPick.round}, Pick ${currentPick.pickInRound}
                ${currentPick.isUserControlled ? '<br><span class="badge bg-warning text-dark">Your Turn!</span>' : ''}
            `;

            // Scroll to current pick in draft order
            const pickElement = document.getElementById(`pick-${currentPickIndex}`);
            if (pickElement) {
                pickElement.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            if (currentPick.isUserControlled && manualRounds >= currentPick.round) {
                // User needs to make this pick
                isUserControlled = true;
                enablePlayerSelection();
            } else {
                // Auto-pick for this team
                isUserControlled = false;
                disablePlayerSelection();
                makeAutoPick();
            }
        }

        // Enable player selection for user
        function enablePlayerSelection() {
            const playerItems = document.querySelectorAll('.player-item');
            playerItems.forEach(item => {
                item.style.cursor = 'pointer';
                item.style.opacity = '1';
            });
        }

        // Disable player selection
        function disablePlayerSelection() {
            const playerItems = document.querySelectorAll('.player-item');
            playerItems.forEach(item => {
                item.style.cursor = 'not-allowed';
                item.style.opacity = '0.6';
            });
        }

        // Select a player (user pick)
        function selectPlayer(player) {
            if (!isUserControlled) return;

            const currentPick = draftOrder[currentPickIndex];
            
            // Confirm selection
            if (!confirm(`Draft ${player.name} (${player.position}) with pick #${currentPick.overall}?`)) {
                return;
            }

            // Record the selection
            currentPick.selectedPlayer = player;
            
            // If this is a team pick, record it in selections
            if (currentPick.teamId === parseInt('@Model.Id')) {
                teamDraftSelections.set(currentPick.overall, player.id);
            }

            // Remove player from available list
            availablePlayersData = availablePlayersData.filter(p => p.id !== player.id);

            // Move to next pick
            currentPickIndex++;
            
            // Update displays
            displayDraftOrder();
            displayAvailablePlayers();
            updateHiddenFields();
            
            // Process next pick
            processDraftPick();
        }

        // Make automatic pick
        function makeAutoPick() {
            const pickInfo = document.getElementById('currentPickInfo');
            pickInfo.innerHTML += `
                <div class="mt-2">
                    <div class="spinner-border text-primary mb-2" role="status"></div>
                    <p>Making selection...</p>
                </div>
            `;

            const delays = { 'instant': 100, 'fast': 500, 'normal': 1000, 'slow': 2000 };
            setTimeout(() => {
                makeLocalAIPick();
            }, delays[simulationSpeed] || 1000);
        }

        // Make AI pick locally
        function makeLocalAIPick() {
            const currentPick = draftOrder[currentPickIndex];
            const neededPositions = currentPick.neededPositions || [];
            
            let selectedPlayer = null;
            
            // First try to fill needed positions
            if (neededPositions.length > 0) {
                for (let position of neededPositions) {
                    selectedPlayer = availablePlayersData.find(p => p.position === position);
                    if (selectedPlayer) break;
                }
            }
            
            // If no needed position player found, pick best available
            if (!selectedPlayer && availablePlayersData.length > 0) {
                selectedPlayer = availablePlayersData.reduce((prev, current) =>
                    (prev.athScore > current.athScore) ? prev : current
                );
            }

            if (selectedPlayer) {
                // Record the selection
                currentPick.selectedPlayer = selectedPlayer;
                
                // Remove player from available list
                availablePlayersData = availablePlayersData.filter(p => p.id !== selectedPlayer.id);

                // Move to next pick
                currentPickIndex++;
                
                // Update displays
                displayDraftOrder();
                displayAvailablePlayers();
                
                // Process next pick
                processDraftPick();
            } else {
                // No players available - this shouldn't happen
                console.error('No players available for pick');
                currentPickIndex++;
                processDraftPick();
            }
        }

        // Complete draft
        function completeDraft() {
            document.getElementById('currentPickInfo').innerHTML = `
                <div class="alert alert-success">
                    <h5><i class="fas fa-trophy me-2"></i>Draft Complete!</h5>
                    <p>All picks have been made. Review your selections and save the results.</p>
                </div>
            `;

            // Show save section
            document.getElementById('saveSection').style.display = 'block';
            
            // Update hidden fields one final time
            updateHiddenFields();
            
            // Scroll to top
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Form submission handler
        document.getElementById('draftForm').addEventListener('submit', function(e) {
            // Update hidden fields before submission
            updateHiddenFields();
        });
    });
</script>

