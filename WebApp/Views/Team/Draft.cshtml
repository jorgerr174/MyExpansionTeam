@using static METCore.Enums.Types
@model METCore.DTOs.Team.DraftDto

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
			<h2>Configuración del Draft  - @Model.Location @Model.Mascot</h2>

            <!-- Phase Navigation -->
            <ul class="nav nav-pills mb-4" id="phaseNavigation" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="settings-tab" data-bs-toggle="pill" data-bs-target="#settings-phase" type="button" role="tab">
                        <i class="fas fa-cog me-2"></i>Ajustes del Draft
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link disabled" id="draft-tab" data-bs-toggle="pill" data-bs-target="#draft-phase" type="button" role="tab" disabled>
						<i class="fas fa-trophy me-2"></i>Simulación
						<span class="badge bg-secondary ms-2" id="current-pick">Pick 1</span>
                    </button>
                </li>
            </ul>

            <form asp-action="Draft" method="post" id="draftForm">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.Location)
                @Html.HiddenFor(m => m.Mascot)
                @Html.HiddenFor(m => m.Abb)
                @Html.HiddenFor(m => m.UserUsername)
                @Html.HiddenFor(m => m.Date)
                @Html.HiddenFor(m => m.Complete)

                <!-- Hidden field for selected franchises to control -->
                <input type="hidden" id="selectedFranchises" name="SelectedFranchises" value="" />
                
                <!-- Hidden field for team's draft selections (IDictionary<int,int>) -->
                <input type="hidden" id="draftSelections" name="Selections" value="" />

                <!-- Hidden field for all picks data (IList<int>[]) -->
                <input type="hidden" id="allPicksData" name="Picks" value="" />

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="settings-phase" role="tabpanel">
                        <div class="card">
                            <div class="card-header">
                                <h4>Configurar el Draft</h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group mb-3">
                                            @Html.LabelFor(m => m.Rounds, new { @class = "form-label" })
                                            @Html.TextBoxFor(m => m.Rounds, new { @class = "form-control", @type = "number", @min = "0", @max = "7" })
                                            @Html.ValidationMessageFor(m => m.Rounds, "", new { @class = "text-danger" })
                                            <div class="form-text">Rondas que realizar manualmente <br/>(0 = simulación completa, 7 = todo)</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group mb-3">
                                            <label for="Speed" class="form-label">Velocidad de la simulación</label>
                                            <select id="Speed" name="Speed" class="form-select">
                                                <option value="instant">Instantáneo</option>
                                                <option value="fast">Rápido (0.5s por pick)</option>
                                                <option value="normal" selected>Normal (1s por pick)</option>
                                                <option value="slow">Lento (2s por pick)</option>
                                            </select>
                                            <div class="form-text">Velocidad de los picks realizados por el sistema</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card bg-light mb-4">
                                    <div class="card-header">
                                        <h5 class="mb-0">Método de Control</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="draftMethod" id="draftMethodFull" value="full" checked>
                                                    <label class="form-check-label" for="draftMethodFull">
                                                        <strong>Simulación Completa</strong><br>
                                                        <small class="text-muted">Mire como el draft se simula por completo</small>
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="draftMethod" id="draftMethodMyTeam" value="myteam">
                                                    <label class="form-check-label" for="draftMethodMyTeam">
                                                        <strong>Controlar Mi Equipo</strong><br>
                                                        <small class="text-muted">Solo controla los picks de tu equipo</small>
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="draftMethod" id="draftMethodMultiple" value="multiple">
                                                    <label class="form-check-label" for="draftMethodMultiple">
                                                        <strong>Controla Franquicias</strong><br>
                                                        <small class="text-muted">Controla los picks de tu equipo y los de otras franquicias</small>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div id="multipleTeamSelection" class="card mb-4" style="display: none;">
                                    <div class="card-header">
                                        <h5 class="mb-0">Seleccione franquicias que controlar</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row" id="franchiseCheckboxes">
                                            <!-- Franchise checkboxes will be populated by JavaScript -->
                                        </div>
                                    </div>
                                </div>

                                <div class="card mb-4">
                                    <div class="card-header">
                                        <h5 class="mb-0">Ajustes adicionales</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="enableTrading" checked>
                                            <label class="form-check-label" for="enableTrading">
                                                Permitir Trueques durante el draft
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="card mb-4">
                                    <div class="card-header">
                                        <h5 class="mb-0">Resumen de la configuración</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <p><strong>Método de Control:</strong> <span id="manualDescription">Simulación completa</span></p>
                                                <p><strong>Trueques permitidos:</strong> <span id="tradingStatus">Permitido</span></p>
                                            </div>
                                            <div class="col-md-6">
                                                <p><strong>Número de picks de tu equipo:</strong> <span id="teamPicksCount">Cargando...</span></p>
                                                <p><strong>Siguiente Pick:</strong> <span id="nextPickInfo">Cargando...</span></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <button type="button" class="btn btn-secondary" onclick="history.back()">
                                        <i class="fas fa-arrow-left me-2"></i>Volver
                                    </button>
                                    <button type="button" class="btn btn-primary btn-lg" id="startDraftButton">
                                        <i class="fas fa-play me-2"></i>Comenzar Draft
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="draft-phase" role="tabpanel">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="card">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">Orden del Draft</h5>
                                        <button type="button" class="btn btn-primary btn-sm" id="newTradeOffer">
                                            <i class="fas fa-plus me-1"></i>Nuevo Trueque
                                        </button>
                                        <button type="button" class="btn btn-warning btn-sm" id="simulationToggleButton" style="display: none;">
                                            <i class="fas fa-start me-1" id="simulationToggleIcon"></i>
                                            <span id="simulationToggleText">Comenzar</span>
                                        </button>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="draft-order-container" style="max-height: 600px; overflow-y: auto;">
                                            <button type="button" data-mdb-button-init data-mdb-ripple-init class="btn btn-outline-info btn-floating btn-lg" id="backToCurrent">
                                                Actual
                                            </button>
                                            <div id="draftOrderList">
                                                <!-- Draft order will be populated by JavaScript -->
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-8">
                                <div class="card">
                                    <div class="card-header">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h5 class="mb-0">Prospectos disponibles</h5>
                                            <div class="d-flex align-items-center">
                                                <label for="positionFilter" class="form-label me-2 mb-0">Filtro:</label>
                                                <select id="positionFilter" class="form-select form-select-sm" style="width: auto;">
                                                    <option value="all">Todos</option>
                                                    <option value="QB">QB</option>
                                                    <option value="HB">HB</option>
                                                    <option value="WR">WR</option>
                                                    <option value="TE">TE</option>
                                                    <option value="OL">OL</option>
                                                    <option value="DL">DL</option>
                                                    <option value="LB">LB</option>
                                                    <option value="DB">DB</option>
                                                    <option value="P/K">P/K</option>
                                                    <option value="PR/KR">PR/KR</option>
                                                    <option value="LS">LS</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body p-0">
                                        <div id="currentPickInfo" class="alert alert-info m-3" style="display: none;">
                                            <!-- Current pick information -->
                                        </div>
                                        <div class="players-container" style="max-height: 600px; overflow-y: auto;">
                                            <div id="availablePlayersList">
                                                <!-- Available players will be populated by JavaScript -->
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 text-center" style="display: none;" id="saveSection">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="fas fa-save me-2"></i>Guardar resultados
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="draftSummarySection" class="card mt-4" style="display: none;">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">
            <i class="fas fa-trophy me-2"></i>Resumen de tu draft- @Model.Location @Model.Mascot
        </h5>
    </div>
    <div class="card-body">
        <div id="draftSummaryContent">
            <!-- Summary content will be populated by JavaScript -->
        </div>
    </div>
</div>

<div id="tradeModalContainer"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function () {
        let selectedFranchises = [];
        let draftMethod = 'full';
        let draftOrder = [];
        let currentPickIndex = 0;
        let availablePlayersData = [];
        let isUserControlled = false;
        let enableTrading = true;
        let manualRounds = 0;
        let currentPositionFilter = 'all';
        let simulationSpeed = 'normal';
        let isDraftActive = false;
        let teamDraftSelections = new Map();
        let userControlledPicks = [];
        let franchiseControlledPicks = [];
        let franchiseDraftOrder = [];
        let allPicksData = [];
        let automaticScroll = true;
        let stopSimulation = true;

        const franchiseNames = {
            1: { name: "Arizona Cardinals", abbreviation: "ARI" },
            2: { name: "Atlanta Falcons", abbreviation: "ATL" },
            3: { name: "Baltimore Ravens", abbreviation: "BAL" },
            4: { name: "Buffalo Bills", abbreviation: "BUF" },
            5: { name: "Carolina Panthers", abbreviation: "CAR" },
            6: { name: "Chicago Bears", abbreviation: "CHI" },
            7: { name: "Cincinnati Bengals", abbreviation: "CIN" },
            8: { name: "Cleveland Browns", abbreviation: "CLE" },
            9: { name: "Dallas Cowboys", abbreviation: "DAL" },
            10: { name: "Denver Broncos", abbreviation: "DEN" },
            11: { name: "Detroit Lions", abbreviation: "DET" },
            12: { name: "Green Bay Packers", abbreviation: "GB" },
            13: { name: "Houston Texans", abbreviation: "HOU" },
            14: { name: "Indianapolis Colts", abbreviation: "IND" },
            15: { name: "Jacksonville Jaguars", abbreviation: "JAX" },
            16: { name: "Kansas City Chiefs", abbreviation: "KC" },
            17: { name: "Las Vegas Raiders", abbreviation: "LV" },
            18: { name: "Los Angeles Chargers", abbreviation: "LAC" },
            19: { name: "Los Angeles Rams", abbreviation: "LAR" },
            20: { name: "Miami Dolphins", abbreviation: "MIA" },
            21: { name: "Minnesota Vikings", abbreviation: "MIN" },
            22: { name: "New England Patriots", abbreviation: "NE" },
            23: { name: "New Orleans Saints", abbreviation: "NO" },
            24: { name: "New York Giants", abbreviation: "NYG" },
            25: { name: "New York Jets", abbreviation: "NYJ" },
            26: { name: "Philadelphia Eagles", abbreviation: "PHI" },
            27: { name: "Pittsburgh Steelers", abbreviation: "PIT" },
            28: { name: "San Francisco 49ers", abbreviation: "SF" },
            29: { name: "Seattle Seahawks", abbreviation: "SEA" },
            30: { name: "Tampa Bay Buccaneers", abbreviation: "TB" },
            31: { name: "Tennessee Titans", abbreviation: "TEN" },
            32: { name: "Washington Commanders", abbreviation: "WAS" }
        };

        const positionMappings = {
            'QB': ['QB'],
            'HB': ['RB', 'FB'],
            'WR': ['WR'],
            'TE': ['TE'],
            'OL': ['OT', 'G', 'C'],
            'DL': ['NT', 'DT', 'ED'],
            'LB': ['OLB', 'MLB'],
            'DB': ['DB', 'CB', 'S', 'SS', 'FS'],
            'P/K': ['P', 'K'],
            'PR/KR': ['PR', 'KR'],
            'LS': ['LS']
        };

        const ROUND_SIZES = { 1: 33, 2: 33, 3: 39, 4: 37, 5: 39, 6: 41, 7: 42 };

        const ROUND_START_PICKS = { 1: 1, 2: 34, 3: 67, 4: 106, 5: 143, 6: 182, 7: 223 };

        function rppToOverall(rppNumber) {
            const round = Math.floor(rppNumber / 100);
            const pickInRound = rppNumber % 100;

            if (!ROUND_START_PICKS[round]) {
                console.error(`Ronda inválida: ${round}`);
                return 0;
            }

            return ROUND_START_PICKS[round] + pickInRound - 1;
        }

        function overallToRound(overallPick) {
            return overallPick < 1
                ? 0 : overallPick <= 33
                ? 1 : overallPick <= 66
                ? 2 : overallPick <= 105
                ? 3 : overallPick <= 142
                ? 4 : overallPick <= 181
                ? 5 : overallPick <= 222
                ? 6 : overallPick <= 264
                ? 7 : 0;
        }

        function overallToPickInRound(overallPick) {
            const round = overallToRound(overallPick);
            if (round === 0) return 0;
    
            return overallPick - ROUND_START_PICKS[round] + 1;
        }

        function parsePickToOverall(pickString) {
            const match = pickString.match(/r(\d+)p(\d+)/);
            if (match) {
                const round = parseInt(match[1]);
                const pick = parseInt(match[2]);
                const rppNumber = (round * 100) + pick;
                return rppToOverall(rppNumber);
            }
            return 0;
        }

        initializeSelections();
        initializeAllPicksData();
        initializeSelectedFranchises();
        updateDraftPreview();
        setupEventHandlers();
        displayTeamPicksInfo();

        function initializeSelections() {
            teamDraftSelections.clear();
            
            if (@Html.Raw(Json.Serialize(Model.Selections)) && Object.keys(@Html.Raw(Json.Serialize(Model.Selections))).length > 0) {
                const selections = @Html.Raw(Json.Serialize(Model.Selections));
                Object.entries(selections).forEach(([pickNumber, playerId]) => {
                    teamDraftSelections.set(parseInt(pickNumber), parseInt(playerId));
                });
            }
        }

        function initializeAllPicksData() {
            if (@Html.Raw(Json.Serialize(Model.Picks))) {
                allPicksData = @Html.Raw(Json.Serialize(Model.Picks));
            } else {
                allPicksData = new Array(33).fill(null).map(() => []);
            }
        }

        function updateHiddenFields() {
            const selectionsObj = {};
            teamDraftSelections.forEach((playerId, pickNumber) => {
                selectionsObj[pickNumber] = playerId;
            });
            document.getElementById('draftSelections').value = JSON.stringify(selectionsObj);

            document.getElementById('allPicksData').value = JSON.stringify(allPicksData);
        }

        function initializeSelectedFranchises() {
            const hiddenField = document.getElementById('selectedFranchises');
            const value = hiddenField.value.trim();
            selectedFranchises = value ? value.split(',').map(id => parseInt(id)) : [];
            
            selectedFranchises.forEach(franchiseId => {
                const checkbox = document.getElementById(`franchise_${franchiseId}`);
                if (checkbox) checkbox.checked = true;
            });
        }

        function setupEventHandlers() {
            document.getElementById('Rounds').addEventListener('change', function() {
                updateDraftPreview();

                if (isDraftActive) {
                    displayDraftOrder();
                }
            });
            document.getElementById('Speed').addEventListener('change', updateDraftPreview);

            document.querySelectorAll('input[name="draftMethod"]').forEach(radio => {
                radio.addEventListener('change', function() {
                    draftMethod = this.value;
                    updateDraftPreview();
                    toggleMultipleTeamSelection();
                });
            });

            document.getElementById('enableTrading').addEventListener('change', function() {
                enableTrading = this.checked;
                updateDraftPreview();
            });

            document.getElementById('startDraftButton').addEventListener('click', function () {
                if (validateSettings()) {
                    startDraftSimulation();
                }
            });

            document.getElementById('positionFilter').addEventListener('change', function() {
                currentPositionFilter = this.value;
                displayAvailablePlayers();
            });
        }

        function displayTeamPicksInfo() {
            const teamPicks = allPicksData[0] || [];

            if (teamPicks && teamPicks.length > 0) {
                document.getElementById('teamPicksCount').textContent = teamPicks.length;

                if (teamPicks.length > 0) {
                    const nextPickRpp = teamPicks[0];
                    const round = Math.floor(nextPickRpp / 100);
                    const pickInRound = nextPickRpp % 100;
                    const overallPick = rppToOverall(nextPickRpp);
                    document.getElementById('nextPickInfo').textContent = `Ronda ${round}, Pick ${pickInRound} (Total #${overallPick})`;
                } else {
                    document.getElementById('nextPickInfo').textContent = 'Sin picks disponibles';
                }
            } else {
                document.getElementById('teamPicksCount').textContent = 'Cargando...';
                document.getElementById('nextPickInfo').textContent = 'Cargando...';
            }
        }

        function toggleMultipleTeamSelection() {
            const multipleSection = document.getElementById('multipleTeamSelection');
            if (draftMethod === 'multiple') {
                multipleSection.style.display = 'block';
                generateFranchiseCheckboxes();
            } else {
                multipleSection.style.display = 'none';
            }
        }

        function generateFranchiseCheckboxes() {
            const container = document.getElementById('franchiseCheckboxes');
            container.innerHTML = '';

            Object.entries(franchiseNames).forEach(([id, franchise]) => {
                const colDiv = document.createElement('div');
                colDiv.className = 'col-md-4 col-sm-6 mb-2';
                
                const checkDiv = document.createElement('div');
                checkDiv.className = 'form-check';
                
                const checkbox = document.createElement('input');
                checkbox.className = 'form-check-input';
                checkbox.type = 'checkbox';
                checkbox.id = `franchise_${id}`;
                checkbox.value = id;
                checkbox.checked = selectedFranchises.includes(parseInt(id));
                
                checkbox.addEventListener('change', function() {
                    if (this.checked) {
                        if (!selectedFranchises.includes(parseInt(id))) {
                            selectedFranchises.push(parseInt(id));
                        }
                    } else {
                        selectedFranchises = selectedFranchises.filter(fId => fId !== parseInt(id));
                    }
                    updateSelectedFranchisesHiddenField();
                    updateDraftPreview();
                });
                
                const label = document.createElement('label');
                label.className = 'form-check-label';
                label.setAttribute('for', `franchise_${id}`);
                label.textContent = `${franchise.name} (${franchise.abbreviation})`;
                
                checkDiv.appendChild(checkbox);
                checkDiv.appendChild(label);
                colDiv.appendChild(checkDiv);
                container.appendChild(colDiv);
            });
        }

        function updateSelectedFranchisesHiddenField() {
            document.getElementById('selectedFranchises').value = selectedFranchises.join(',');
        }

        function updateDraftPreview() {
            manualRounds = parseInt(document.getElementById('Rounds').value) || 0;
            simulationSpeed = document.getElementById('Speed').value || 'normal';

            let manualDescription = '';
            if (draftMethod === 'full') {
                manualDescription = 'Simulación completa - ver el draft por completo';
            } else if (draftMethod === 'myteam') {
                manualDescription = manualRounds === 0 ? 'Simulación completa - ver el draft por completo' :
                                 manualRounds === 7 ? 'Control de todos tus picks' :
                                 `Control manual de tus picks en las primeras ${manualRounds} rondas`;
            } else if (draftMethod === 'multiple') {
                manualDescription = `Control manual de los picks de tu equipo y de ${selectedFranchises.length} franquicias durante (${manualRounds} rondas)`;
            }

            document.getElementById('manualDescription').textContent = manualDescription;
            document.getElementById('tradingStatus').textContent = enableTrading ? 'Permitido' : 'No permitido';

            if (isDraftActive && draftOrder.length > 0) {
                displayDraftOrder();
            }
        }

        function validateSettings() {
            const rounds = parseInt(document.getElementById('Rounds').value);
            if (rounds < 0 || rounds > 7) {
                alert('Rondas manuales deben ser entre 0 y 7');
                return false;
            }

            if (draftMethod === 'multiple' && selectedFranchises.length === 0) {
                alert('Por favor, seleccione al menos una franquicia que controlar');
                return false;
            }

            return true;
        }

        function startDraftSimulation() {
            isDraftActive = true;
            simulationSpeed = document.getElementById('Speed').value || 'normal';

            const settingsTab = document.getElementById('settings-tab');
            settingsTab.classList.add('disabled');
            settingsTab.disabled = true;

            const draftTab = document.getElementById('draft-tab');
            draftTab.classList.remove('disabled');
            draftTab.disabled = false;

            const tabDraft = new bootstrap.Tab(draftTab);
            tabDraft.show();

            document.getElementById('newTradeOffer').style.display = enableTrading ? 'inline-block' : 'none';

            const simulationToggleButton = document.getElementById('simulationToggleButton');
            simulationToggleButton.style.display = 'inline-block';

            initializeDraftData();
        }

        function initializeDraftData() {
            loadDraftOrderFromPicksData();

            fetch('/Team/GetDraftProspects')
            .then(response => response.json())
            .then(prospects => {
                availablePlayersData = prospects;
                displayAvailablePlayers();
            });
        }

        function loadDraftOrderFromPicksData() {
            draftOrder = [];

            const allPicks = [];

            for (let i = 0; i < allPicksData.length; i++) {
                if (allPicksData[i] && allPicksData[i].length > 0) {
                    allPicksData[i].forEach(pickNum => {
                        const round = Math.floor(pickNum / 100);
                        const pickInRound = pickNum % 100;
                        const overallPick = rppToOverall(pickNum);

                        allPicks.push({
                            pickNumber: overallPick,
                            rppNumber: pickNum,
                            round: round,
                            pickInRound: pickInRound,
                            entityIndex: i,
                            isTeam: i === 0,
                            teamId: i
                        });
                    });
                }
            }

            allPicks.sort((a, b) => a.pickNumber - b.pickNumber);

            allPicks.forEach(pick => {
                draftOrder.push({
                    overall: pick.pickNumber,
                    rppFormat: pick.rppNumber,
                    round: pick.round,
                    pickInRound: pick.pickInRound,
                    teamId: pick.teamId,
                    teamName: pick.isTeam ? '@Model.Location @Model.Mascot' : franchiseNames[pick.teamId].name,
                    teamAbbr: pick.isTeam ? '@Model.Abb' : franchiseNames[pick.teamId].abbreviation,
                    isUserControlled: shouldControlPick(pick),
                    selectedPlayer: null,
                    neededPositions: []
                });
            });

            displayDraftOrder();
        }

        function shouldControlPick(pick) {
            return draftMethod !== 'full' 
                && (pick.isTeam || (draftMethod === 'multiple' && selectedFranchises.includes(pick.teamId)));
        }

        function displayDraftOrder() {
            const container = document.getElementById('draftOrderList');
            container.innerHTML = '';

            const filteredPicks = draftOrder.filter(pick => {
                const pickRound = overallToRound(pick.overall);
                return pickRound <= manualRounds || manualRounds === 0;
            });

            filteredPicks.forEach((pick, index) => {
                const actualIndex = draftOrder.findIndex(p => p.overall === pick.overall);

                const pickDiv = document.createElement('div');
                pickDiv.className = `draft-pick-item p-3 border-bottom ${actualIndex === currentPickIndex ? 'bg-primary text-white' : ''} ${pick.isUserControlled ? 'border-start border-warning border-3' : ''}`;
                pickDiv.id = `pick-${actualIndex}`;

                const isSelected = pick.selectedPlayer !== null;
                const playerName = isSelected ? pick.selectedPlayer.name : '';
                const playerPosition = isSelected ? pick.selectedPlayer.position : '';

                pickDiv.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>#${pick.overall}</strong> - ${pick.teamAbbr}
                            <br><small>Ronda ${pick.round}, Pick ${pick.pickInRound}</small>
                            ${pick.isUserControlled ? '<br><span class="badge bg-warning text-dark">Tu Control</span>' : ''}
                        </div>
                        <div class="text-end">
                            ${isSelected ? `<strong>${playerName}</strong><br><small>${playerPosition}</small>` :
                              actualIndex === currentPickIndex ? '<span class="badge bg-light text-dark">Su turno</span>' : ''}
                        </div>
                    </div>
                `;

                container.appendChild(pickDiv);
            });
        }

        function displayAvailablePlayers() {
            const container = document.getElementById('availablePlayersList');
            container.innerHTML = '';

            if (!availablePlayersData || availablePlayersData.length === 0) {
                container.innerHTML = '<div class="text-center p-4"><div class="spinner-border" role="status"></div><p class="mt-2">Cargando jugadores...</p></div>';
                return;
            }

            let filteredPlayers = availablePlayersData;
            if (currentPositionFilter !== 'all') {
                filteredPlayers = availablePlayersData.filter(player =>
                    positionMappings[currentPositionFilter].includes(player.position)
                );
            }

            if (filteredPlayers.length === 0) {
                container.innerHTML = `
                    <div class="text-center p-4">
                        <p class="text-muted">No hay jugadores disponibles para la posición ${currentPositionFilter}.</p>
                    </div>
                `;
                return;
            }

            filteredPlayers.forEach(player => {
                const playerDiv = document.createElement('div');
                playerDiv.className = 'col-12 mb-2';

                const cardDiv = document.createElement('div');
                cardDiv.className = 'card player-card';
                cardDiv.setAttribute('data-player-id', player.id);

                if (isUserControlled) {
                    cardDiv.classList.add('selectable');
                    cardDiv.style.cursor = 'pointer';
                    cardDiv.title = 'Clica para draftear este prospecto';
                } else {
                    cardDiv.style.cursor = 'not-allowed';
                    cardDiv.style.opacity = '0.6';
                }

                const heightFeet = Math.floor((player.height || 0) / 12);
                const heightInches = (player.height || 0) % 12;
                const heightDisplay = `${heightFeet}'${heightInches}"`;

                cardDiv.innerHTML = `
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8">
                                <div class="player-header">
                                    <h6 class="player-title mb-1">${player.name || ''}</h6>
                                    <div class="player-basic-info mb-2">
                                        <span class="badge bg-primary me-2">${player.position || 'N/A'}</span>
                                        <span class="text-muted">${player.college || ''}</span>
                                    </div>
                                    <div class="player-physical mb-2">
                                        <small class="text-muted">
                                            <strong>Medidas:</strong> ${heightDisplay} | ${player.weight || 0} lbs
                                            ${player.handSize ? ` | Manos: ${player.handSize}"` : ''}
                                            ${player.armLength ? ` | Brazos: ${player.armLength}"` : ''}
                                            ${player.wingspan ? ` | Envergadura: ${player.wingspan}"` : ''}
                                        </small>
                                    </div>
                                    <div class="player-combine">
                                        <small class="text-info">
                                            <strong>Combine:</strong>
                                            ${player.fortyYardDash ? ` 40yd: ${player.fortyYardDash}` : ''}
                                            ${player.vertJump ? ` | Vert: ${player.vertJump}"` : ''}
                                            ${player.broadJump ? ` | Largo: ${player.broadJump}"` : ''}
                                            ${player.benchPress ? ` | Banca: ${player.benchPress}` : ''}
                                            ${player.threeConeDrill ? ` | 3-Conos: ${player.threeConeDrill}` : ''}
                                            ${player.twentyYardShuttle ? ` | 20yd: ${player.twentyYardShuttle}` : ''}
                                        </small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 text-end">
                                <div class="player-scores">
                                    <div class="mb-2">
                                        <span class="badge bg-success fs-6">Atl: ${player.athScore || 0}</span>
                                    </div>
                                    <div>
                                        <span class="badge bg-warning text-dark">Consenso: ${player.consensus || 0}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                cardDiv.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();

                    console.log('Player clicked:', player.id, 'User controlled:', isUserControlled);

                    if (isUserControlled) {
                        selectPlayer(player);
                    } else {
                        console.log('Click ignored - not user controlled pick');
                    }
                });

                cardDiv.addEventListener('mouseenter', function() {
                    if (isUserControlled) {
                        this.classList.add('bg-light');
                    }
                });

                cardDiv.addEventListener('mouseleave', function() {
                    this.classList.remove('bg-light');
                });

                playerDiv.appendChild(cardDiv);
                container.appendChild(playerDiv);
            });
        }
    
        function processDraftPick() {
            if (stopSimulation) {
                console.log('Simulación pausada, esperando para continuar...');
                return;
            }   

            if (currentPickIndex >= draftOrder.length) {
                completeDraft();
                return;
            }

            const currentPick = draftOrder[currentPickIndex];
            const currentPickRound = overallToRound(currentPick.overall);

            document.getElementById('current-pick').textContent = `Pick ${currentPick.overall}`;

            const pickInfo = document.getElementById('currentPickInfo');
            pickInfo.style.display = 'block';
            pickInfo.innerHTML = `
                <strong>Pick #${currentPick.overall}</strong> - ${currentPick.teamName}
                <br>Ronda ${currentPick.round}, Pick ${currentPick.pickInRound}
                ${currentPick.isUserControlled ? '<br><span class="badge bg-warning text-dark">Tu Turno!</span>' : ''}
            `;

            const pickElement = document.getElementById(`pick-${currentPickIndex}`);
            if (automaticScroll && pickElement) {
                pickElement.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            if (currentPick.isUserControlled && currentPickRound <= manualRounds) {
                isUserControlled = true;
                enablePlayerSelection();
            } else {
                isUserControlled = false;
                disablePlayerSelection();
                makeAutoPick();
            }
        }

        function enablePlayerSelection() {
            const playerCards = document.querySelectorAll('.player-card');
            playerCards.forEach(card => {
                card.style.cursor = 'pointer';
                card.style.opacity = '1';
                card.title = 'Clica para seleccionar a este jugador';
            });
        }

        function disablePlayerSelection() {
            const playerCards = document.querySelectorAll('.player-card');
            playerCards.forEach(card => {
                card.style.cursor = 'not-allowed';
                card.style.opacity = '0.6';
                card.title = 'No puede seleccionar - no es su turno';
            });
        }

        function selectPlayer(player) {
            if (!isUserControlled) return;

            const currentPick = draftOrder[currentPickIndex];
            
            if (!confirm(`Elegir a ${player.name} (${player.position}) con el pick #${currentPick.overall}?`)) {
                return;
            }

            currentPick.selectedPlayer = player;
            
            if (currentPick.teamId === 0) {
                teamDraftSelections.set(currentPick.overall, player.id);
            }

            availablePlayersData = availablePlayersData.filter(p => p.id !== player.id);

            currentPickIndex++;
            
            displayDraftOrder();
            displayAvailablePlayers();
            updateHiddenFields();
            
            processDraftPick();
        }

        function makeAutoPick() {
            const pickInfo = document.getElementById('currentPickInfo');
            pickInfo.innerHTML += `
                <div class="mt-2">
                    <div class="spinner-border text-primary mb-2" role="status"></div>
                    <p>Simulando elección...</p>
                </div>
            `;

            const currentPickRound = overallToRound(draftOrder[currentPickIndex].overall);
            let actualSpeed = simulationSpeed;

            if (currentPickRound > manualRounds && manualRounds > 0) {
                actualSpeed = 'instant';
            }

            const delays = { 'instant': 10, 'fast': 500, 'normal': 1000, 'slow': 2000 };
            setTimeout(() => {
                makeLocalAIPick();
            }, delays[actualSpeed] || 1000);
        }

        function makeLocalAIPick() {
            const currentPick = draftOrder[currentPickIndex];
            const neededPositions = currentPick.neededPositions || [];

            let selectedPlayer = null;

            if (neededPositions.length > 0) {
                let positionPlayers = [];
                for (let position of neededPositions) {
                    const playersAtPosition = availablePlayersData.filter(p => p.position === position);
                    positionPlayers = positionPlayers.concat(playersAtPosition);
                }

                if (positionPlayers.length > 0) {
                    selectedPlayer = positionPlayers.reduce((prev, current) => {
                        const prevConsensus = prev.consensus || 999;
                        const currentConsensus = current.consensus || 999;
                        return (prevConsensus < currentConsensus) ? prev : current;
                    });
                }
            }

            if (!selectedPlayer && availablePlayersData.length > 0) {
                selectedPlayer = availablePlayersData.reduce((prev, current) => {
                    const prevConsensus = prev.consensus || 999;
                    const currentConsensus = current.consensus || 999;

                    if (prevConsensus === currentConsensus) {
                        return (prev.athScore > current.athScore) ? prev : current;
                    }

                    return (prevConsensus < currentConsensus) ? prev : current;
                });
            }

            if (selectedPlayer) {
                currentPick.selectedPlayer = selectedPlayer;

                if (currentPick.teamId === 0) {
                    teamDraftSelections.set(currentPick.overall, selectedPlayer.id);
                }

                availablePlayersData = availablePlayersData.filter(p => p.id !== selectedPlayer.id);

                currentPickIndex++;

                displayDraftOrder();
                displayAvailablePlayers();

                processDraftPick();
            } else {
                console.error('Sin jugadores disponibles para la elección');
                currentPickIndex++;
                processDraftPick();
            }
        }

        function completeDraft() {
            document.getElementById('currentPickInfo').innerHTML = `
                <div class="alert alert-success">
                    <h5><i class="fas fa-trophy me-2"></i>Draft Completado!</h5>
                    <p>Todos las elecciones han sido completadas. Revise sus elecciones y guarde los resultados.</p>
                </div>
            `;

            document.getElementById('newTradeOffer').style.display = 'none';
            document.getElementById('simulationToggleButton').style.display = 'none';

            $('.draft-order-container').off("wheel");
            $('#backToCurrent').css("display", "none");
            showDraftSummary();

            document.getElementById('saveSection').style.display = 'block';
            
            updateHiddenFields();
            teamDraftSelections.forEach((playerId, pickNumber) => {
                $('#draftSelections').append(`<input type="hidden" name="Selections[${pickNumber}]" value="${playerId}" />`);
            });

            document.getElementById('draftSummarySection').scrollIntoView({ behavior: 'smooth' });
            automaticScroll = false;
        }

        document.getElementById('draftForm').addEventListener('submit', function(e) {
            updateHiddenFields();
        });


        function toggleSimulation() {
            stopSimulation = !stopSimulation;

            const toggleButton = document.getElementById('simulationToggleButton');
            const toggleIcon = document.getElementById('simulationToggleIcon');
            const toggleText = document.getElementById('simulationToggleText');

            if (stopSimulation) {
                toggleButton.classList.remove('btn-warning');
                toggleButton.classList.add('btn-success');
                toggleIcon.classList.remove('fa-pause');
                toggleIcon.classList.add('fa-play');
                toggleText.textContent = 'Continuar';

                const pickInfo = document.getElementById('currentPickInfo');
                if (pickInfo.style.display !== 'none') {
                    const currentContent = pickInfo.innerHTML;
                    if (!currentContent.includes('PAUSED')) {
                        pickInfo.innerHTML = currentContent + `
                            <div class="mt-2">
                                <span class="badge bg-warning text-dark">
                                    <i class="fas fa-pause me-1"></i>Simulación pausada
                                </span>
                            </div>
                        `;
                    }
                }
            } else {
                toggleButton.classList.remove('btn-success');
                toggleButton.classList.add('btn-warning');
                toggleIcon.classList.remove('fa-play');
                toggleIcon.classList.add('fa-pause');
                toggleText.textContent = 'Pausa';

                updateCurrentPickInfo();

                if (!isUserControlled) {
                    processDraftPick();
                }
            }
        }

        function updateCurrentPickInfo() {
            const currentPick = draftOrder[currentPickIndex];
            const pickInfo = document.getElementById('currentPickInfo');
    
            pickInfo.style.display = 'block';
            pickInfo.innerHTML = `
                <strong>Pick #${currentPick.overall}</strong> - ${currentPick.teamName}
                <br>Ronda ${currentPick.round}, Pick ${currentPick.pickInRound}
                ${currentPick.isUserControlled ? '<br><span class="badge bg-warning text-dark">Tu turno!</span>' : ''}
            `;
        }

        document.getElementById('simulationToggleButton').addEventListener('click', function() {
            toggleSimulation();
        });

        $('.draft-order-container').on("wheel", function (event) {
            $('#backToCurrent').css("display", "block");
            automaticScroll = false;
        });

        $('#backToCurrent').click(function () {
            $('#backToCurrent').css("display", "none");
            automaticScroll = true;
            document.getElementById(`pick-${currentPickIndex}`).scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });


        function showDraftSummary() {
            const summarySection = document.getElementById('draftSummarySection');
            const summaryContent = document.getElementById('draftSummaryContent');

            const teamPicks = draftOrder.filter(pick => pick.teamId === 0 && pick.selectedPlayer !== null);

            if (teamPicks.length === 0) {
                summaryContent.innerHTML = `
                    <div class="text-center text-muted p-4">
                        <i class="fas fa-info-circle fa-2x mb-3"></i>
                        <p>Tu equipo no realizó ninguna elección durante este draft.</p>
                    </div>
                `;
            } else {
                teamPicks.sort((a, b) => a.overall - b.overall);

                let summaryHtml = `
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Picks Totales:</strong> ${teamPicks.length}</p>
                        </div>
                    </div>
                    <div class="row">
                `;

                teamPicks.forEach((pick, index) => {
                    const player = pick.selectedPlayer;

                    const heightFeet = Math.floor((player.height || 0) / 12);
                    const heightInches = (player.height || 0) % 12;
                    const heightDisplay = `${heightFeet}'${heightInches}"`;

                    summaryHtml += `
                        <div class="col-md-6 col-lg-4 mb-3">
                            <div class="card border-success h-100">
                                <div class="card-header bg-success text-white py-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0">Pick #${pick.overall}</h6>
                                        <small>Ronda ${pick.round}</small>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <h6 class="card-title text-success">${player.name}</h6>
                                    <div class="mb-2">
                                        <span class="badge bg-primary me-2">${player.position}</span>
                                        <small class="text-muted">${player.college || ''}</small>
                                    </div>
                                    <div class="mb-2">
                                        <small class="text-muted">
                                            <strong>Medidas:</strong> ${heightDisplay} | ${player.weight || 0} lbs
                                        </small>
                                    </div>
                                    <div class="mb-2">
                                        <small class="text-info">
                                            ${player.fortyYardDash ? `40yd: ${player.fortyYardDash}` : ''}
                                            ${player.vertJump ? ` | Vert: ${player.vertJump}"` : ''}
                                        </small>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="badge bg-success">Atl: ${player.athScore || 0}</span>
                                        <span class="badge bg-warning text-dark">Consenso: ${player.consensus || 'N/A'}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                });

                summaryHtml += '</div>';
                summaryContent.innerHTML = summaryHtml;
            }

            summarySection.style.display = 'block';
        }

        document.getElementById('newTradeOffer').addEventListener('click', function() {
            openTradeModal();
        });

        function openTradeModal() {
            if(!stopSimulation) toggleSimulation();
            showFranchiseSelectionModal();
        }

        function showFranchiseSelectionModal() {
            const modalContainer = document.getElementById('tradeModalContainer');
            modalContainer.innerHTML = `
                <div class="modal fade" id="tradeModal" tabindex="-1">
                    <div class="modal-dialog modal-xl">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Seleccione Franquicia con quien realizar trueque</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row" id="franchiseGrid">
                                    <!-- Franchises will be loaded here -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            const modalElement = document.getElementById('tradeModal');
            const modal = new bootstrap.Modal(modalElement);

            modal.show();

            loadFranchiseList();
        }

        function selectFranchiseForTrade(franchiseId) {

            document.getElementById('tradeModal').querySelector('.modal-body').innerHTML = `
                <div class="text-center p-4">
                    <div class="spinner-border text-primary mb-3"></div>
                    <p>Cargando vista del trueque con ${franchiseNames[franchiseId].name}...</p>
                </div>
            `;

            fetch(`/Team/GetTradePartialAsString?TeamId=@Model.Id&FranchiseId=${franchiseId}&CurrentPick=${draftOrder[currentPickIndex].rppFormat}`)
            .then(result => {
                if (!result.ok) {
                    throw new Error(`Error durante la carga de la vista del trueque con ${franchiseNames[franchiseId].name}`);
                }
                else {
                    return result.json();
                }
            })
            .then(json => {
                if (json.message != undefined) {
                    throw new Error(`Error durante la carga de la vista del trueque con ${franchiseNames[franchiseId].name}`);
                }
                else {
                    return json.value;
                }
            })
            .then(text => {
                let $contenedorDialog = $("#tradeModal .modal-content");
                $contenedorDialog.html(text);
                $contenedorDialog.addClass('modal-dialog pt-1');
            })
            .catch(error => {
                console.error('Error:', error);
                let $contenedorDialog = $("#tradeModal .modal-content");
                $contenedorDialog.html(`
                    <div class="modal-header">
                        <h5 class="modal-title">Error</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger">
                            <h6>Network Error</h6>
                            <p>Error durante la carga de la vista del trueque con : ${error.message}</p>
                            <button class="btn btn-primary btn-sm" onclick="selectFranchiseForTrade(${franchiseId})">Probar de nuevo</button>
                        </div>
                    </div>
                `);
            });
        }

        function loadFranchiseList() {
            const franchiseGrid = document.getElementById('franchiseGrid');
            franchiseGrid.innerHTML = '';

            Object.entries(franchiseNames).forEach(([id, franchise]) => {
                 const fName = franchise.name.split(' ');
                 const isFNameShort = fName.length == 2;

                const franchiseCard = document.createElement('div');
                franchiseCard.className = 'col-xl-1-5 col-lg-3 col-md-4 col-sm-6 mb-3';
                franchiseCard.innerHTML = `
                    <div class="card franchise-card h-100">
                        <div class="card-body text-center p-2">
                            <h6 class="franchiseAbb">${franchise.abbreviation}</h6>
                            <small><span style="white-space:nowrap;">${isFNameShort ? fName[0] : (fName[0]+' '+fName[1])}</span>
                            <br/><span>${isFNameShort ? fName[1] : fName[2]}</span></small>
                        </div>
                    </div>
                `;
                franchiseCard.addEventListener('click', function() { selectFranchiseForTrade(id); });
                franchiseGrid.appendChild(franchiseCard);
            });
        }


        window.onTradeCompleted = function(tradeResult) {
            debugger;

            tradeResult.teamTraded.forEach(selection => updateDraftPickAfterTrade(selection, 0, tradeResult.franchiseId));
            tradeResult.franchiseTraded.forEach(selection => updateDraftPickAfterTrade(selection, tradeResult.franchiseId, 0));
            allPicksData[0].sort();
            allPicksData[tradeResult.franchiseId].sort();

            updateHiddenFields();
            displayDraftOrder();
        };

        let totalAtRound = @Html.Raw(Json.Serialize(DraftPicks.TotalAtRound));
        function updateDraftPickAfterTrade(pick, origin, destiny) {

            allPicksData[origin].filter(p => p !== pick);
            allPicksData[destiny].push(pick);
            
            let thisPick = draftOrder[totalAtRound[Math.floor(pick/100)-1]+(pick%100)-1];
            thisPick.teamId = destiny;
            thisPick.teamName = destiny === 0 ? '@Model.Location @Model.Mascot' : franchiseNames[destiny].name;
            thisPick.teamAbbr = destiny === 0 ? '@Model.Abb' : franchiseNames[destiny].abbreviation;
            thisPick.isUserControlled = draftMethod !== 'full' && (destiny === 0 || (draftMethod === 'multiple' && selectedFranchises.includes(destiny)));
            thisPick.selectedPlayer = null;
            thisPick.neededPositions = [];
        }
    });
</script>

