                if (!result.ok) {
                    // Handle error case
                    throw new Error(`Unable to load the trade interface with ${franchiseNames[franchiseId].name}`);
                }
                else {
                    return result.json();
                }
            })
            .then(json => {
                if (json.message != undefined) {
                    // Handle error case
                    throw new Error(`Unable to load the trade interface with ${franchiseNames[franchiseId].name}`);
                }
                else {
                    return json.value;
