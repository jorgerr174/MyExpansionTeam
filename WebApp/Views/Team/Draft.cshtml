        // Toggle simulation pause/resume
        function toggleSimulation() {
            stopSimulation = !stopSimulation;

            const toggleButton = document.getElementById('simulationToggleButton');
            const toggleIcon = document.getElementById('simulationToggleIcon');
            const toggleText = document.getElementById('simulationToggleText');

            if (stopSimulation) {
                // Simulation is now paused
                toggleButton.classList.remove('btn-warning');
                toggleButton.classList.add('btn-success');
                toggleIcon.classList.remove('fa-pause');
                toggleIcon.classList.add('fa-play');
                toggleText.textContent = 'Resume';

                // Update current pick info to show paused state
                const pickInfo = document.getElementById('currentPickInfo');
                if (pickInfo.style.display !== 'none') {
                    const currentContent = pickInfo.innerHTML;
                    if (!currentContent.includes('PAUSED')) {
                        pickInfo.innerHTML = currentContent + `
                            <div class="mt-2">
                                <span class="badge bg-warning text-dark">
                                    <i class="fas fa-pause me-1"></i>SIMULATION PAUSED
                                </span>
                            </div>
                        `;
                    }
                }
            } else {
                // Simulation is now resumed
                toggleButton.classList.remove('btn-success');
                toggleButton.classList.add('btn-warning');
                toggleIcon.classList.remove('fa-play');
                toggleIcon.classList.add('fa-pause');
                toggleText.textContent = 'Pause';

                // Remove paused indicator and continue simulation
                updateCurrentPickInfo();

                // Continue with the current pick if it's not user controlled
                if (!isUserControlled) {
                    processDraftPick();
                }
            }
        }

