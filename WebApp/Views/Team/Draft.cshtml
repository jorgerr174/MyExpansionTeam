        let totalAtRound = [0, 33, 66, 103, 140, 178, 219]
        // Function to update draft picks after a trade
        function updateDraftPickAfterTrade(pick, origin, destiny) {

            allPicksData[origin].filter(p => p !== pick);
            allPicksData[destiny].push(pick);
            
            let thisPick = draftOrder[totalAtRound[Math.floor(pick/100)-1]+(pick%100)-1];
            thisPick.teamId = destiny;
            thisPick.teamName = destiny === 0 ? '@Model.Location @Model.Mascot' : franchiseNames[destiny].name;
            thisPick.teamAbbr = destiny === 0 ? '@Model.Abb' : franchiseNames[destiny].abbreviation;
            thisPick.isUserControlled = draftMethod !== 'full' && (destiny === 0 || (draftMethod === 'multiple' && selectedFranchises.includes(destiny)));
            thisPick.selectedPlayer = null;
            thisPick.neededPositions = [];
        }
    });
</script>

