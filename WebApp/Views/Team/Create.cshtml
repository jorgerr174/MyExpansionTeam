@model METCore.DTOs.Team.TeamBasicInfoDto

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Crear Nuevo Equipo</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.HiddenFor(m => m.Id)
                        @Html.HiddenFor(m => m.UserUsername)
                        @Html.HiddenFor(m => m.Date)
                        @Html.HiddenFor(m => m.Complete)
                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Location, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Location, new { @class = "form-control", placeholder = "Introduzca la ubicación (p.e., Valladolid)" })
                            @Html.ValidationMessageFor(m => m.Location, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Mascot, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Mascot, new { @class = "form-control", placeholder = "Introduzca la mascota(p.e., Pingüinos)" })
                            @Html.ValidationMessageFor(m => m.Mascot, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(m => m.Abb, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Abb, new { @class = "form-control", placeholder = "Introduzca la abreviatura (p.e., VLL)", minlength = "2", maxlength = "3" })
                            @Html.ValidationMessageFor(m => m.Abb, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">Crear equipo</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>