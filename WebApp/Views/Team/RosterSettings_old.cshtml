@model METCore.DTOs.Team.TeamInfoDto

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h2>NFL Expansion Team Settings - @Model.Location @Model.Mascot</h2>

            <!-- Phase Navigation -->
            <ul class="nav nav-pills mb-4" id="phaseNavigation" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="settings-tab" data-bs-toggle="pill" data-bs-target="#settings-phase" type="button" role="tab">
                        <i class="fas fa-cog me-2"></i>Team Settings
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link disabled" id="protection-tab" data-bs-toggle="pill" data-bs-target="#protection-phase" type="button" role="tab" disabled>
                        <i class="fas fa-shield-alt me-2"></i>Protected Players
                        <span class="badge bg-secondary ms-2" id="protection-count">0/0</span>
                    </button>
                </li>
            </ul>

            <form asp-action="SaveRosterSettings" method="post" id="teamSettingsForm">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.Location)
                @Html.HiddenFor(m => m.Mascot)
                @Html.HiddenFor(m => m.Abb)
                @Html.HiddenFor(m => m.UserUsername)
                @Html.HiddenFor(m => m.Date)
                @Html.HiddenFor(m => m.Complete)
                
                <!-- Container for dynamic protected player hidden fields -->
                <div id="protectedPlayersContainer">
                    @* Initialize with existing protected players if any *@
                    @if (Model.RosterSettingsProtectedPlayersIds != null)
                    {
                        @for (int i = 0; i < Model.RosterSettingsProtectedPlayersIds.Count; i++)
                        {
                            <input type="hidden" name="RosterSettingsProtectedPlayersIds[@i]" value="@Model.RosterSettingsProtectedPlayersIds[i]" />
                        }
                    }
                </div>

                <div class="tab-content">
                    <!-- Phase 1: Team Settings Configuration -->
                    <div class="tab-pane fade show active" id="settings-phase" role="tabpanel">
                        <div class="card">
                            <div class="card-header">
                                <h4>Configure Team Settings</h4>
                                <p class="text-muted mb-0">Set the parameters for your expansion team creation</p>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group mb-3">
                                            @Html.LabelFor(m => m.RosterSettingsCap, new { @class = "form-label" })
                                            @Html.TextBoxFor(m => m.RosterSettingsCap, new { @class = "form-control", @type = "number", @step = "1", @min = "60", @max = "120", @id = "salaryCapInput" })
                                            @Html.ValidationMessageFor(m => m.RosterSettingsCap, "", new { @class = "text-danger" })
                                            <div class="form-text">Percentage of current salary cap available (60 - 120)</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group mb-3">
                                            @Html.LabelFor(m => m.RosterSettingsMaxPerTeam, new { @class = "form-label" })
                                            @Html.TextBoxFor(m => m.RosterSettingsMaxPerTeam, new { @class = "form-control", @type = "number", @min = "2", @max = "10", @id = "maxPerTeamInput" })
                                            @Html.ValidationMessageFor(m => m.RosterSettingsMaxPerTeam, "", new { @class = "text-danger" })
                                            <div class="form-text">Maximum players you can draft from each team (2-10)</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group mb-3">
                                            @Html.LabelFor(m => m.RosterSettingsProtectedPerTeam, new { @class = "form-label" })
                                            @Html.TextBoxFor(m => m.RosterSettingsProtectedPerTeam, new { @class = "form-control", @type = "number", @min = "0", @max = "6", @id = "protectedPerTeamInput" })
                                            @Html.ValidationMessageFor(m => m.RosterSettingsProtectedPerTeam, "", new { @class = "text-danger" })
                                            <div class="form-text">Players each team can protect from draft (0-6)</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Settings Impact Preview -->
                                <div class="alert alert-info" id="settingsPreview">
                                    <h6><i class="fas fa-info-circle me-2"></i>Team Creation Impact</h6>
                                    <div id="impactSummary">
                                        <div><strong>Salary Cap:</strong> $<span id="availableCap">0</span>M available</div>
                                        <div><strong>Player Pool:</strong> <span id="totalProtected">0</span> protected, <span id="availablePlayers">0</span> available for draft</div>
                                        <div><strong>Draft Potential:</strong> Max <span id="maxDraftable">0</span> players total</div>
                                    </div>
                                </div>

                                <!-- Protection Method Selection -->
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6>Player Protection Method</h6>
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="radio" name="protectionMethod" id="defaultProtection" value="default" checked>
                                            <label class="form-check-label" for="defaultProtection">
                                                <strong>Use Default Protection</strong>
                                                <div class="form-text">Automatically protect each team's highest-paid players (recommended for quick setup)</div>
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="protectionMethod" id="manualProtection" value="manual">
                                            <label class="form-check-label" for="manualProtection">
                                                <strong>Manual Player Selection</strong>
                                                <div class="form-text">Choose specific players to protect from each team</div>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end mt-4">
                                    <button type="button" class="btn btn-primary" id="proceedButton">
                                        <span id="proceedButtonText">Save Settings</span>
                                        <i class="fas fa-arrow-right ms-2"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Phase 2: Manual Player Protection -->
                    <div class="tab-pane fade" id="protection-phase" role="tabpanel">
                        <div class="row">
                            <!-- Team Selection Sidebar -->
                            <div class="col-md-3">
                                <div class="card sticky-top" style="top: 20px;">
                                    <div class="card-header">
                                        <h5>NFL Teams</h5>
                                        <div class="progress mt-2" style="height: 6px;">
                                            <div class="progress-bar" id="overallProgress" style="width: 0%"></div>
                                        </div>
                                        <small class="text-muted">
                                            <span id="completedTeams">0</span> of 32 teams completed
                                        </small>
                                    </div>
                                    <div class="card-body p-0" style="max-height: 600px; overflow-y: auto;">
                                        <div class="list-group list-group-flush" id="teamsList">
                                            <!-- Teams will be populated here -->
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Player Selection Area -->
                            <div class="col-md-9">
                                <div class="card">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <div>
                                            <h5 id="currentTeamName">Select a team</h5>
                                            <div class="d-flex align-items-center">
                                                <span class="badge bg-primary me-2" id="selectedCount">0</span>
                                                <span class="text-muted">of <span id="maxProtected">0</span> protected</span>
                                            </div>
                                        </div>
                                        <div>
                                            <button type="button" class="btn btn-sm btn-outline-danger" id="clearTeamSelection" style="display: none;">
                                                <i class="fas fa-times me-1"></i>Clear Team
                                            </button>
                                        </div>
                                    </div>
                                    <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                                        <div id="playerSelectionArea">
                                            <div class="text-center text-muted p-5">
                                                <i class="fas fa-hand-point-left fa-2x mb-3"></i>
                                                <p>Select a team from the sidebar to begin protecting players</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="d-flex justify-content-between">
                                    <button type="button" class="btn btn-outline-secondary" id="backToSettings">
                                        <i class="fas fa-arrow-left me-2"></i>Back to Settings
                                    </button>
                                    <button type="submit" class="btn btn-success" id="saveSettings" disabled>
                                        <i class="fas fa-save me-2"></i>Save Team Configuration
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function () {
        // State variables
        let protectedPlayersArray = [];
        let currentTeamId = null;
        let protectedPerTeam = parseInt(document.getElementById('protectedPerTeamInput').value) || 3;
        let isManualProtection = false;

        // NFL teams data - will be populated from API
        const nflTeams = {};
        const teamPlayersCache = {}; // Cache loaded team players

        // Team names mapping
        const teamNames = {
            1: { name: "Arizona Cardinals", abbreviation: "ARI" },
            2: { name: "Atlanta Falcons", abbreviation: "ATL" },
            3: { name: "Baltimore Ravens", abbreviation: "BAL" },
            4: { name: "Buffalo Bills", abbreviation: "BUF" },
            5: { name: "Carolina Panthers", abbreviation: "CAR" },
            6: { name: "Chicago Bears", abbreviation: "CHI" },
            7: { name: "Cincinnati Bengals", abbreviation: "CIN" },
            8: { name: "Cleveland Browns", abbreviation: "CLE" },
            9: { name: "Dallas Cowboys", abbreviation: "DAL" },
            10: { name: "Denver Broncos", abbreviation: "DEN" },
            11: { name: "Detroit Lions", abbreviation: "DET" },
            12: { name: "Green Bay Packers", abbreviation: "GB" },
            13: { name: "Houston Texans", abbreviation: "HOU" },
            14: { name: "Indianapolis Colts", abbreviation: "IND" },
            15: { name: "Jacksonville Jaguars", abbreviation: "JAX" },
            16: { name: "Kansas City Chiefs", abbreviation: "KC" },
            17: { name: "Las Vegas Raiders", abbreviation: "LV" },
            18: { name: "Los Angeles Chargers", abbreviation: "LAC" },
            19: { name: "Los Angeles Rams", abbreviation: "LAR" },
            20: { name: "Miami Dolphins", abbreviation: "MIA" },
            21: { name: "Minnesota Vikings", abbreviation: "MIN" },
            22: { name: "New England Patriots", abbreviation: "NE" },
            23: { name: "New Orleans Saints", abbreviation: "NO" },
            24: { name: "New York Giants", abbreviation: "NYG" },
            25: { name: "New York Jets", abbreviation: "NYJ" },
            26: { name: "Philadelphia Eagles", abbreviation: "PHI" },
            27: { name: "Pittsburgh Steelers", abbreviation: "PIT" },
            28: { name: "San Francisco 49ers", abbreviation: "SF" },
            29: { name: "Seattle Seahawks", abbreviation: "SEA" },
            30: { name: "Tampa Bay Buccaneers", abbreviation: "TB" },
            31: { name: "Tennessee Titans", abbreviation: "TEN" },
            32: { name: "Washington Commanders", abbreviation: "WAS" }
        };

        // Initialize protected players from existing hidden fields
        function initializeProtectedPlayers() {
            const container = document.getElementById('protectedPlayersContainer');
            const existingInputs = container.querySelectorAll('input[name*="RosterSettingsProtectedPlayersIds"]');
            protectedPlayersArray = [];
            
            existingInputs.forEach(input => {
                const value = parseInt(input.value);
                if (!isNaN(value)) {
                    protectedPlayersArray.push(value);
                }
            });
        }

        // Settings Phase Functions
        function updateSettingsPreview() {
            const salaryCapPct = parseFloat(document.getElementById('salaryCapInput').value) || 80;
            const maxPerTeam = parseInt(document.getElementById('maxPerTeamInput').value) || 3;
            protectedPerTeam = parseInt(document.getElementById('protectedPerTeamInput').value) || 3;

            // NFL salary cap is approximately $224M in 2023
            const baseSalaryCap = 224;
            const availableCap = Math.round(baseSalaryCap * salaryCapPct / 100);

            const totalTeams = 32; // Total number of franchises
            const totalProtected = protectedPerTeam * totalTeams;
            const playersPerTeam = 53; // Standard NFL roster size
            const totalPlayers = playersPerTeam * totalTeams;
            const availablePlayers = totalPlayers - totalProtected;
            const maxDraftable = Math.min(availablePlayers, maxPerTeam * totalTeams);

            document.getElementById('availableCap').textContent = availableCap;
            document.getElementById('totalProtected').textContent = totalProtected;
            document.getElementById('availablePlayers').textContent = availablePlayers;
            document.getElementById('maxDraftable').textContent = maxDraftable;
            document.getElementById('maxProtected').textContent = protectedPerTeam;

            updateProtectionCount();
            updateProceedButton();
        }

        function updateProceedButton() {
            isManualProtection = document.getElementById('manualProtection').checked;

            if (isManualProtection) {
                document.getElementById('proceedButtonText').textContent = 'Proceed to Player Selection';
            } else {
                document.getElementById('proceedButtonText').textContent = 'Save Settings';
            }
        }

        // Event handlers for settings
        ['salaryCapInput', 'maxPerTeamInput', 'protectedPerTeamInput'].forEach(id => {
            document.getElementById(id).addEventListener('input', updateSettingsPreview);
            document.getElementById(id).addEventListener('change', updateSettingsPreview);
        });

        document.querySelectorAll('input[name="protectionMethod"]').forEach(radio => {
            radio.addEventListener('change', updateProceedButton);
        });

        document.getElementById('proceedButton').addEventListener('click', function () {
            if (validateSettings()) {
                if (isManualProtection) {
                    // Enable protection phase
                    populateTeamsList();
                    const protectionTab = document.getElementById('protection-tab');
                    protectionTab.classList.remove('disabled');
                    protectionTab.disabled = false;
                    // Show protection tab (Bootstrap 5 way)
                    const tab = new bootstrap.Tab(protectionTab);
                    tab.show();
                    // Automatically load the first team
                    setTimeout(() => {
                        selectTeam(1);
                    }, 100);
                } else {
                    // Apply default protection and submit
                    applyDefaultProtection();
                    document.getElementById('teamSettingsForm').submit();
                }
            }
        });

        function validateSettings() {
            const salaryCapPct = parseFloat(document.getElementById('salaryCapInput').value);
            const maxPerTeam = parseInt(document.getElementById('maxPerTeamInput').value);
            const protectedPerTeam = parseInt(document.getElementById('protectedPerTeamInput').value);

            if (salaryCapPct < 60 || salaryCapPct > 120) {
                alert('Salary cap percentage must be between 60 and 120');
                return false;
            }

            if (maxPerTeam < 2 || maxPerTeam > 10) {
                alert('Max players per team must be between 2 and 10');
                return false;
            }

            if (protectedPerTeam < 0 || protectedPerTeam > 6) {
                alert('Protected players per team must be between 0 and 6');
                return false;
            }

            return true;
        }

        function applyDefaultProtection() {
            protectedPlayersArray = [];

            // For each team, protect the top N highest-paid players
            Object.values(nflTeams).forEach(team => {
                const sortedPlayers = team.players.sort((a, b) => b.salary - a.salary);
                const playersToProtect = sortedPlayers.slice(0, protectedPerTeam);
                playersToProtect.forEach(player => {
                    protectedPlayersArray.push(player.id);
                });
            });

            updateProtectedPlayersHiddenFields();
        }

        // Protection Phase Functions
        function populateTeamsList() {
            const teamsList = document.getElementById('teamsList');
            teamsList.innerHTML = '';

            // Initialize teams list with actual team names
            for (let FranchiseId = 1; FranchiseId <= 32; FranchiseId++) {
                const protectedCount = getTeamProtectedCount(FranchiseId);
                const isComplete = protectedCount === protectedPerTeam;
                const statusClass = isComplete ? 'list-group-item-success' :
                    protectedCount > 0 ? 'list-group-item-warning' : '';

                const teamInfo = teamNames[FranchiseId] || { name: `Team ${FranchiseId}`, abbreviation: `T${FranchiseId}` };

                const teamItem = document.createElement('a');
                teamItem.href = '#';
                teamItem.className = `list-group-item list-group-item-action team-item ${statusClass}`;
                teamItem.setAttribute('data-team-id', FranchiseId);
                teamItem.innerHTML = `
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong>${teamInfo.name}</strong>
                        <br><small class="text-muted">${teamInfo.abbreviation}</small>
                    </div>
                    <span class="badge ${isComplete ? 'bg-success' : protectedCount > 0 ? 'bg-warning' : 'bg-secondary'}">${protectedCount}/${protectedPerTeam}</span>
                </div>
            `;

                teamItem.addEventListener('click', function (e) {
                    e.preventDefault();
                    const teamId = parseInt(this.getAttribute('data-team-id'));
                    selectTeam(teamId);
                });

                teamsList.appendChild(teamItem);
            }

            updateOverallProgress();
        }

        function selectTeam(teamId) {
            currentTeamId = teamId;
            document.querySelectorAll('.team-item').forEach(item => item.classList.remove('active'));
            document.querySelector(`.team-item[data-team-id="${teamId}"]`).classList.add('active');

            const teamInfo = teamNames[teamId] || { name: `Team ${teamId}`, abbreviation: `T${teamId}` };

            // Show loading state
            document.getElementById('currentTeamName').textContent = `Loading ${teamInfo.name}...`;
            document.getElementById('clearTeamSelection').style.display = 'none';

            const container = document.getElementById('playerSelectionArea');
            container.innerHTML = `
        <div class="text-center p-5">
            <div class="spinner-border text-primary mb-3" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted">Loading players...</p>
        </div>
    `;

            // Check if team data is already cached
            if (teamPlayersCache[teamId]) {
                displayPlayersForTeam(teamPlayersCache[teamId]);
                document.getElementById('currentTeamName').textContent = teamPlayersCache[teamId].name;
                document.getElementById('clearTeamSelection').style.display = 'block';
                updateSelectedCount();
                return;
            }

            // Make API call to get team players - Updated to handle JSON response
            fetch(`/Team/GetProtectablePlayers?FranchiseId=${teamId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json(); // Changed from response.text() to response.json()
                })
                .then(data => {
                    // Handle the JSON response
                    if (data.error || !Array.isArray(data)) {
                        throw new Error('Invalid response format');
                    }

                    // Create team data from JSON response
                    const teamData = createTeamDataFromJson(data, teamId);

                    // Cache the team data
                    teamPlayersCache[teamId] = teamData;
                    nflTeams[teamId] = teamData;

                    // Update UI
                    document.getElementById('currentTeamName').textContent = teamData.name;
                    document.getElementById('clearTeamSelection').style.display = 'block';

                    displayPlayersForTeam(teamData);
                    updateSelectedCount();
                })
                .catch(error => {
                    console.error('Error loading team data:', error);
                    container.innerHTML = `
                <div class="text-center text-danger p-5">
                    <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                    <p>Error loading team data. Please try again.</p>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="selectTeam(${teamId})">
                        <i class="fas fa-redo me-1"></i>Retry
                    </button>
                </div>
            `;
                });
        }

        // Create team data from JSON response
        function createTeamDataFromJson(playersData, teamId) {
            const teamInfo = teamNames[teamId] || { name: `Team ${teamId}`, abbreviation: `T${teamId}` };

            const teamData = {
                id: teamId,
                name: teamInfo.name,
                abbreviation: teamInfo.abbreviation,
                players: playersData
            };

            return teamData;
        }

        // Updated displayPlayersForTeam function to handle the new data structure and defaultProtected
        function displayPlayersForTeam(team) {
            const container = document.getElementById('playerSelectionArea');
            container.innerHTML = '';

            // Process default protected players first
            team.players.forEach(player => {
                if (player.defaultProtected && !protectedPlayersArray.includes(player.id)) {
                    protectedPlayersArray.push(player.id);
                }
            });

            // Update UI elements after processing default protected players
            updateProtectedPlayersHiddenFields();
            updateSelectedCount();
            populateTeamsList(); // Refresh team status

            // Group players by position
            const playersByPosition = {};
            team.players.forEach(player => {
                if (!playersByPosition[player.position]) {
                    playersByPosition[player.position] = [];
                }
                playersByPosition[player.position].push(player);
            });

            // Create position sections
            Object.keys(playersByPosition).forEach(position => {
                const positionSection = document.createElement('div');
                positionSection.className = 'mb-4';
                positionSection.innerHTML = `
            <h6 class="text-muted mb-3">${position}</h6>
            <div class="row" id="position-${position}">
            </div>
        `;

                const positionContainer = positionSection.querySelector(`#position-${position}`);

                playersByPosition[position].forEach(player => {
                    const isProtected = protectedPlayersArray.includes(player.id);
                    const playerDiv = document.createElement('div');
                    playerDiv.className = 'col-md-6 col-lg-4 mb-2';

                    // Updated to show salary from APY field
                    playerDiv.innerHTML = `
                <div class="card player-card ${isProtected ? 'protected' : ''}" data-player-id="${player.id}">
                    <div class="card-body">
                        <div class="player-header">
                            <div class="player-info">
                                <h6 class="player-title">${player.name}</h6>
                                <small class="player-details">${player.position} | ${player.age}</small>
                                <br>
                                <small class="player-details">${player.height} | ${player.weight}</small>
                            </div>
                            <div class="player-stats">
                                <small class="player-salary">${player.apy}</small><br>
                            </div>
                        </div>
                    </div>
                </div>
            `;

                    const playerCard = playerDiv.querySelector('.player-card');
                    playerCard.addEventListener('click', function () {
                        const playerId = parseInt(this.getAttribute('data-player-id'));
                        const isCurrentlyProtected = protectedPlayersArray.includes(playerId);

                        if (isCurrentlyProtected) {
                            // Remove protection
                            protectedPlayersArray = protectedPlayersArray.filter(id => id !== playerId);
                            this.classList.remove('protected');
                        } else {
                            // Add protection (with limit check)
                            const currentTeamProtected = getTeamProtectedCount(currentTeamId);
                            if (currentTeamProtected < protectedPerTeam) {
                                protectedPlayersArray.push(playerId);
                                this.classList.add('protected');
                            } else {
                                alert(`You can only protect ${protectedPerTeam} players per team.`);
                                return;
                            }
                        }

                        updateProtectedPlayersHiddenFields();
                        updateSelectedCount();
                        populateTeamsList(); // Refresh team status
                    });

                    positionContainer.appendChild(playerDiv);
                });

                container.appendChild(positionSection);
            });
        }

        function getTeamProtectedCount(teamId) {
            const team = nflTeams[teamId] || teamPlayersCache[teamId];
            if (!team) return 0;

            return protectedPlayersArray.filter(id =>
                team.players.some(p => p.id === id)
            ).length;
        }

        function updateSelectedCount() {
            if (currentTeamId) {
                const count = getTeamProtectedCount(currentTeamId);
                document.getElementById('selectedCount').textContent = count;
            }
        }

        function updateProtectionCount() {
            const totalTeams = 32; // Total number of franchises
            const total = protectedPerTeam * totalTeams;
            const current = protectedPlayersArray.length;
            document.getElementById('protection-count').textContent = `${current}/${total}`;
        }

        function updateOverallProgress() {
            const totalTeams = 32; // Total number of franchises
            const completedTeams = Array.from({ length: 32 }, (_, i) => i + 1).filter(teamId => {
                return getTeamProtectedCount(teamId) === protectedPerTeam;
            }).length;

            document.getElementById('completedTeams').textContent = completedTeams;
            const percentage = (completedTeams / totalTeams) * 100;
            document.getElementById('overallProgress').style.width = `${percentage}%`;

            // Enable/disable save button
            document.getElementById('saveSettings').disabled = completedTeams < totalTeams;
        }

        // NEW: Function to update hidden fields for proper model binding
        function updateProtectedPlayersHiddenFields() {
            const container = document.getElementById('protectedPlayersContainer');

            // Clear existing hidden fields
            container.innerHTML = '';

            // Create new hidden fields for each protected player ID
            protectedPlayersArray.forEach((playerId, index) => {
                const hiddenInput = document.createElement('input');
                hiddenInput.type = 'hidden';
                hiddenInput.name = `RosterSettingsProtectedPlayersIds[${index}]`;
                hiddenInput.value = playerId;
                container.appendChild(hiddenInput);
            });

            updateProtectionCount();
            if (isManualProtection) {
                updateOverallProgress();
            }
        }

        function updateProtectionCount() {
            const totalTeams = 32; // Total number of franchises
            const total = protectedPerTeam * totalTeams;
            const current = protectedPlayersArray.length;
            document.getElementById('protection-count').textContent = `${current}/${total}`;
        }

        function updateOverallProgress() {
            const totalTeams = 32; // Total number of franchises
            const completedTeams = Array.from({ length: 32 }, (_, i) => i + 1).filter(teamId => {
                return getTeamProtectedCount(teamId) === protectedPerTeam;
            }).length;

            document.getElementById('completedTeams').textContent = completedTeams;
            const percentage = (completedTeams / totalTeams) * 100;
            document.getElementById('overallProgress').style.width = `${percentage}%`;

            // Enable/disable save button
            document.getElementById('saveSettings').disabled = completedTeams < totalTeams;
        }

        document.getElementById('clearTeamSelection').addEventListener('click', function () {
            if (currentTeamId) {
                const team = nflTeams[currentTeamId] || teamPlayersCache[currentTeamId];
                if (team) {
                    team.players.forEach(player => {
                        protectedPlayersArray = protectedPlayersArray.filter(id => id !== player.id);
                    });

                    updateProtectedPlayersHiddenFields();
                    displayPlayersForTeam(team);
                    updateSelectedCount();
                    populateTeamsList();
                }
            }
        });

        document.getElementById('backToSettings').addEventListener('click', function () {
            const settingsTab = new bootstrap.Tab(document.getElementById('settings-tab'));
            settingsTab.show();
        });

        // Initialize - ADD THIS CALL
        initializeProtectedPlayers();
        updateSettingsPreview();
    });
</script>

