@model METCore.DTOs.Team.TradeDto

<!-- Trade Modal Content -->
<div class="container-fluid">
    <!-- Step 1: Franchise Selection -->
    <div id="franchiseSelectionStep" class="trade-step">
        <h6 class="mb-3">Select Franchise to Trade With</h6>
        <div class="row" id="franchiseGrid">
            <!-- Franchises will be populated here -->
        </div>
    </div>

    <!-- Step 2: Trade Builder -->
    <div id="tradeBuilderStep" class="trade-step" style="display: none;">
        <!-- Hidden form for trade data -->
        <form id="tradeForm">
            @Html.HiddenFor(m => m.Id)
            <input type="hidden" id="FranchiseId" name="FranchiseId" value="@Model.FranchiseId" />
            <input type="hidden" id="Force" name="Force" value="false" />

            <!-- Hidden fields for players -->
            <div id="playersTakenContainer">
                <!-- Will be populated dynamically -->
            </div>

            <div id="playersSentContainer">
                <!-- Will be populated dynamically -->
            </div>

            <!-- Hidden fields for picks -->
            <div id="picksTakenContainer">
                <!-- Will be populated dynamically -->
            </div>

            <div id="picksSentContainer">
                <!-- Will be populated dynamically -->
            </div>
        </form>

        <!-- Trade Equality Bar -->
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="mb-2">Trade Value Comparison</h6>
                <div class="progress" style="height: 20px;">
                    <div class="progress-bar bg-primary" id="userSideBar" style="width: 50%;">
                        <span id="userSideValue">0</span>
                    </div>
                    <div class="progress-bar bg-success" id="franchiseSideBar" style="width: 50%;">
                        <span id="franchiseSideValue">0</span>
                    </div>
                </div>
                <div class="d-flex justify-content-between mt-1">
                    <small class="text-muted">Your Side: <span id="userTotalValue">0</span> pts</small>
                    <small class="text-muted">Their Side: <span id="franchiseTotalValue">0</span> pts</small>
                </div>
                <div class="text-center mt-2">
                    <span class="badge" id="equalityBadge">No Items Selected</span>
                </div>
            </div>
        </div>

        <!-- Trade Items -->
        <div class="row">
            <!-- Your Side -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h6 class="mb-0">Your Offer</h6>
                    </div>
                    <div class="card-body">
                        <!-- Your Selected Items -->
                        <div class="mb-3">
                            <h6>Selected Items to Trade</h6>
                            <div id="userSelectedItems" class="selected-items-container">
                                <div class="text-muted text-center p-3">
                                    <i class="fas fa-plus-circle fa-2x mb-2"></i>
                                    <p>Select picks or players to trade away</p>
                                </div>
                            </div>
                        </div>

                        <!-- Your Available Items -->
                        <div class="available-items">
                            <ul class="nav nav-tabs" id="userItemTabs" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" id="user-picks-tab" data-bs-toggle="tab" data-bs-target="#user-picks" type="button" role="tab">
                                        Draft Picks
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="user-players-tab" data-bs-toggle="tab" data-bs-target="#user-players" type="button" role="tab">
                                        Players
                                    </button>
                                </li>
                            </ul>
                            <div class="tab-content" id="userItemTabContent">
                                <div class="tab-pane fade show active" id="user-picks" role="tabpanel">
                                    <div id="userPicksList" class="items-list">
                                        <!-- User's available picks will be loaded here -->
                                    </div>
                                </div>
                                <div class="tab-pane fade" id="user-players" role="tabpanel">
                                    <div id="userPlayersList" class="items-list">
                                        <!-- User's available players will be loaded here -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Their Side -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h6 class="mb-0">Request From <span id="selectedFranchiseName">Franchise</span></h6>
                    </div>
                    <div class="card-body">
                        <!-- Their Selected Items -->
                        <div class="mb-3">
                            <h6>Requested Items</h6>
                            <div id="franchiseSelectedItems" class="selected-items-container">
                                <div class="text-muted text-center p-3">
                                    <i class="fas fa-plus-circle fa-2x mb-2"></i>
                                    <p>Select picks or players to request</p>
                                </div>
                            </div>
                        </div>

                        <!-- Their Available Items -->
                        <div class="available-items">
                            <ul class="nav nav-tabs" id="franchiseItemTabs" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" id="franchise-picks-tab" data-bs-toggle="tab" data-bs-target="#franchise-picks" type="button" role="tab">
                                        Draft Picks
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="franchise-players-tab" data-bs-toggle="tab" data-bs-target="#franchise-players" type="button" role="tab">
                                        Players
                                    </button>
                                </li>
                            </ul>
                            <div class="tab-content" id="franchiseItemTabContent">
                                <div class="tab-pane fade show active" id="franchise-picks" role="tabpanel">
                                    <div id="franchisePicksList" class="items-list">
                                        <!-- Franchise's available picks will be loaded here -->
                                    </div>
                                </div>
                                <div class="tab-pane fade" id="franchise-players" role="tabpanel">
                                    <div id="franchisePlayersList" class="items-list">
                                        <!-- Franchise's available players will be loaded here -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex justify-content-between mt-3">
            <div>
                <button type="button" class="btn btn-secondary" onclick="goBackToFranchiseSelection()">
                    <i class="fas fa-arrow-left me-2"></i>Change Franchise
                </button>
                <button type="button" class="btn btn-outline-secondary" onclick="cancelTrade()">
                    <i class="fas fa-times me-2"></i>Cancel Trade
                </button>
            </div>
            <div class="btn-group">
                <button type="button" class="btn btn-primary" id="requestTradeBtn" onclick="submitTrade(false)">
                    <i class="fas fa-handshake me-2"></i>Request Trade
                </button>
                <button type="button" class="btn btn-warning" id="forceTradeBtn" onclick="submitTrade(true)">
                    <i class="fas fa-bolt me-2"></i>Force Trade
                </button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        // Trade state variables
        let selectedFranchiseId = @Model.FranchiseId;
        let selectedFranchiseName = '';
        let userSelectedPicks = [];    // Format: "r1p1"
        let userSelectedPlayers = [];  // SelectableDto objects
        let franchiseSelectedPicks = []; // Format: "r1p1"
        let franchiseSelectedPlayers = []; // SelectableDto objects
        let userTotalValue = 0;
        let franchiseTotalValue = 0;
        let currentPickNumber = 0; // Current pick in draft to filter passed picks

        // Available items from model
        let availableUserPicks = [];
        let availableUserPlayers = @Html.Raw(Json.Serialize(Model.FranchisePlayers ?? []));
        let availableFranchisePicks = [];
        let availableFranchisePlayers = @Html.Raw(Json.Serialize(Model.TeamPlayers ?? []));

        // NFL Franchises
        const nflFranchises = {
            1: { name: "Arizona Cardinals", abbreviation: "ARIZ" },
            2: { name: "Atlanta Falcons", abbreviation: "ATL" },
            3: { name: "Baltimore Ravens", abbreviation: "BAL" },
            4: { name: "Buffalo Bills", abbreviation: "BUF" },
            5: { name: "Carolina Panthers", abbreviation: "CAR" },
            6: { name: "Chicago Bears", abbreviation: "CHI" },
            7: { name: "Cincinnati Bengals", abbreviation: "CIN" },
            8: { name: "Cleveland Browns", abbreviation: "CLE" },
            9: { name: "Dallas Cowboys", abbreviation: "DAL" },
            10: { name: "Denver Broncos", abbreviation: "DEN" },
            11: { name: "Detroit Lions", abbreviation: "DET" },
            12: { name: "Green Bay Packers", abbreviation: "GB" },
            13: { name: "Houston Texans", abbreviation: "HOU" },
            14: { name: "Indianapolis Colts", abbreviation: "IND" },
            15: { name: "Jacksonville Jaguars", abbreviation: "JAX" },
            16: { name: "Kansas City Chiefs", abbreviation: "KC" },
            17: { name: "Las Vegas Raiders", abbreviation: "LV" },
            18: { name: "Los Angeles Chargers", abbreviation: "LAC" },
            19: { name: "Los Angeles Rams", abbreviation: "LAR" },
            20: { name: "Miami Dolphins", abbreviation: "MIA" },
            21: { name: "Minnesota Vikings", abbreviation: "MIN" },
            22: { name: "New England Patriots", abbreviation: "NE" },
            23: { name: "New Orleans Saints", abbreviation: "NO" },
            24: { name: "New York Giants", abbreviation: "NYG" },
            25: { name: "New York Jets", abbreviation: "NYJ" },
            26: { name: "Philadelphia Eagles", abbreviation: "PHI" },
            27: { name: "Pittsburgh Steelers", abbreviation: "PIT" },
            28: { name: "San Francisco 49ers", abbreviation: "SF" },
            29: { name: "Seattle Seahawks", abbreviation: "SEA" },
            30: { name: "Tampa Bay Buccaneers", abbreviation: "TB" },
            31: { name: "Tennessee Titans", abbreviation: "TEN" },
            32: { name: "Washington Commanders", abbreviation: "WAS" }
        };

        // Parse pick string (e.g., "r3p25") to get overall pick number
        function parsePickToOverall(pickString) {
            const match = pickString.match(/r(\d+)p(\d+)/);
            if (match) {
                const round = parseInt(match[1]);
                const pick = parseInt(match[2]);
                return ((round - 1) * 33) + pick;
            }
            return 0;
        }

        // Get current pick number from URL parameters
        function getCurrentPickNumber() {
            const urlParams = new URLSearchParams(window.location.search);
            return parseInt(urlParams.get('currentPick')) || 0;
        }

        // Filter out passed picks
        function filterPassedPicks(picks) {
            return picks.filter(pickString => {
                const overallPick = parsePickToOverall(pickString);
                return overallPick > currentPickNumber;
            });
        }

        // Initialize franchise selection
        function initializeFranchiseSelection() {
            currentPickNumber = getCurrentPickNumber();

            // Parse picks from model (format: "r1p1->101,r3p25->325")
            const userPicksString = '@string.Join(",", Model.FranchisePicks ?? new List<int>())';
            const franchisePicksString = '@string.Join(",", Model.TeamPicks ?? new List<int>())';

            if (userPicksString) {
                const picks = userPicksString.split(',');
                picks.forEach(pick => {
                    const parts = pick.split('->');
                    if (parts.length === 2) {
                        availableUserPicks.push(parts[0].trim());
                    }
                });
            }

            if (franchisePicksString) {
                const picks = franchisePicksString.split(',');
                picks.forEach(pick => {
                    const parts = pick.split('->');
                    if (parts.length === 2) {
                        availableFranchisePicks.push(parts[0].trim());
                    }
                });
            }

            // Filter out passed picks
            availableUserPicks = filterPassedPicks(availableUserPicks);
            availableFranchisePicks = filterPassedPicks(availableFranchisePicks);

            // If franchise is already selected, skip to trade builder
            if (selectedFranchiseId > 0) {
                selectedFranchiseName = nflFranchises[selectedFranchiseId]?.name || 'Unknown Franchise';
                showTradeBuilder();
                return;
            }

            const container = document.getElementById('franchiseGrid');
            container.innerHTML = '';

            Object.entries(nflFranchises).forEach(([id, franchise]) => {
                const franchiseId = parseInt(id);
                const col = document.createElement('div');
                col.className = 'col-md-3 col-sm-4 col-6 mb-2';

                col.innerHTML = `
                    <div class="card franchise-card" data-franchise-id="${franchiseId}" onclick="selectFranchise(${franchiseId}, '${franchise.name}')">
                        <div class="card-body text-center p-2">
                            <h6 class="mb-1">${franchise.name}</h6>
                            <small class="text-muted">${franchise.abbreviation}</small>
                        </div>
                    </div>
                `;

                container.appendChild(col);
            });
        }

        // Select franchise and show trade builder
        window.selectFranchise = function(franchiseId, franchiseName) {
            selectedFranchiseId = franchiseId;
            selectedFranchiseName = franchiseName;

            // Update hidden field
            document.getElementById('FranchiseId').value = franchiseId;

            // Need to reload trade data for selected franchise
            reloadTradeDataForFranchise(franchiseId);
        };

        // Reload trade data for selected franchise
        function reloadTradeDataForFranchise(franchiseId) {
            const tradeDto = {
                Id: @Model.Id,
                FranchiseId: franchiseId
            };

            fetch('/Team/GetTradePartial?' + new URLSearchParams(tradeDto))
            .then(response => response.text())
            .then(html => {
                // Parse the new data from the response and update available items
                // For now, show trade builder with current data
                showTradeBuilder();
            })
            .catch(error => {
                console.error('Error reloading trade data:', error);
                showTradeBuilder(); // Show with current data
            });
        }

        // Show trade builder step
        function showTradeBuilder() {
            document.getElementById('franchiseSelectionStep').style.display = 'none';
            document.getElementById('tradeBuilderStep').style.display = 'block';
            document.getElementById('selectedFranchiseName').textContent = selectedFranchiseName;

            populateTradeItems();
            updateTradeEquality();
        }

        // Populate trade items
        function populateTradeItems() {
            // Populate user's picks
            const userPicksContainer = document.getElementById('userPicksList');
            userPicksContainer.innerHTML = '';

            if (availableUserPicks.length > 0) {
                availableUserPicks.forEach(pickString => {
                    const pickDiv = createPickElement(pickString, 'user');
                    userPicksContainer.appendChild(pickDiv);
                });
            } else {
                userPicksContainer.innerHTML = '<div class="text-muted text-center p-3">No picks available</div>';
            }

            // Populate user's players
            const userPlayersContainer = document.getElementById('userPlayersList');
            userPlayersContainer.innerHTML = '';

            if (availableUserPlayers.length > 0) {
                availableUserPlayers.forEach(player => {
                    const playerDiv = createPlayerElement(player, 'user');
                    userPlayersContainer.appendChild(playerDiv);
                });
            } else {
                userPlayersContainer.innerHTML = '<div class="text-muted text-center p-3">No players available</div>';
            }

            // Populate franchise's picks
            const franchisePicksContainer = document.getElementById('franchisePicksList');
            franchisePicksContainer.innerHTML = '';

            if (availableFranchisePicks.length > 0) {
                availableFranchisePicks.forEach(pickString => {
                    const pickDiv = createPickElement(pickString, 'franchise');
                    franchisePicksContainer.appendChild(pickDiv);
                });
            } else {
                franchisePicksContainer.innerHTML = '<div class="text-muted text-center p-3">No picks available</div>';
            }

            // Populate franchise's players
            const franchisePlayersContainer = document.getElementById('franchisePlayersList');
            franchisePlayersContainer.innerHTML = '';

            if (availableFranchisePlayers.length > 0) {
                availableFranchisePlayers.forEach(player => {
                    const playerDiv = createPlayerElement(player, 'franchise');
                    franchisePlayersContainer.appendChild(playerDiv);
                });
            } else {
                franchisePlayersContainer.innerHTML = '<div class="text-muted text-center p-3">No players available</div>';
            }
        }

        // Create pick element
        function createPickElement(pickString, side) {
            const pickDiv = document.createElement('div');
            pickDiv.className = 'trade-item mb-2';

            // Parse pick string (e.g., "r3p25")
            const match = pickString.match(/r(\d+)p(\d+)/);
            const round = match ? match[1] : '?';
            const pick = match ? match[2] : '?';
            const overall = parsePickToOverall(pickString);

            pickDiv.innerHTML = `
                <div class="card trade-item-card" data-type="pick" data-id="${pickString}" data-value="10" data-side="${side}">
                    <div class="card-body p-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>Round ${round}, Pick ${pick}</strong>
                                <br><small class="text-muted">Overall: ${overall}</small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-info">10 pts</span>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            // Add click handler
            pickDiv.querySelector('.trade-item-card').addEventListener('click', function() {
                toggleItemSelection(this);
            });

            return pickDiv;
        }

        // Create player element
        function createPlayerElement(player, side) {
            const playerDiv = document.createElement('div');
            playerDiv.className = 'trade-item mb-2';

            playerDiv.innerHTML = `
                <div class="card trade-item-card" data-type="player" data-id="${player.id}" data-value="${player.value || 5}" data-side="${side}">
                    <div class="card-body p-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>${player.name || 'Unknown Player'}</strong>
                                <br><small class="text-muted">${player.description || 'Player'}</small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-success">${player.value || 5} pts</span>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            // Add click handler
            playerDiv.querySelector('.trade-item-card').addEventListener('click', function() {
                toggleItemSelection(this);
            });

            return playerDiv;
        }

        // Toggle item selection
        function toggleItemSelection(element) {
            const isSelected = element.classList.contains('selected');
            const type = element.getAttribute('data-type');
            const id = element.getAttribute('data-id');
            const value = parseInt(element.getAttribute('data-value'));
            const side = element.getAttribute('data-side');

            if (isSelected) {
                element.classList.remove('selected');
                removeFromSelection(type, id, side, value);
            } else {
                element.classList.add('selected');
                addToSelection(type, id, side, value);
            }

            updateSelectedItemsDisplay();
            updateTradeEquality();
            updateHiddenFields();
        }

        // Add item to selection
        function addToSelection(type, id, side, value) {
            if (side === 'user') {
                if (type === 'pick') {
                    userSelectedPicks.push(id);
                } else {
                    const player = availableUserPlayers.find(p => p.id == id);
                    if (player) userSelectedPlayers.push(player);
                }
                userTotalValue += value;
            } else {
                if (type === 'pick') {
                    franchiseSelectedPicks.push(id);
                } else {
                    const player = availableFranchisePlayers.find(p => p.id == id);
                    if (player) franchiseSelectedPlayers.push(player);
                }
                franchiseTotalValue += value;
            }
        }

        // Remove item from selection
        function removeFromSelection(type, id, side, value) {
            if (side === 'user') {
                if (type === 'pick') {
                    userSelectedPicks = userSelectedPicks.filter(pickId => pickId !== id);
                } else {
                    userSelectedPlayers = userSelectedPlayers.filter(p => p.id != id);
                }
                userTotalValue -= value;
            } else {
                if (type === 'pick') {
                    franchiseSelectedPicks = franchiseSelectedPicks.filter(pickId => pickId !== id);
                } else {
                    franchiseSelectedPlayers = franchiseSelectedPlayers.filter(p => p.id != id);
                }
                franchiseTotalValue -= value;
            }
        }

        // Update selected items display
        function updateSelectedItemsDisplay() {
            const userContainer = document.getElementById('userSelectedItems');
            const franchiseContainer = document.getElementById('franchiseSelectedItems');

            // Update user's selected items
            if (userSelectedPicks.length === 0 && userSelectedPlayers.length === 0) {
                userContainer.innerHTML = `
                    <div class="text-muted text-center p-3">
                        <i class="fas fa-plus-circle fa-2x mb-2"></i>
                        <p>Select picks or players to trade away</p>
                    </div>
                `;
            } else {
                let itemsHtml = '<div class="selected-items-list p-2">';
                userSelectedPicks.forEach(pick => {
                    itemsHtml += `<span class="badge bg-info me-1 mb-1">${pick}</span>`;
                });
                userSelectedPlayers.forEach(player => {
                    itemsHtml += `<span class="badge bg-success me-1 mb-1">${player.name}</span>`;
                });
                itemsHtml += '</div>';
                userContainer.innerHTML = itemsHtml;
            }

            // Update franchise's selected items
            if (franchiseSelectedPicks.length === 0 && franchiseSelectedPlayers.length === 0) {
                franchiseContainer.innerHTML = `
                    <div class="text-muted text-center p-3">
                        <i class="fas fa-plus-circle fa-2x mb-2"></i>
                        <p>Select picks or players to request</p>
                    </div>
                `;
            } else {
                let itemsHtml = '<div class="selected-items-list p-2">';
                franchiseSelectedPicks.forEach(pick => {
                    itemsHtml += `<span class="badge bg-info me-1 mb-1">${pick}</span>`;
                });
                franchiseSelectedPlayers.forEach(player => {
                    itemsHtml += `<span class="badge bg-success me-1 mb-1">${player.name}</span>`;
                });
                itemsHtml += '</div>';
                franchiseContainer.innerHTML = itemsHtml;
            }
        }

        // Update trade equality bar
        function updateTradeEquality() {
            const totalValue = userTotalValue + franchiseTotalValue;

            if (totalValue === 0) {
                document.getElementById('userSideBar').style.width = '50%';
                document.getElementById('franchiseSideBar').style.width = '50%';
                document.getElementById('equalityBadge').textContent = 'No Items Selected';
                document.getElementById('equalityBadge').className = 'badge bg-secondary';
            } else {
                const userPercentage = (userTotalValue / totalValue) * 100;
                const franchisePercentage = (franchiseTotalValue / totalValue) * 100;

                document.getElementById('userSideBar').style.width = userPercentage + '%';
                document.getElementById('franchiseSideBar').style.width = franchisePercentage + '%';

                // Update equality badge
                const difference = Math.abs(userTotalValue - franchiseTotalValue);
                const equalityBadge = document.getElementById('equalityBadge');

                if (difference <= 5) {
                    equalityBadge.textContent = 'Fair Trade';
                    equalityBadge.className = 'badge bg-success';
                } else if (difference <= 15) {
                    equalityBadge.textContent = 'Uneven Trade';
                    equalityBadge.className = 'badge bg-warning';
                } else {
                    equalityBadge.textContent = 'Unfair Trade';
                    equalityBadge.className = 'badge bg-danger';
                }
            }

            document.getElementById('userTotalValue').textContent = userTotalValue;
            document.getElementById('franchiseTotalValue').textContent = franchiseTotalValue;
            document.getElementById('userSideValue').textContent = userTotalValue;
            document.getElementById('franchiseSideValue').textContent = franchiseTotalValue;
        }

        // Update hidden fields for form submission
        function updateHiddenFields() {
            // Update players taken (SelectableDto objects)
            const playersTakenContainer = document.getElementById('playersTakenContainer');
            playersTakenContainer.innerHTML = '';
            franchiseSelectedPlayers.forEach((player, index) => {
                const hiddenInput = document.createElement('input');
                hiddenInput.type = 'hidden';
                hiddenInput.name = `PlayersTaken[${index}].Id`;
                hiddenInput.value = player.id;
                playersTakenContainer.appendChild(hiddenInput);

                const nameInput = document.createElement('input');
                nameInput.type = 'hidden';
                nameInput.name = `PlayersTaken[${index}].Name`;
                nameInput.value = player.name || '';
                playersTakenContainer.appendChild(nameInput);

                const valueInput = document.createElement('input');
                valueInput.type = 'hidden';
                valueInput.name = `PlayersTaken[${index}].Value`;
                valueInput.value = player.value || 0;
                playersTakenContainer.appendChild(valueInput);
            });

            // Update players sent
            const playersSentContainer = document.getElementById('playersSentContainer');
            playersSentContainer.innerHTML = '';
            userSelectedPlayers.forEach((player, index) => {
                const hiddenInput = document.createElement('input');
                hiddenInput.type = 'hidden';
                hiddenInput.name = `PlayersSent[${index}].Id`;
                hiddenInput.value = player.id;
                playersSentContainer.appendChild(hiddenInput);

                const nameInput = document.createElement('input');
                nameInput.type = 'hidden';
                nameInput.name = `PlayersSent[${index}].Name`;
                nameInput.value = player.name || '';
                playersSentContainer.appendChild(nameInput);

                const valueInput = document.createElement('input');
                valueInput.type = 'hidden';
                valueInput.name = `PlayersSent[${index}].Value`;
                valueInput.value = player.value || 0;
                playersSentContainer.appendChild(valueInput);
            });

            // Update picks taken (strings)
            const picksTakenContainer = document.getElementById('picksTakenContainer');
            picksTakenContainer.innerHTML = '';
            franchiseSelectedPicks.forEach((pick, index) => {
                const hiddenInput = document.createElement('input');
                hiddenInput.type = 'hidden';
                hiddenInput.name = `PicksTaken[${index}]`;
                hiddenInput.value = pick;
                picksTakenContainer.appendChild(hiddenInput);
            });

            // Update picks sent
            const picksSentContainer = document.getElementById('picksSentContainer');
            picksSentContainer.innerHTML = '';
            userSelectedPicks.forEach((pick, index) => {
                const hiddenInput = document.createElement('input');
                hiddenInput.type = 'hidden';
                hiddenInput.name = `PicksSent[${index}]`;
                hiddenInput.value = pick;
                picksSentContainer.appendChild(hiddenInput);
            });
        }

        // Submit trade (request or force)
        window.submitTrade = function(force) {
            if (userSelectedPicks.length === 0 && userSelectedPlayers.length === 0) {
                alert('Please select items to trade away');
                return;
            }

            if (franchiseSelectedPicks.length === 0 && franchiseSelectedPlayers.length === 0) {
                alert('Please select items to request');
                return;
            }

            if (selectedFranchiseId <= 0) {
                alert('Please select a franchise to trade with');
                return;
            }

            // Set force flag
            document.getElementById('Force').value = force.toString();

            // Update hidden fields
            updateHiddenFields();

            // Submit form
            const formData = new FormData(document.getElementById('tradeForm'));

            fetch('/Team/RequestTrade', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(result => {
                if (!result.message || result.message.trim() === '') {
                    // Trade accepted
                    alert('Trade completed successfully!');

                    // Prepare trade result for parent window
                    const tradeResult = {
                        success: true,
                        picksReceived: franchiseSelectedPicks,
                        picksGiven: userSelectedPicks,
                        playersReceived: franchiseSelectedPlayers.map(p => p.id),
                        playersGiven: userSelectedPlayers.map(p => p.id)
                    };

                    // Notify parent window
                    if (window.parent && window.parent.onTradeCompleted) {
                        window.parent.onTradeCompleted(tradeResult);
                    }
                } else {
                    // Trade rejected
                    alert('Trade was rejected: ' + result.message);
                }
            })
            .catch(error => {
                console.error('Error submitting trade:', error);
                alert('Error submitting trade. Please try again.');
            });
        };

        // Go back to franchise selection
        window.goBackToFranchiseSelection = function() {
            document.getElementById('tradeBuilderStep').style.display = 'none';
            document.getElementById('franchiseSelectionStep').style.display = 'block';

            // Reset selection
            selectedFranchiseId = 0;
            document.getElementById('FranchiseId').value = '0';
            resetTradeSelection();
        };

        // Cancel trade and close modal
        window.cancelTrade = function() {
            if (window.parent && window.parent.closeTradeModal) {
                window.parent.closeTradeModal();
            }
        };

        // Reset trade selection
        function resetTradeSelection() {
            userSelectedPicks = [];
            userSelectedPlayers = [];
            franchiseSelectedPicks = [];
            franchiseSelectedPlayers = [];
            userTotalValue = 0;
            franchiseTotalValue = 0;

            // Remove selected class from all items
            document.querySelectorAll('.trade-item-card.selected').forEach(card => {
                card.classList.remove('selected');
            });

            updateSelectedItemsDisplay();
            updateTradeEquality();
            updateHiddenFields();
        }

        // Initialize the view
        initializeFranchiseSelection();
    });
</script>

