@model METCore.DTOs.Team.TradeDto

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Trade Header Card -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">Trade Center</h4>
                        <span class="badge bg-light text-primary fs-6">Team Trade</span>
                    </div>
                </div>
                <div class="card-body">
                    <p class="mb-0 text-muted">Build and execute trades with other NFL franchises</p>
                </div>
            </div>

            <!-- Trade Steps -->
            <div id="franchiseSelectionStep" class="trade-step">
                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">Step 1: Select Franchise to Trade With</h5>
                    </div>
                    <div class="card-body">
                        <div class="row" id="franchiseGrid">
                            <!-- Franchises will be populated here -->
                        </div>
                    </div>
                </div>
            </div>

            <div id="tradeBuilderStep" class="trade-step" style="display: none;">
                <!-- Hidden form for trade data -->
                <form id="tradeForm">
                    @Html.HiddenFor(m => m.Id)
                    <input type="hidden" id="FranchiseId" name="FranchiseId" value="@Model.FranchiseId" />
                    <input type="hidden" id="Force" name="Force" value="false" />

                    <!-- Hidden fields containers -->
                    <div id="playersTakenContainer"></div>
                    <div id="playersSentContainer"></div>
                    <div id="picksTakenContainer"></div>
                    <div id="picksSentContainer"></div>
                </form>

                <!-- Trade Value Comparison Card -->
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Trade Value Comparison</h5>
                    </div>
                    <div class="card-body">
                        <div class="progress mb-3" style="height: 25px;">
                            <div class="progress-bar bg-primary" id="userSideBar" style="width: 50%;">
                                <span id="userSideValue" class="fw-bold">0</span>
                            </div>
                            <div class="progress-bar bg-success" id="franchiseSideBar" style="width: 50%;">
                                <span id="franchiseSideValue" class="fw-bold">0</span>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between">
                            <small class="text-muted">Your Side: <span id="userTotalValue" class="fw-bold">0</span> pts</small>
                            <small class="text-muted">Their Side: <span id="franchiseTotalValue" class="fw-bold">0</span> pts</small>
                        </div>
                        <div class="text-center mt-2">
                            <span class="badge bg-secondary" id="equalityBadge">No Items Selected</span>
                        </div>
                    </div>
                </div>

                <!-- Trade Items Row -->
                <div class="row">
                    <!-- Your Side -->
                    <div class="col-md-6 mb-4">
                        <div class="card h-100">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">Your Offer</h5>
                            </div>
                            <div class="card-body">
                                <!-- Selected Items -->
                                <div class="mb-3">
                                    <h6 class="fw-bold">Selected Items to Trade</h6>
                                    <div id="userSelectedItems" class="selected-items-container p-3 bg-light rounded">
                                        <div class="text-muted text-center">
                                            <i class="fas fa-plus-circle fa-2x mb-2"></i>
                                            <p class="mb-0">Select picks or players to trade away</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Available Items Tabs -->
                                <div class="available-items">
                                    <ul class="nav nav-tabs mb-3" id="userItemTabs" role="tablist">
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link active" id="user-picks-tab" data-bs-toggle="tab" data-bs-target="#user-picks" type="button" role="tab">
                                                <i class="fas fa-trophy me-1"></i>Draft Picks
                                            </button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link" id="user-players-tab" data-bs-toggle="tab" data-bs-target="#user-players" type="button" role="tab">
                                                <i class="fas fa-users me-1"></i>Players
                                            </button>
                                        </li>
                                    </ul>
                                    <div class="tab-content">
                                        <div class="tab-pane fade show active" id="user-picks" role="tabpanel">
                                            <div id="userPicksList" style="max-height: 400px; overflow-y: auto;">
                                                <!-- User picks will be populated here -->
                                            </div>
                                        </div>
                                        <div class="tab-pane fade" id="user-players" role="tabpanel">
                                            <div id="userPlayersList" style="max-height: 400px; overflow-y: auto;">
                                                <!-- User players will be populated here -->
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Their Side -->
                    <div class="col-md-6 mb-4">
                        <div class="card h-100">
                            <div class="card-header bg-success text-white">
                                <h5 class="mb-0">Their Offer</h5>
                            </div>
                            <div class="card-body">
                                <!-- Selected Items -->
                                <div class="mb-3">
                                    <h6 class="fw-bold">Selected Items to Receive</h6>
                                    <div id="franchiseSelectedItems" class="selected-items-container p-3 bg-light rounded">
                                        <div class="text-muted text-center">
                                            <i class="fas fa-plus-circle fa-2x mb-2"></i>
                                            <p class="mb-0">Select picks or players to receive</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Available Items Tabs -->
                                <div class="available-items">
                                    <ul class="nav nav-tabs mb-3" id="franchiseItemTabs" role="tablist">
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link active" id="franchise-picks-tab" data-bs-toggle="tab" data-bs-target="#franchise-picks" type="button" role="tab">
                                                <i class="fas fa-trophy me-1"></i>Draft Picks
                                            </button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link" id="franchise-players-tab" data-bs-toggle="tab" data-bs-target="#franchise-players" type="button" role="tab">
                                                <i class="fas fa-users me-1"></i>Players
                                            </button>
                                        </li>
                                    </ul>
                                    <div class="tab-content">
                                        <div class="tab-pane fade show active" id="franchise-picks" role="tabpanel">
                                            <div id="franchisePicksList" style="max-height: 400px; overflow-y: auto;">
                                                <!-- Franchise picks will be populated here -->
                                            </div>
                                        </div>
                                        <div class="tab-pane fade" id="franchise-players" role="tabpanel">
                                            <div id="franchisePlayersList" style="max-height: 400px; overflow-y: auto;">
                                                <!-- Franchise players will be populated here -->
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary" onclick="resetTrade()">
                                <i class="fas fa-undo me-1"></i>Reset Trade
                            </button>
                            <div>
                                <button type="button" class="btn btn-outline-primary me-2" onclick="goBackToFranchiseSelection()">
                                    <i class="fas fa-arrow-left me-1"></i>Change Franchise
                                </button>
                                <button type="button" class="btn btn-success" id="submitTradeBtn" disabled>
                                    <i class="fas fa-handshake me-1"></i>Submit Trade
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .selected-items-container {
        min-height: 100px;
        border: 2px dashed #dee2e6;
        border-radius: 0.375rem;
        transition: border-color 0.2s ease;
    }

        .selected-items-container:not(:empty) {
            border-color: var(--bs-success);
            background-color: rgba(25, 135, 84, 0.05) !important;
        }

    .trade-item {
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .trade-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .trade-item.selected {
            border-color: var(--bs-success) !important;
            background-color: rgba(25, 135, 84, 0.1);
        }

    .progress-bar {
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
    }

    .nav-tabs .nav-link {
        color: var(--bs-gray-600);
    }

        .nav-tabs .nav-link.active {
            color: var(--bs-primary);
            font-weight: 600;
        }

    .franchise-card {
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .franchise-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            border-color: var(--bs-primary) !important;
        }
</style>

<script>
    // Trade functionality will be handled by existing JavaScript
    // This structure provides the proper styling framework
</script>