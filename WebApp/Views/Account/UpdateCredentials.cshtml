@model WebApp.Models.Account.CredentialsViewModel

<div class="alert alert-warning" role="alert">
    <i class="fas fa-exclamation-triangle me-2"></i>
    <strong>Warning:</strong> After updating credentials, you will be logged out.
</div>

<form asp-action="UpdateCredentials" method="post">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            @Html.ValidationSummary(true, "", new { @class = "mb-0" })
        </div>
    }

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.Password, htmlAttributes: new { @class = "form-label fw-bold" })
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-lock"></i></span>
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter current password" })
        </div>
        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.NewUsername, new { @class = "form-label fw-bold" })
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-user"></i></span>
            @Html.TextBoxFor(m => m.NewUsername, new { @class = "form-control", placeholder = "Enter new username (optional)" })
        </div>
        @Html.ValidationMessageFor(m => m.NewUsername, "", new { @class = "text-danger small" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.NewPassword, htmlAttributes: new { @class = "form-label fw-bold" })
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-key"></i></span>
            @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "Enter new password (optional)" })
        </div>
        @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.ConfirmNewPassword, new { @class = "form-label fw-bold" })
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-key"></i></span>
            @Html.PasswordFor(m => m.ConfirmNewPassword, new { @class = "form-control", placeholder = "Confirm new password" })
        </div>
        @Html.ValidationMessageFor(m => m.ConfirmNewPassword, "", new { @class = "text-danger small" })
    </div>

    <div class="d-grid">
        <button type="submit" class="btn btn-warning btn-lg">
            <i class="fas fa-sync-alt me-2"></i>Update Credentials
        </button>
    </div>
</form>