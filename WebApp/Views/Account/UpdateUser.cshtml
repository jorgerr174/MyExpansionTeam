@model WebApp.Models.Account.UserViewModel

<form asp-action="UpdateUser" method="post">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            @Html.ValidationSummary(true, "", new { @class = "mb-0" })
        </div>
    }

    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label fw-bold">
                <i class="fas fa-user me-2"></i>Actual @Html.LabelFor(m => m.FirstName)
            </label>
            <div class="form-control-plaintext bg-light rounded p-2">
                @Html.DisplayFor(m => m.FirstName)
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Nuevo @Html.LabelFor(m => m.FirstName)</label>
            @Html.TextBox("FirstName", "", new { @class = "form-control", placeholder = "Introduzca el nuevo nombre" })
            @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger small" })
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label fw-bold">
                <i class="fas fa-user me-2"></i>Actual @Html.LabelFor(m => m.LastName)
            </label>
            <div class="form-control-plaintext bg-light rounded p-2">
                @Html.DisplayFor(m => m.LastName)
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Nuevo @Html.LabelFor(m => m.LastName)</label>
            @Html.TextBox("LastName", "", new { @class = "form-control", placeholder = "Introduzca los nuevos apellidos" })
            @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger small" })
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label fw-bold">
                <i class="fas fa-envelope me-2"></i>Actual @Html.LabelFor(m => m.Email)
            </label>
            <div class="form-control-plaintext bg-light rounded p-2">
                @Html.DisplayFor(m => m.Email)
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Nuevo @Html.LabelFor(m => m.Email)</label>
            @Html.TextBox("Email", "", new { @class = "form-control", type = "email", placeholder = "Introduzca el nuevo email" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label fw-bold">
                <i class="fas fa-phone me-2"></i>Actual @Html.LabelFor(m => m.Tlf)
            </label>
            <div class="form-control-plaintext bg-light rounded p-2">
                @Html.DisplayFor(m => m.Tlf)
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Nuevo @Html.LabelFor(m => m.Tlf)</label>
            @Html.TextBox("Tlf", "", new { @class = "form-control", type = "tel", placeholder = "Introduzca el nuevo teléfono" })
            @Html.ValidationMessageFor(m => m.Tlf, "", new { @class = "text-danger small" })
        </div>
    </div>

    <div class="d-grid">
        <button type="submit" class="btn btn-success btn-lg">
            <i class="fas fa-save me-2"></i>Actualizar Información
        </button>
    </div>
</form>