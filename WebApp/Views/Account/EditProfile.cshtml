@model WebApp.Models.Account.ProfileViewModel

@{
    bool userTab = ViewData["userTab"] as bool? ?? true; // Default to true if missing
}

<h1>@User.Identity.Name</h1>

<ul class="nav nav-tabs" id="editProfileTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link @(userTab ? "active" : "")" id="user-tab" data-bs-toggle="tab" href="#user" role="tab">Editar Perfil</a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link @(!userTab ? "active" : "")" id="credentials-tab" data-bs-toggle="tab" href="#credentials" role="tab">Editar Credenciales</a>
    </li>
</ul>

<div class="tab-content mt-3">
    <div class="tab-pane fade @(userTab ? "show active" : "")" id="user" role="tabpanel">
        @await Html.PartialAsync("UpdateUser", Model.UpdateUser)
    </div>

    <div class="tab-pane fade @(!userTab ? "show active" : "")" id="credentials" role="tabpanel">
        @await Html.PartialAsync("UpdateCredentials", Model.UpdateCredentials)
    </div>
</div>

<div>
    <a asp-area="" asp-action="Profile">Go Back</a>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
