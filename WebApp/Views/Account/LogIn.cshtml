@model WebApp.Models.Account.LogInViewModel

@{
    ViewData["Title"] = "LogIn";
}

<style src="~/css/Account/LogIn.js"></style>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card mt-5">
                <div class="card-header bg-primary text-white d-flex justify-content-center align-items-center">
                    <h4 class="mb-0">Identifiquese</h4>
                </div>
                <div class="card-body">
                    <form asp-action="LogIn" method="post">
                        @Html.HiddenFor(m => m.RedirectUrl)
                        
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger" role="alert">
                                @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                            </div>
                        }
                        
                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Identifier, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Identifier, new { @class = "form-control", placeholder = "Introduzca su nombre de usuario o email" })
                            @Html.ValidationMessageFor(m => m.Identifier, "", new { @class = "text-danger small" })
                        </div>
                        
                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Password, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Introduzca su contraseña" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>
                        
                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-sign-in-alt me-2"></i>Iniciar Sesión
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light text-center">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Volver
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Font Awesome Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}    
<link rel="stylesheet" href="~/css/Account/LogIn.css">
<script src="~/js/Account/LogIn.js"></script>