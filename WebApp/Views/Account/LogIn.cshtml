@model WebApp.Models.Account.LogInViewModel

@{
    ViewData["Title"] = "LogIn";
}

<h2>LogIn</h2>

<form asp-action="LogIn" method="post">
    @Html.HiddenFor(m => m.RedirectUrl)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        @Html.LabelFor(m => m.Identifier, htmlAttributes: new { @class = "control-label" })
        @Html.TextBoxFor(m => m.Identifier, new { @class = "form-control" })
    </div>

    <div class="form-group">
		@Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
		@Html.LabelFor(m => m.Password, htmlAttributes: new { @class = "control-label" })
        @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-primary">LogIn</button>
</form>

<div>
    <a asp-area="" asp-controller="Home" asp-action="Index">Go Back</a>
</div>

@section Scripts {
	@await Html.PartialAsync("_ValidationScriptsPartial")
}