@startuml DiagramaPaquetes
!theme plain
title Diagrama de Paquetes - Mi Equipo Expansión

package "METAPI" {
    [Controllers - Controladores API]
    [Middleware - Middleware]
    [Configuration - Configuración]
}

package "WebApp" {
    [Views - Vistas MVC]
    [Controllers - Controladores MVC]
    [wwwroot - Recursos Estáticos]
    [Models - ViewModels]
}

package "METCore" {
    [Models - Modelos de Dominio]
    [Services - Servicios de Negocio]
    [DTOs - Objetos de Transferencia]
    [Interfaces - Contratos]
}

package "METDAL" {
    [Repositories - Repositorios]
    [Context - Contexto EF]
    [Migrations - Migraciones]
    [Configuration - Configuración BD]
}

package "Database" {
    [SQL Server - Base de Datos]
}

' Dependencias entre paquetes
METAPI --> METCore : <<uses>>
WebApp --> METCore : <<uses>>
WebApp --> METDAL : <<uses>>
METCore --> METDAL : <<uses>>
METDAL --> Database : <<accesses>>

' Anotaciones
note right of METAPI : API REST para operaciones\navanzadas y administración
note right of WebApp : Interfaz web principal\npara usuarios finales
note right of METCore : Lógica de negocio\ny reglas del dominio
note right of METDAL : Acceso a datos\ny persistencia
note right of Database : Almacenamiento\nde datos

@enduml