@startuml SecuenciaImportacionDatos
!theme plain
title CU019: Importación de Datos

actor "Administrador" as admin
participant "API Controller" as controller
participant "Import Service" as service
participant "Repository" as repo
participant "Database" as db

admin -> controller : POST /api/Import/Stats\n(archivo CSV)
activate controller

controller -> controller : ValidateUserRole()\nValidar rol usuario
controller -> controller : ValidateFile()\nValidar archivo

alt Archivo válido
    controller -> service : ImportStatsFromFile(file, year, type)
    activate service
    
    service -> service : ParseCSVFile()\nParsear archivo CSV
    service -> service : ValidateDataFormat()\nValidar formato datos
    
    loop Para cada registro válido
        service -> repo : CreateSeasonStats(stats)
        activate repo
        repo -> db : INSERT INTO SeasonStats
        activate db
        db --> repo : success/error
        deactivate db
        repo --> service : resultado
        deactivate repo
    end
    
    service -> service : GenerateErrorReport()\nGenerar reporte errores
    service --> controller : ImportResult\n(éxitos, errores)
    deactivate service
    
    controller --> admin : 200 OK + reporte
else Archivo inválido
    controller --> admin : 400 Bad Request\nError de validación
end

deactivate controller

@enduml