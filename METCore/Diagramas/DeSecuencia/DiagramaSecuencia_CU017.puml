@startuml DiagramaSecuencia_CU017
!theme plain

actor "Actor Admin" as admin
participant "IC_Admin" as interfaz
participant "G_Admin" as gestion
collections "ImportService" as import

admin -> interfaz : 1. solicitarImportarDatos()
activate interfaz

interfaz -> gestion : 2. validarRolAdmin(userId)
activate gestion
gestion -> gestion : 3. verificarPermisos(userId)

alt Usuario no es admin
    gestion --> interfaz : 4. error
    interfaz --> admin : 5. mostrarError("Sin permisos de administrador")
    interfaz -> interfaz : 6. redirigirPantallaInicial()
    deactivate gestion
else Es administrador
    deactivate gestion
    
    loop Datos de importación incompletos
        admin <- interfaz : 7. tipoImportacion := solicitarTipoImportacion()
        deactivate interfaz
        activate admin
        admin --> interfaz : 8. tipoImportacion
        deactivate admin
        activate interfaz
        
        alt Tipo no seleccionado
            interfaz --> admin : 9. mostrarError("Debe seleccionar tipo de importación")
        else Es tipo estadísticas
            alt Año o tipo estadísticas no especificado
                admin <- interfaz : 10. detallesEstadisticas := solicitarDetallesEstadisticas()
                deactivate interfaz
                activate admin
                admin --> interfaz : 11. año, tipoEstadisticas
                deactivate admin
                activate interfaz
                
                alt Faltan detalles
                    interfaz --> admin : 12. mostrarError("Debe especificar año y tipo de estadísticas")
                end
            end
        end
        
        loop Archivo inválido
            admin <- interfaz : 13. archivo := solicitarArchivo()
            deactivate interfaz
            activate admin
            admin --> interfaz : 14. archivo
            deactivate admin
            activate interfaz
            
            alt No seleccionó archivo
                interfaz --> admin : 15. mostrarError("Debe seleccionar un archivo")
            else Archivo no es CSV
                interfaz -> interfaz : 16. validarTipoArchivo(archivo)
                interfaz --> admin : 17. mostrarError("El archivo debe ser de tipo CSV")
            end
        end
    end
    
    interfaz -> gestion : 18. procesarImportacion(tipoImportacion, archivo, detalles)
    activate gestion
    gestion -> import : 19. importarDatos(tipoImportacion, archivo, detalles)
    activate import
    import -> import : 20. procesarArchivo()
    import --> gestion : 21. resultadoImportacion
    deactivate import
    
    alt Todos los registros importados exitosamente
        gestion --> interfaz : 22. importacionCompleta
        deactivate gestion
        interfaz --> admin : 23. mostrarExito("Todos los registros fueron importados correctamente")
        deactivate interfaz
    else Algunos registros fallaron
        gestion -> gestion : 22. generarArchivoErrores(registrosFallidos)
        gestion --> interfaz : 23. archivoErrores
        deactivate gestion
        interfaz --> admin : 24. mostrarErrores("Importación parcial - descargar archivo con errores", archivoErrores)
        deactivate interfaz
    end
end

note right of admin : El actor puede cancelar\nel proceso en cualquier momento

@enduml