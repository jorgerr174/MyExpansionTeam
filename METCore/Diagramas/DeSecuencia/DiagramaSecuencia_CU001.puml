@startuml DiagramaSecuencia_CU001
!theme plain
title CU001: Registro de Usuario

actor "Actor Anónimo" as anonimo
participant "Account Controller" as controller
participant "User Service" as userService
participant "User Repository" as userRepo
participant "Password Hasher" as hasher
participant "Database" as db

anonimo -> controller : GET /Account/Register\nSolicitar formulario registro
activate controller
controller --> anonimo : Vista formulario registro
deactivate controller

anonimo -> controller : POST /Account/Register\n(datos personales)
activate controller

controller -> controller : ValidateModel()\nValidar datos entrada

controller -> userService : CheckUserExists(username, email)
activate userService
userService -> userRepo : GetUserByUsername(username)
activate userRepo
userRepo -> db : SELECT FROM Users WHERE Username = ?
activate db
db --> userRepo : usuario existente o null
deactivate db
userRepo --> userService : existe usuario
deactivate userRepo

alt Usuario no existe
    userService -> hasher : HashPassword(password)
    activate hasher
    hasher --> userService : password hasheada
    deactivate hasher
    
    userService -> userRepo : CreateUser(userData)
    activate userRepo
    userRepo -> db : INSERT INTO Users
    activate db
    db --> userRepo : nuevo usuario ID
    deactivate db
    userRepo --> userService : usuario creado
    deactivate userRepo
    
    userService --> controller : Success(claves acceso)
    deactivate userService
    controller --> anonimo : Mensaje éxito + claves acceso
else Usuario ya existe
    userService --> controller : Error("Usuario ya registrado")
    deactivate userService
    controller --> anonimo : Mensaje error + vuelta al paso 1
end

deactivate controller

@enduml