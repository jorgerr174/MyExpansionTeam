@startuml DiagramaSecuencia_CU018
!theme plain

actor "Actor Admin" as admin
participant "IC_Admin" as interfaz
participant "G_Admin" as gestion
collections "Users" as users

admin -> interfaz : 1. solicitarModificarRoles()
activate interfaz

interfaz -> gestion : 2. validarRolAdmin(username)
activate gestion
gestion -> users : 3. U1 := getUsuario(username)
users -> gestion : 4. U1
gestion -> gestion : 4. verificarPermisos(U1)

alt Usuario no es admin
    gestion --> interfaz : 4. error
    interfaz --> admin : 5. mostrarError("Sin permisos de administrador")
    interfaz -> interfaz : 6. redirigirPantallaInicial()
else Es administrador
    gestion --> interfaz : 4. rolValidado
    deactivate gestion
    
    loop Usuario quiere filtrar más
        admin <- interfaz : 7. cadenaBusqueda := solicitarFiltro()
        deactivate interfaz
        activate admin
        admin --> interfaz : 8. cadenaBusqueda
        deactivate admin
        activate interfaz
        
        interfaz -> gestion : 9. usuariosFiltrados := buscarUsuarios(cadenaBusqueda)
        activate gestion
        gestion -> users : 10. usuariosFiltrados := buscarPorCriterios(cadenaBusqueda)
        activate users
        users --> gestion : 11. usuariosFiltrados
        deactivate users
        gestion --> interfaz : 12. usuariosFiltrados
        deactivate gestion
        
        interfaz --> admin : 13. mostrarUsuarios(usuariosFiltrados)
        activate admin
        
        alt Usuario quiere aplicar más filtros
            admin -> interfaz : 14. aplicarNuevoFiltro()
            deactivate admin
            note over interfaz : Continúa el loop de filtrado
        else Usuario procede con selección
            admin -> interfaz : 14. procederConSeleccion()
            deactivate admin
        end
    end
    
    loop Cambios de roles pendientes
        admin <- interfaz : 15. usuarioSeleccionado := seleccionarUsuario()
        activate admin
        admin --> interfaz : 16. usuarioSeleccionado
        deactivate admin
        
        admin <- interfaz : 17. nuevoRol := seleccionarNuevoRol()
        activate admin
        admin --> interfaz : 18. nuevoRol
        deactivate admin
        
        interfaz -> interfaz : 19. registrarCambioRol(usuarioSeleccionado, nuevoRol)
        interfaz --> admin : 20. mostrarCambioRegistrado()
        
        activate admin
        alt Usuario quiere hacer más cambios
            admin -> interfaz : 21. continuarModificando()
            note over interfaz : Continúa el loop de cambios
        else Usuario quiere guardar
            admin -> interfaz : 21. solicitarGuardarCambios()
        end
        deactivate admin
    end
    
    interfaz -> gestion : 22. validarYGuardarCambios(cambiosRoles)
    activate gestion
    
    loop Para cada cambio de rol
        gestion -> users : 23. usuarioObjetivo := buscarPorId(username)
        activate users
        users --> gestion : 24. usuarioObjetivo
        deactivate users
        
        alt Usuario objetivo es Admin
            gestion --> interfaz : 25. error
            interfaz --> admin : 26. mostrarError("No se puede cambiar el rol de otro administrador")
            activate admin
            admin -> interfaz : 27. continuarConOtrosCambios()
            deactivate admin
        else Usuario no es Admin
            gestion -> users : 25. actualizarRol(username, nuevoRol)
            activate users
            users --> gestion : 26. confirmacion
            deactivate users
        end
    end
    
    gestion --> interfaz : 27. cambiosCompletados
    deactivate gestion
    interfaz --> admin : 28. mostrarExito("Cambios de roles guardados exitosamente")
    deactivate interfaz
end

note right of admin : El actor puede cancelar\nel proceso en cualquier momento

@enduml