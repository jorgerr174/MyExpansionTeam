@startuml DiagramaSecuencia_CU011
!theme plain
title CU011: Elección de Jugadores Protegidos

actor "Actor Usuario" as usuario
participant "Team Controller" as controller
participant "Player Service" as playerService
participant "Team Service" as teamService
participant "Player Repository" as playerRepo
participant "Database" as db

usuario -> controller : GET /Team/ProtectedPlayers/{teamId}\nSolicitar gestión protegidos
activate controller

controller -> teamService : GetTeamPlayers(teamId)
activate teamService
teamService -> playerRepo : GetPlayersByTeamId(teamId)
activate playerRepo
playerRepo -> db : SELECT FROM Players WHERE TeamId = ?
activate db
db --> playerRepo : jugadores del equipo
deactivate db
playerRepo --> teamService : lista jugadores
deactivate playerRepo
teamService --> controller : jugadores disponibles
deactivate teamService

controller --> usuario : Vista jugadores con estado protección
deactivate controller

usuario -> controller : POST /Team/SetProtectedPlayers\n(jugadores seleccionados)
activate controller

controller -> controller : ValidateSelection()\nValidar selección jugadores

controller -> playerService : SetProtectedPlayers(teamId, selectedPlayers)
activate playerService

playerService -> playerService : ValidateProtectionRules()\nValidar reglas protección

alt Selección válida
    loop Para cada jugador del equipo
        playerService -> playerRepo : UpdatePlayerProtection(playerId, isProtected)
        activate playerRepo
        playerRepo -> db : UPDATE Players SET IsProtected = ? WHERE Id = ?
        activate db
        db --> playerRepo : protección actualizada
        deactivate db
        playerRepo --> playerService : jugador actualizado
        deactivate playerRepo
    end
    
    playerService --> controller : Success("Jugadores protegidos configurados")
    deactivate playerService
    controller --> usuario : Mensaje confirmación + Lista actualizada
else Selección inválida
    playerService --> controller : Error("Selección no válida")
    deactivate playerService
    controller --> usuario : Mensaje error + Formulario selección
end

deactivate controller

@enduml