@startuml DiagramaSecuencia_CU005
!theme plain
title CU005: Baja de Usuario

actor "Actor Usuario" as usuario
participant "Account Controller" as controller
participant "User Service" as userService
participant "User Repository" as userRepo
participant "Team Service" as teamService
participant "Database" as db

usuario -> controller : GET /Account/Delete\nSolicitar baja de usuario
activate controller
controller --> usuario : Confirmación baja usuario
deactivate controller

usuario -> controller : POST /Account/Delete\nConfirmar baja
activate controller

controller -> userService : DeleteUserAccount(userId)
activate userService

userService -> teamService : DeleteUserTeams(userId)
activate teamService
teamService -> db : DELETE FROM Teams WHERE UserId = ?
activate db
db --> teamService : equipos eliminados
deactivate db
teamService --> userService : equipos del usuario eliminados
deactivate teamService

userService -> userRepo : DeleteUser(userId)
activate userRepo
userRepo -> db : DELETE FROM Users WHERE Id = ?
activate db
db --> userRepo : usuario eliminado
deactivate db
userRepo --> userService : usuario dado de baja
deactivate userRepo

userService --> controller : Success("Usuario eliminado")
deactivate userService

controller -> controller : ClearAuthenticationCookie()\nLimpiar sesión

controller --> usuario : Mensaje confirmación + Redirigir home\n(Actor Anónimo)

deactivate controller

@enduml