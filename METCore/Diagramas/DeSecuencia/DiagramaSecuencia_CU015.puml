@startuml DiagramaSecuencia_CU015
!theme plain

actor "Actor Usuario" as usuario
participant "IC_Teams" as interfaz
participant "G_Teams" as gestion

note over interfaz : Este caso de uso es invocado desde CU014

interfaz -> gestion : 1. A1 := obtenerAjustesDraftDefecto()
activate interfaz
activate gestion
gestion -> gestion : 2. A1 := generarDefecto()
gestion --> interfaz : 3. A1
deactivate gestion

interfaz --> usuario : 4. mostrarAjustes(A1)
deactivate interfaz
activate usuario

loop Ajustes inválidos
    usuario -> interfaz : 5. guardarAjustes(A2)
    deactivate usuario
    activate interfaz
    
    interfaz -> interfaz : 6. validarAjustesDraft(A2)
end
    interfaz --> usuario : 7. confirmarAjustes("Ajustes de draft correctos")
    deactivate usuario
    
    note over interfaz : Retorna control a CU014 con ajustes configurados
    interfaz --> interfaz : 12. retornarACU014(A2)
    deactivate interfaz

note right of usuario : El actor puede cancelar\nel proceso en cualquier momento

@enduml