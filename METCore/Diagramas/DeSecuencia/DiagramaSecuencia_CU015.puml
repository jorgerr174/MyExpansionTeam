@startuml DiagramaSecuencia_CU015
!theme plain
title CU015: Simulación del Draft

actor "Actor Usuario" as usuario
participant "Draft Controller" as controller
participant "Draft Service" as draftService
participant "AI Service" as aiService
participant "Player Service" as playerService
participant "Team Service" as teamService
participant "Database" as db

usuario -> controller : POST /api/Draft/Simulate\nSolicitar simulación draft
activate controller

controller -> draftService : SimulateDraft(draftConfig)
activate draftService

draftService -> playerService : GetAvailablePlayers()
activate playerService
playerService -> db : SELECT FROM Players WHERE Available = true
activate db
db --> playerService : jugadores disponibles
deactivate db
playerService --> draftService : pool jugadores
deactivate playerService

draftService -> teamService : GetParticipatingTeams()
activate teamService
teamService -> db : SELECT FROM Teams WHERE Participating = true
activate db
db --> teamService : equipos participantes
deactivate db
teamService --> draftService : lista equipos
deactivate teamService

draftService -> draftService : CreateDraftOrder()\nCrear orden draft completo

loop Para cada ronda (7 rondas completas)
    loop Para cada equipo en orden
        draftService -> aiService : SelectBestPlayerForTeam(team, availablePlayers)
        activate aiService
        aiService -> aiService : AnalyzeTeamNeeds()\nAnalizar necesidades equipo
        aiService -> aiService : EvaluatePlayerValue()\nEvaluar valor jugadores
        aiService --> draftService : jugador recomendado
        deactivate aiService
        
        draftService -> playerService : AssignPlayerToTeam(playerId, teamId)
        activate playerService
        playerService -> db : UPDATE Players SET TeamId = ?
        activate db
        db --> playerService : jugador asignado
        deactivate db
        playerService --> draftService : jugador drafteado
        deactivate playerService
        
        draftService -> draftService : UpdateAvailablePlayers()\nActualizar jugadores disponibles
    end
    
    draftService -> draftService : AdvanceToNextRound()\nAvanzar siguiente ronda
end

draftService -> draftService : GenerateDraftResults()\nGenerar resultados simulación

draftService --> controller : SimulationComplete(draftResults)
deactivate draftService

controller --> usuario : Resultados simulación completa

deactivate controller

@enduml