@startuml DiagramaSecuencia_CU007
!theme plain
title CU007: Modificación de Equipo

actor "Actor Usuario" as usuario
participant "Team Controller" as controller
participant "Team Service" as teamService
participant "Team Repository" as teamRepo
participant "Database" as db

usuario -> controller : GET /Team/Index\nVer equipos del usuario
activate controller

controller -> teamService : GetUserTeams(userId)
activate teamService
teamService -> teamRepo : GetTeamsByUserId(userId)
activate teamRepo
teamRepo -> db : SELECT FROM Teams WHERE UserId = ?
activate db
db --> teamRepo : lista equipos usuario
deactivate db
teamRepo --> teamService : equipos del usuario
deactivate teamRepo
teamService --> controller : lista equipos
deactivate teamService

controller --> usuario : Vista con equipos disponibles
deactivate controller

usuario -> controller : GET /Team/Edit/{teamId}\nElegir equipo a modificar
activate controller

controller -> teamService : GetTeamById(teamId, userId)
activate teamService
teamService -> teamRepo : GetTeamByIdAndUser(teamId, userId)
activate teamRepo
teamRepo -> db : SELECT FROM Teams WHERE Id = ? AND UserId = ?
activate db
db --> teamRepo : datos del equipo
deactivate db
teamRepo --> teamService : equipo seleccionado
deactivate teamRepo
teamService --> controller : ficha del equipo
deactivate teamService

controller --> usuario : Formulario modificación equipo
deactivate controller

usuario -> controller : POST /Team/Edit/{teamId}\n(cambios realizados)
activate controller

controller -> teamService : UpdateTeam(teamId, newData, userId)
activate teamService
teamService -> teamRepo : UpdateTeam(teamData)
activate teamRepo
teamRepo -> db : UPDATE Teams SET ... WHERE Id = ?
activate db
db --> teamRepo : equipo actualizado
deactivate db
teamRepo --> teamService : modificación exitosa
deactivate teamRepo
teamService --> controller : Success("Equipo modificado")
deactivate teamService

controller --> usuario : Mensaje éxito + Vista equipo modificado

deactivate controller

@enduml