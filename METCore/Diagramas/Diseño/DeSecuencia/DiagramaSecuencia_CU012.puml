@startuml DiagramaSecuencia_CU012
!theme plain

actor "Actor Usuario" as usuario
participant "IC_Teams" as interfaz
participant "G_Teams" as gestion
collections "Teams" as teams
collections "RosterSettings" as ajustes
collections "Franchises" as franchises
collections "Players" as players

usuario -> interfaz : 1. modificarJugadoresEquipo(equipoId)
activate interfaz

interfaz -> gestion : 2. E1 := getEquipo(equipoId)
activate gestion
gestion -> teams : 3. E1 := buscarPorId(equipoId)
activate teams
teams --> gestion : 4. E1
deactivate teams

gestion -> ajustes : 5. A1 := buscarAjustesPorEquipoId(equipoId)
activate ajustes
ajustes --> gestion : 6. A1
deactivate ajustes

alt E1 IS NULL OR E1.propietario != usuario
    gestion --> interfaz : 7. error
    interfaz --> usuario : 8. mostrarError("No es propietario del equipo o no existe")
    deactivate gestion
    deactivate interfaz
else Es propietario
    gestion --> interfaz : 7. E1, A1
    deactivate gestion
    interfaz --> usuario : 8. E1.JugadoresSeleccionados
    activate usuario
    
    interfaz -> gestion : 9. franquicias := getAll()
    activate gestion
    gestion -> franchises : 10. franquicias := getAll()
    activate franchises
    franchises --> gestion : 11. franquicias
    deactivate franchises
    gestion --> interfaz : 12. franquicias
    deactivate gestion
    interfaz --> usuario : 13. franquicias
    
    loop Para cada franquicia que el usuario quiera modificar
        usuario -> interfaz : 14. jugadores := getJugadoresPorFranquicia(franquiciaId)
        interfaz -> gestion : 15. jugadores := getJugadoresPorFranquicia(franquiciaId)
        activate gestion
        gestion -> players : 16. jugadores := getJugadoresPorFranquicia(franquiciaId)
        activate players
        players --> gestion : 17. jugadores
        deactivate players
        gestion --> interfaz : 18. jugadores
        deactivate gestion
        interfaz --> usuario : 19. jugadores
        
        loop Para cada jugador clicado
            alt Seleccionar jugador
                usuario -> interfaz : 20. seleccionarJugador(jugadorId)
                interfaz -> interfaz : 21. validarJugadorSeleccionable(jugadorId, A1.JugadoresProtegidos)
                
                alt Jugador protegido
                    interfaz --> usuario : 22. mostrarError("Jugador protegido - no seleccionable")
                else Jugador seleccionable
                    interfaz --> usuario : 22. confirmarSeleccion()
                end
            else Deseleccionar jugador
                usuario -> interfaz : 23. deseleccionarJugador(jugadorId)
                interfaz --> usuario : 24. confirmarDeseleccion()
            end
        end
    end
    
    usuario -> interfaz : 25. guardarSelecciones()
    deactivate usuario
    interfaz -> interfaz : 26. validarRoster(E1, A1)
    
    alt Roster no cumple validaciones
        interfaz --> usuario : 27. mostrarError("El conjunto de jugadores no cumple con las validaciones del equipo")
    else Selección válida
        interfaz -> gestion : 27. guardarSelecciones(E1)
        activate gestion
        gestion -> teams : 28. actualizarJugadores(E1)
        activate teams
        teams --> gestion : 29. ok
        deactivate teams
        gestion --> interfaz : 30. ok
        deactivate gestion
        interfaz --> usuario : 31. confirmarCambios("Jugadores del equipo actualizados")
        deactivate interfaz
    end
end

note right of usuario : El actor puede cancelar\nel proceso en cualquier momento

@enduml