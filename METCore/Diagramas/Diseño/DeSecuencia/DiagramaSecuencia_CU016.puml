@startuml DiagramaSecuencia_CU016
!theme plain

actor "Actor Usuario" as usuario
participant "IC_Teams" as interfaz
participant "G_Teams" as gestion
collections "Teams" as teams
collections "Players" as players

usuario -> interfaz : 1. solicitarVisualizarEquipos()
activate interfaz

interfaz -> gestion : 2. equipos := getEquiposDeUsuario(username)
activate gestion
gestion -> teams : 3. equipos := *getPorDueño(username)
activate teams
teams --> gestion : 4. equipos
deactivate teams

alt equipos IS EMPTY
    gestion --> interfaz : 5. listaVacia
    interfaz --> usuario : 6. mostrarMensaje("No tiene equipos creados")
    deactivate gestion
    deactivate interfaz
else Tiene equipos
    gestion --> interfaz : 5. equipos
    deactivate gestion
    interfaz --> usuario : 6. mostrarListadoEquipos(equipos)
    activate usuario
    
    loop Usuario navega entre equipos
        usuario -> interfaz : 7. seleccionarEquipo(equipoId)
        deactivate usuario
        
        interfaz -> gestion : 8. E1 := obtenerEquipoCompleto(equipoId)
        activate gestion
        gestion -> teams : 9. E1 := buscarConJugadores(equipoId)
        activate teams
        teams --> gestion : 10. E1
        deactivate teams
        
        gestion -> players : 11. Stats := obtenerEstadisticas(E1.jugadores)
        activate players
        players --> gestion : 12. Stats
        deactivate players
        
        gestion --> interfaz : 14. E1, Stats
        deactivate gestion
        
        interfaz --> usuario : 15. mostrarDatos(E1, Stats)
        activate usuario
        
        alt Usuario selecciona volver al listado
            usuario -> interfaz : 16. volverAListado()
            deactivate usuario
            interfaz --> usuario : 17. mostrarListadoEquipos(equipos)
            activate usuario
        else Usuario selecciona otro equipo
            note over usuario : Continúa el loop con nueva selección
        end
    end
    
    deactivate usuario
    deactivate interfaz
end

note right of usuario : El actor puede cancelar\nel proceso en cualquier momento

@enduml