@startuml DiagramaSecuencia_CU011
!theme plain

actor "Actor Usuario" as usuario
participant "IC_Teams" as interfaz
participant "G_Teams" as gestion
collections "RosterSettings" as ajustes
collections "Franchises" as franchises
collections "Players" as players

usuario -> interfaz : 1. modificarJugadoresProtegidos(equipoId)

activate interfaz
interfaz -> gestion : 2. A1 := getEquipo(equipoId)
activate gestion
gestion -> ajustes : 3. A1 := buscarAjustesPorEquipoId(equipoId)
activate ajustes
gestion <-- ajustes : 4. A1
deactivate ajustes

alt E1 IS NULL OR E1.propietario != usuario
    gestion --> interfaz : 5. error
    interfaz --> usuario : 6. mostrarError("No es propietario del equipo o no existe")
end

interfaz <-- gestion : 7. A1
usuario <-- interfaz : 8. A1.JugadoresProtegidos
activate usuario
interfaz -> gestion : 9. franquicias := getAll()
gestion -> franchises : 10. franquicias := getAll()
activate franchises
franchises --> gestion : 11. franquicias
deactivate franchises
gestion --> interfaz : 12. franquicias
deactivate gestion
usuario <-- interfaz : 13. franquicias

loop Para cada franquicia que el usuario quiera modificar
    usuario -> interfaz : 14. jugadores := getJugadoresPorFranquicia(franquiciaId)

    interfaz -> gestion : 15. jugadores := getJugadoresPorFranquicia(franquiciaId)
    activate gestion
    gestion -> players : 16. jugadores := getJugadoresPorFranquicia(franquiciaId)
    activate players
    players --> gestion : 17. jugadores
    deactivate players
    gestion --> interfaz : 18. jugadores
    deactivate gestion
    usuario <- interfaz : 19. jugadores

    loop Para cada jugador clicado
        alt Proteger 
            usuario -> interfaz : 20. protegerJugador(jugadorId)
        else Desproteger
            usuario -> interfaz : 21. desprotegerJugador(jugadorId)
        end
        usuario <-- interfaz : 22. ok
    end
    
end
    
    usuario -> interfaz : 23. guardarProtecciones()
    deactivate usuario
    interfaz -> interfaz : 24. validarProtecciones(A1)
    

alt Número incorrecto de jugadores protegidos
    usuario <-- interfaz : 25. mostrarError("Número de protegidos incorrecto")
else Selección válida
    interfaz -> gestion : 26. guardarProtecciones(A1)
    activate gestion
    gestion -> ajustes : 27. guardarProtecciones(A1)
    activate ajustes
    gestion <-- ajustes : 28. ok
    deactivate ajustes
    interfaz <-- gestion : 29. ok
    deactivate gestion
    usuario <-- interfaz : 30. ok
    deactivate interfaz
end

note right of usuario : El actor puede cancelar\nel proceso en cualquier momento

@enduml