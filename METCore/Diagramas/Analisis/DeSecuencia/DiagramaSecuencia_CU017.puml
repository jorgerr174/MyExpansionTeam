@startuml DiagramaSecuencia_CU017
!theme plain

actor "Actor Admin" as admin
participant "IUSistema" as interfaz

admin -> interfaz : 1. solicitarImportarDatos()
activate interfaz

interfaz -> interfaz : 2. verificarPermisos(userId)

alt Usuario no es admin
    interfaz --> admin : 3. mostrarError("Sin permisos de administrador")
    interfaz -> interfaz : 4. redirigirPantallaInicial()
else Es administrador

    loop Datos de importación incompletos
        admin <- interfaz : 5. tipoImportacion := solicitarTipoImportacion()
        deactivate interfaz
        activate admin
        admin --> interfaz : 6. tipoImportacion
        deactivate admin
        activate interfaz
        
        alt Tipo no seleccionado
            interfaz --> admin : 7. mostrarError("Debe seleccionar tipo de importación")
        else Es tipo estadísticas
            alt Año o tipo estadísticas no especificado
                admin <- interfaz : 8. detallesEstadisticas := solicitarDetallesEstadisticas()
                deactivate interfaz
                activate admin
                admin --> interfaz : 9. año, tipoEstadisticas
                deactivate admin
                activate interfaz
                
                alt Faltan detalles
                    interfaz --> admin : 10. mostrarError("Debe especificar año y tipo de estadísticas")
                end
            end
        end
        
        loop Archivo inválido
            admin <- interfaz : 11. archivo := solicitarArchivo()
            deactivate interfaz
            activate admin
            admin --> interfaz : 12. archivo
            deactivate admin
            activate interfaz
            
            alt No seleccionó archivo
                interfaz --> admin : 13. mostrarError("Debe seleccionar un archivo")
            else Archivo no es CSV
                interfaz -> interfaz : 14. validarTipoArchivo(archivo)
                interfaz --> admin : 15. mostrarError("El archivo debe ser de tipo CSV")
            end
        end
    end
    
    interfaz -> interfaz : 16. importarDatos(tipoImportacion, archivo, detalles)

    alt Todos los registros importados exitosamente
        interfaz --> admin : 17. mostrarExito("Todos los registros fueron importados correctamente")
    else Algunos registros fallaron
        interfaz -> interfaz : 18. generarArchivoErrores(registrosFallidos)
        interfaz --> admin : 19. mostrarErrores("Importación parcial - descargar archivo con errores", archivoErrores)
        deactivate interfaz
    end
end

@enduml