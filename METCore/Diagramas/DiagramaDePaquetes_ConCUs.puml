@startuml PaquetesConCasosDeUso
!theme plain
title Paquetes y Relaciones con Casos de Uso

package "Capa de Presentación" {
    [WebApp - Interfaz Web]
[METAPI - API REST]
}

package "Capa de Negocio" {
    [METCore - Lógica de Negocio]
}

package "Capa de Datos" {
    [METDAL - Acceso a Datos]
}

package "Gestión de Usuarios" {
    usecase "CU001: Registro de usuario" as UC001
    usecase "CU002: Inicio de sesión" as UC002
    usecase "CU003: Cerrado de sesión" as UC003
    usecase "CU004: Modificación credenciales" as UC004
    usecase "CU005: Baja de usuario" as UC005
}

package "Gestión de Equipos" {
    usecase "CU006: Creación de equipo" as UC006
    usecase "CU007: Modificación de equipo" as UC007
    usecase "CU008: Duplicado de equipo" as UC008
    usecase "CU009: Borrado de equipos" as UC009
}

package "Gestión de Roster" {
    usecase "CU010: Modificación ajustes" as UC010
    usecase "CU011: Jugadores protegidos" as UC011
    usecase "CU012: Elección jugadores" as UC012
    usecase "CU013: Realización trueques" as UC013
}

package "Gestión de Draft" {
    usecase "CU014: Realización draft" as UC014
    usecase "CU015: Simulación draft" as UC015
    usecase "CU016: Ajustes del draft" as UC016
}

package "Análisis" {
    usecase "CU017: Seguimiento rendimiento" as UC017
    usecase "CU018: Interacción usuarios" as UC018
}

package "Administración" {
    usecase "CU019: Importación datos" as UC019
    usecase "CU020: Gestión roles" as UC020
}

' Relaciones de dependencia
WebApp-- > METCore
METAPI-- > METCore
METCore-- > METDAL

' Conexiones con casos de uso
WebApp-- > UC001
WebApp-- > UC002
WebApp-- > UC003
WebApp-- > UC004
WebApp-- > UC005
WebApp-- > UC006
WebApp-- > UC007
WebApp-- > UC008
WebApp-- > UC009
WebApp-- > UC010
WebApp-- > UC011
WebApp-- > UC012
WebApp-- > UC013
WebApp-- > UC017
WebApp-- > UC018

METAPI-- > UC014
METAPI-- > UC015
METAPI-- > UC016
METAPI-- > UC019
METAPI-- > UC020

@enduml